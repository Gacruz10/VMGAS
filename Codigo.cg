// =======================================================
// 1. CONFIGURACIÓN GLOBAL Y DO-GET / DO-POST
// =======================================================

const TIEMPO_SESION = 180000; // referencia 1 minutos (60 segundos)

function detenerEjecuciones() {
  // Clava un cartel luminoso en el servidor de Google que dura 5 minutos
  CacheService.getScriptCache().put('STOP_EMERGENCIA', 'SI', 300); 
  return { status: 'success', message: 'Freno de mano activado. Todo se cortará en segundos.' };
}


function doGet(e) {
  const action = (e?.parameter?.action || '').toLowerCase();
  const output = (data) => ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);

  try {
    if (esHorarioMantenimiento()) {
      if (action) {
        return output({ 
          status: 'error', 
          message: 'Sistema en mantenimiento (23:45 a 00:05). Aguarde unos minutos.' 
        });
      } else {
        return HtmlService.createHtmlOutput(
          "<body style='background:#060a10;color:white;text-align:center;padding-top:100px;font-family:sans-serif;'>" +
          "<h2> SISTEMA EN MANTENIMIENTO</h2>" +
          "<p>Estamos procesando datos de auditoría. Volvé a intentar después de las 00:06 AM.</p>" +
          "</body>"
        );
      }
    }

    const usuarioReq = e?.parameter?.usuario || 'SISTEMA';
    const apiKeyValida = (e?.parameter?.api_key === 'VM_Seguridad_2026');

    switch (action) {
      
      // ========================================================
      // 🔥 RUTA UNIFICADA DE ARRANQUE (MÁS RÁPIDA + CACHÉ) 🔥
      // ========================================================
      case 'initapp': {
        const cache = CacheService.getScriptCache();
        const cachedData = cache.get('INIT_APP_DATA');

        if (cachedData) {
          return ContentService.createTextOutput(cachedData).setMimeType(ContentService.MimeType.JSON);
        }

        const payload = {
          status: 'success',
          zonas: obtenerZonasDeClientes(),
          clientes: obtenerClientes(),
          precios: obtenerPrecios(),
          deudas: obtenerDeudasPendientes(),
          comisiones: obtenerRangosComision()
        };

        const stringPayload = JSON.stringify(payload);

        if (stringPayload.length < 100000) {
          cache.put('INIT_APP_DATA', stringPayload, 300);
        }

        return ContentService.createTextOutput(stringPayload).setMimeType(ContentService.MimeType.JSON);
      }
      // ========================================================

      case 'getdatos': return output({ 
       status: 'success', 
       clientes: obtenerClientes(), 
       precios: obtenerPrecios(),
       deudas: obtenerDeudasPendientes(),
       comisiones: obtenerRangosComision()
      });
      case 'getversiones': {
        inicializarVersionesSiEstanVacias();
        const props = PropertiesService.getScriptProperties();
        return output({
          status: 'success',
          TS_PRECIOS: props.getProperty('TS_PRECIOS'),
          TS_CLIENTES: props.getProperty('TS_CLIENTES'),
          TS_SALDOS: props.getProperty('TS_SALDOS')
        });
      }
      case 'getdata': { const d = obtenerDatosFormulario(); return output({ status: 'success', zonas: d.zonas, garrafas: d.garrafas }); }
      case 'getdatosplanta': return output(getDatosPlanta(e.parameter.k));
      case 'listusuarios': return output(listUsuarios());
      case 'getdrivers': return output({ status: 'success', drivers: obtenerEstadoChoferes() });
      case 'getpendingtrips': return output({ status: 'success', trips: getPendingTrips_Carga() });
      case 'getflota': return output(obtenerFlota()); 
      case 'listclientes': return output(listClientes());
      case 'getoptions': return output(getOptionsData());
      case 'getactivezones': return output(obtenerZonasDeClientes());
      
      case 'getlogservices':
      return ContentService.createTextOutput(JSON.stringify(getLogServices(e.parameter.k))).setMimeType(ContentService.MimeType.JSON);
      case 'getflotadetalle': {
          if (!apiKeyValida && !obtenerDatosPorToken(e.parameter.k).valido) return output({ status: 'error', message: 'Sesión inválida' });
          return output({ status: 'success', data: obtenerFlotaDetalle() });
      }
      case 'getcomisiones_choferes': return output({ status: 'success', data: obtenerChoferesComision() });
      case 'getcomisiones_detalle': return output({ status: 'success', data: obtenerDetalleComision(e.parameter.chofer) });
      case 'listprecios': return output(listPrecios());
      case 'getcauciones': return output(obtenerCaucionesActivas());
      case 'gettreeview': {
          // Pase VIP temporal para el frontend de Firebase
          return output(getDatosTreeview(e.parameter.start, e.parameter.end));
      }
      case 'gettransferencias': {
          return output({ status: 'success', data: getTransferencias(e.parameter.modo, e.parameter.start, e.parameter.end) });
      }

      case 'getcomprasauditar': {
          return output({ status: 'success', compras: getComprasAuditar() });
      }

      case 'getauditoriafinanzas': {
          if (!apiKeyValida && !obtenerDatosPorToken(e.parameter.k).valido) return output({ status: 'error', message: 'Sesión inválida' });
          return output(getAuditoriaFinanzas(e.parameter.start, e.parameter.end));
      }

      case 'usuarioinfo': {
        if (e.parameter.k) {
           const sesion = obtenerDatosPorToken(e.parameter.k);
           if (sesion.valido) {
               const pin = verificarPermisoYObtenerPin(sesion.usuario);
               return output({ 
                   status: 'success', 
                   nombre: sesion.nombre, 
                   perms: sesion.perms,
                   pin_dinamico: pin
               });
           }
        }

        const usuarioParam = (e?.parameter?.usuario || '').toString().trim();
        if (usuarioParam) {
            const info = getUserInfo(usuarioParam);
            return info ? output({ status: 'success', ...info }) : output({ status: 'error', message: 'User not found' });
        }

        return output({ status: 'error', message: 'Faltan parámetros (k o usuario)' });
      }

      case 'alarmascount': return output({ status: 'success', pendientes: alarmasCount() });
      case 'listalarmas': return output({ status: 'success', alarmas: listAlarmas(e?.parameter?.onlyPending === 'true', Number(e?.parameter?.limit || 0)) });
      case 'getfinanzas': {
         if (!apiKeyValida && !obtenerDatosPorToken(e.parameter.k).valido) return output({ status: 'error', message: 'Sesión inválida' });
         return output({ status: 'success', ...obtenerResumenFinanciero(e.parameter.chofer) });
      }
      case 'getstockstatus': return output(obtenerEstadoStock());

      case 'getfinancetree': {
         return output(getDataTree(e.parameter.start, e.parameter.end));
      }

      case 'getmicaja': {
         // Eliminamos validación vieja, el token de Firebase delega la identidad en usuarioReq
         return output(getDatosMiCaja(usuarioReq));
      }

      default: return HtmlService.createHtmlOutput('OK');
    }
  } catch (err) { return output({ status: 'error', message: err.message }); }
}

function doPost(e) {
  const output = (data) => ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);

  try {
    const action = (e?.parameter?.action || '').toLowerCase();
    
    // ---> ACÁ TOMAMOS EL ID QUE MANDÓ EL HTML DIRECTO (ESQUIVAMOS A LA PLANILLA) <---
    const usuarioReq = e?.parameter?.USUARIO || e?.parameter?.usuario || 'SISTEMA';
    const apiKeyValida = (e?.parameter?.api_key === 'VM_Seguridad_2026');

    if (action === 'gettablerodata') {
      try {
        const payload = obtenerDatosTablero(e.parameter.start, e.parameter.end, e.parameter.view);
        return ContentService.createTextOutput(JSON.stringify({ status: 'success', payload: payload })).setMimeType(ContentService.MimeType.JSON);
      } catch (error) {
        return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: error.toString() })).setMimeType(ContentService.MimeType.JSON);
      }
    }

    if (action === 'login') {
      const result = loginYGenerarToken(e.parameter.usuario, e.parameter.clave);
      
      if (result && result.status === 'success') {
        const props = PropertiesService.getScriptProperties();
        let tsUsr = props.getProperty('TS_USUARIOS');
        if (!tsUsr) {
          tsUsr = new Date().getTime().toString();
          props.setProperty('TS_USUARIOS', tsUsr);
        }
        result.TS_USUARIOS = tsUsr;
      }
      return output(result);
    }
    
    if (action === 'gettimestamps') return output({ status: 'success', ...getTimestamps() });
    if (action === 'marcarupdate') {
      marcarActualizacion(e.parameter.clave);
      return output({ status: 'success' });
    }
    
    const k = e.parameter.k || e.parameter.token;
    
    // ---> SI ES GUARDAR REGISTRO, ACCIÓN DE FIREBASE O TIENE API KEY VÁLIDA, NOS SALTEAMOS EL BLOQUEO DEL TOKEN <---
    if (!apiKeyValida && action !== 'guardarregistro' && action !== 'savetransporte' && action !== 'getremanente' && 
        action !== 'savestock' && action !== 'crearcaucion' && action !== 'cerrarcaucion' && action !== 'anularcaucion' &&
        action !== 'savearqueo' && action !== 'conciliarlotecompras' && action !== 'savecomisiones' &&
        action !== 'ajustartransferencia' && action !== 'verifytransferenciabatch' && action !== 'saveclientes' &&
        action !== 'saveexpense' && action !== 'modify' && action !== 'changepin') {
        
        const sesion = obtenerDatosPorToken(k);
        if (!sesion.valido && action !== 'verificarsesion') {
           return output({ status: 'error', message: 'Sesión expirada' });
        }
        if (action === 'verificarsesion') return output({ status: sesion.valido ? 'success' : 'error', ...sesion });
    }

    if (action === 'getremanente') {
        return output({
            status: 'success',
            sugerencia: { 
                10: {L: 0, V: 0}, 
                15: {L: 0, V: 0}, 
                45: {L: 0, V: 0} 
            },
            totalEntregas: 0
        });
    }

    if (action === 'get_compras') {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const sh = ss.getSheetByName('COMPRAS');
      if(!sh) return output({status:'error', message:'Falta hoja COMPRAS'});
      const data = sh.getDataRange().getValues();
      let transito = [], recibidos = [];
      let p10 = 0, p15 = 0, p45 = 0;
      
      for(let i = data.length - 1; i > 0; i--) {
         if(data[i][2] === 'FACTURADO') {
             p10 = data[i][14] || 0; p15 = data[i][15] || 0; p45 = data[i][16] || 0;
             break;
         }
      }

      for(let i = 1; i < data.length; i++) {
         const r = data[i];
         const obj = { row: i+1, id: r[0], fecha: r[1], estado: r[2], chofer: r[3], e10: r[4], e15: r[5], e45: r[6] };
         if(r[2] === 'EN TRÁNSITO') transito.push(obj);
         if(r[2] === 'RECIBIDO') recibidos.push({...obj, r10: r[8], r15: r[9], r45: r[10]});
      }
      return output({status: 'success', transito, recibidos, precios: {p10, p15, p45}});
    }


    // =======================================================
    // ZONA VIP: ACCIONES CRÍTICAS (Con Patovica / LockService)
    // =======================================================
    
    var lock = LockService.getScriptLock();
    try { 
      lock.waitLock(30000); 
    } catch (err) { 
      return output({ status: 'error', message: 'El servidor está ocupado. Intenta guardar de nuevo.' }); 
    }
    
    try {
      switch (action) {
        
        case 'salida_compra': {
          const ss = SpreadsheetApp.getActiveSpreadsheet();
          const sh = ss.getSheetByName('COMPRAS');
          const id = "CMP-" + new Date().getTime();
          sh.appendRow([id, e.parameter.fecha, 'EN TRÁNSITO', e.parameter.chofer, e.parameter.e10, e.parameter.e15, e.parameter.e45, '', '', '', '', '', '', '', '', '', '']);
          return output({status: 'success'});
        }
        case 'ingreso_compra': {
          const ss = SpreadsheetApp.getActiveSpreadsheet();
          const sh = ss.getSheetByName('COMPRAS');
          const row = parseInt(e.parameter.row);
          sh.getRange(row, 3).setValue('RECIBIDO'); 
          sh.getRange(row, 8).setValue(e.parameter.fecha); 
          sh.getRange(row, 9).setValue(e.parameter.r10);
          sh.getRange(row, 10).setValue(e.parameter.r15);
          sh.getRange(row, 11).setValue(e.parameter.r45);
          return output({status: 'success'});
        }
        case 'facturar_compra': {
          const ss = SpreadsheetApp.getActiveSpreadsheet();
          const sh = ss.getSheetByName('COMPRAS');
          const row = parseInt(e.parameter.row);
          sh.getRange(row, 3).setValue('FACTURADO'); 
          sh.getRange(row, 12).setValue(e.parameter.remito);
          sh.getRange(row, 13).setValue(e.parameter.factura);
          sh.getRange(row, 14).setValue(e.parameter.fecha_fact);
          sh.getRange(row, 15).setValue(e.parameter.p10);
          sh.getRange(row, 16).setValue(e.parameter.p15);
          sh.getRange(row, 17).setValue(e.parameter.p45);
          return output({status: 'success'});
        }

        case 'conciliarcompra': return output(conciliarCompra(e.parameter, usuarioReq));
        case 'modificarcompra': return output(modificarCompra(e.parameter, usuarioReq)); 
        case 'saveservice': return output(registrarService(e.parameter, usuarioReq));
        case 'savecomisiones': return output(guardarPagoComision(e.parameter, usuarioReq));
        case 'ajustartransferencia': 
          return output(ajustarMontosTransferencia(e.parameter.row, e.parameter.nuevoE, e.parameter.nuevoT, usuarioReq));
        case 'conciliarlotecompras': 
          return output(conciliarLoteCompras(e.parameter, usuarioReq));
        
        case 'saveprice_single': {
            CacheService.getScriptCache().remove('INIT_APP_DATA'); // Rompemos caché al cambiar precio individual
            return output(guardarPrecioIndividual(e.parameter));
        }
        
        // ---> ACÁ USAMOS EL USUARIO QUE MANDA EL FRONTEND DIRECTAMENTE <---
        case 'guardarregistro': { 
            e.parameter.USUARIO = usuarioReq; 
            return output(procesarRegistro(e.parameter)); 
        }
        
        case 'registrar': return output({status:'success'}); 
        case 'saveusuarios': { 
            const res = saveUsuarios(e.parameter.rows); 
            if (res && res.status === 'success') marcarActualizacion('TS_USUARIOS');
            return output(res); 
        }
        case 'saveclientes': return output(saveClientes(e.parameter.rows));
        case 'upload_audio': return output(guardarAudioEnDrive(e.parameter.audioBase64, e.parameter.fileName));
        case 'saveprecios': {
            CacheService.getScriptCache().remove('INIT_APP_DATA'); // Rompemos caché si cambian los precios en bloque
            return output(savePrecios(e.parameter.rows));
        }
        case 'checkalarma': return output({ status: marcarAlarma(Number(e?.parameter?.row)) ? 'success' : 'error' });
        case 'clearallalarmas': marcarTodasAlarmas(); return output({ status: 'success' });
        case 'ingresoflotante': return output(registrarIngresoFlotante(e.parameter));
        case 'savealarmas': return output({ status: saveAlarmasBatch(JSON.parse(e.parameter.rows || '[]')) ? 'success' : 'error' });
        case 'verifytransferenciabatch': return output(updateTransferenciaBatch(e.parameter.rowsData, e.parameter.accion, usuarioReq));
        case 'crearcaucion': return output(crearCaucion(e.parameter, usuarioReq));
        case 'cerrarcaucion': return output(cerrarCaucion(e.parameter, usuarioReq));
        case 'anularcaucion': return output(anularCaucion(e.parameter, usuarioReq));
        case 'getcauciones': return output(obtenerCaucionesActivas());
        case 'savestock': { e.parameter.usuario = usuarioReq; return output(nuevaSaveStock(e)); }  
        case 'savetransporte': return output(procesarTransporte(e.parameter, usuarioReq));
        case 'savearqueo': return output(guardarArqueo(e.parameter, usuarioReq));

        case 'saveexpense': {
            const body = JSON.parse(e.parameter.data || '{}');
            body.usuario = usuarioReq;
            saveExpense(body);
            return output({ status: 'success' });
        }
        case 'modify': {
            CacheService.getScriptCache().remove('INIT_APP_DATA'); // Rompemos caché al modificar ventas/caja
            const d = JSON.parse(e.parameter.data || "{}");
            return output(modifyTransaction(e.parameter.k, e.parameter.type, e.parameter.id, e.parameter.pin, d));
        }
        case 'changepin': return output(changeMasterPin(e.parameter.k, e.parameter.oldPin, e.parameter.newPin));

        case 'add_pago': return output(agregarPagoCalendario(e.parameter));
        case 'get_proximos_pagos': return output(obtenerProximosPagos());

        default: return output({ status: 'error', message: 'Acción desconocida' });
      }
    } finally { 
      lock.releaseLock(); 
    }
  } catch (e) { 
    return output({ status: 'error', message: 'Error general: ' + e.message }); 
  }
}


// =======================================================
// NUEVAS FUNCIONES PARA FINANZAS (AGREGAR AL FINAL)
// =======================================================


function _getFinanzasSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName('CONFINANZAS');
  if (!sh) {
    sh = ss.insertSheet('CONFINANZAS');
    sh.appendRow(['ID', 'FECHA', 'RUBRO', 'SUBRUBRO', 'DETALLE', 'MONTO', 'USUARIO', 'TIMESTAMP']);
  }
  return sh;
}

function getDataTree(startStr, endStr) {
  const sh = _getFinanzasSheet();
  const data = sh.getDataRange().getValues();
  
  if (data.length < 2) {
      return { tree: {}, summary: { ingresos:0, gastos:0, total:0 }, options: {} };
  }

  const start = startStr ? new Date(startStr + 'T00:00:00') : new Date('2000-01-01');
  const end = endStr ? new Date(endStr + 'T23:59:59') : new Date('2100-01-01');

  const tree = {};
  const options = {}; 
  let ingresos = 0, gastos = 0;

  // TOPE RETROVISOR: 6 meses para sugerencias (Datalist)
  const hace6Meses = new Date();
  hace6Meses.setMonth(hace6Meses.getMonth() - 6);

  // Recorremos los datos (fila 1 en adelante)
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    let rowDate = row[1]; // Columna B: FECHA
    
    // --- LÓGICA DE LIMPIEZA DE FECHA (Intacta) ---
    let fechaObj;
    if (rowDate instanceof Date) {
        fechaObj = rowDate;
    } else {
        fechaObj = new Date(String(rowDate).substring(0, 10) + 'T12:00:00');
    }

    if (isNaN(fechaObj.getTime())) continue;

    const checkDate = new Date(fechaObj);
    checkDate.setHours(12,0,0,0); 
    
    const idReg = String(row[0]); 
    const l1 = String(row[2]).trim() || 'VARIOS';
    const l2 = String(row[3]).trim() || 'General';
    const det = String(row[4]).trim();
    
    // --- MOTOR MATEMÁTICO Y TIPO ---
    const rawMonto = Number(row[5]) || 0; // Columna F (Índice 5)
    const tipoCelda = String(row[8] || '').trim().toUpperCase(); // Columna I (Índice 8)

    // Si dice EGRESO, o si (por lo viejo) no dice nada y es negativo
    const esEgreso = (tipoCelda === 'EGRESO') || (tipoCelda === '' && rawMonto < 0);
    const absMonto = Math.abs(rawMonto); // Siempre positivo
    const mathMonto = esEgreso ? -absMonto : absMonto; // Para las sumas

    // Guardar opciones para Autocompletado (solo últimos 6 meses, sin importar el filtro de fecha actual)
    if (checkDate >= hace6Meses) {
      if (!options[l1]) options[l1] = new Set();
      options[l1].add(l2);
    }

    // APLICAMOS FILTRO DE FECHAS DE PANTALLA
    if (checkDate < start || checkDate > end) continue;

    // Formato visual
    const dia = ("0" + fechaObj.getDate()).slice(-2);
    const mes = ("0" + (fechaObj.getMonth() + 1)).slice(-2);
    const anio = fechaObj.getFullYear();
    const fechaVisual = `${dia}/${mes}/${anio}`;

    // Sumar Totales
    if (!esEgreso) ingresos += mathMonto;
    else gastos += mathMonto;

    // Construir Árbol
    if (!tree[l1]) tree[l1] = { total: 0, subs: {} };
    tree[l1].total += mathMonto;

    if (!tree[l1].subs[l2]) tree[l1].subs[l2] = { total: 0, items: [] };
    tree[l1].subs[l2].total += mathMonto;
    
    tree[l1].subs[l2].items.push({
      id: idReg,       
      fecha: fechaVisual, 
      detalle: det,
      monto: mathMonto,
      tipo: esEgreso ? 'EGRESO' : 'INGRESO' // Etiqueta para el frontend
    });
  }

  // Convertir Sets a Arrays
  const finalOptions = {};
  for(let k in options) finalOptions[k] = Array.from(options[k]).sort();

  return { 
    tree: tree, 
    summary: { ingresos, gastos, total: ingresos + gastos },
    options: finalOptions
  };
}

function saveExpense(body) {
  const sh = _getFinanzasSheet();
  const id = Utilities.getUuid().slice(0,8);
  const ts = new Date();
  
  const absMonto = Math.abs(Number(body.monto) || 0);
  const tipoStr = String(body.tipo).toUpperCase() === 'INGRESO' ? 'INGRESO' : 'EGRESO';
  
  // 1. Armar el detalle enriquecido si se completaron los pagos desde el nuevo panel
  let detalleFinal = String(body.nivel3 || '').trim();
  
  if (body.pagos) {
      let partesPagos = [];
      if (body.pagos.efectivo > 0) partesPagos.push(`Efvo: $${body.pagos.efectivo}`);

      if (body.pagos.depositos && body.pagos.depositos.length > 0) {
          let deps = body.pagos.depositos.map(d => `$${d.monto} (Op:${d.ref})`).join(', ');
          partesPagos.push(`Dep: ${deps}`);
      }

      if (body.pagos.transferencias && body.pagos.transferencias.length > 0) {
          let trans = body.pagos.transferencias.map(t => `$${t.monto} (Op:${t.ref})`).join(', ');
          partesPagos.push(`Transf: ${trans}`);
      }

      if (partesPagos.length > 0) {
          detalleFinal += " | PAGOS: " + partesPagos.join(' | ');
      }
  }
  
  // 2. Grabar la fila principal
  sh.appendRow([
    id,
    body.fecha,        // YYYY-MM-DD
    body.nivel1,       // Rubro
    body.nivel2,       // Subrubro
    detalleFinal,      // Detalle enriquecido
    absMonto,          // Col F: Monto absoluto
    body.usuario || 'System',
    ts,
    tipoStr            // Col I: El tipo exacto
  ]);

  // 3. Procesar el desdoble automático para el IMPUESTO LEY 25413 (0.6% de cada transferencia)
  if (body.pagos && body.pagos.transferencias && body.pagos.transferencias.length > 0) {
      // Tomamos hasta 27 caracteres del detalle base para no saturar la celda
      let descCorta = String(body.nivel3 || '').trim().substring(0, 27);
      if (String(body.nivel3 || '').length > 27) descCorta += "...";

      body.pagos.transferencias.forEach(t => {
          const taxMonto = t.monto * 0.006; // Matemática dura del 0.6%
          const detImpuesto = `${descCorta} | LEY 25413 (0.6% de $${t.monto}) | Op: ${t.ref}`;
          const idTax = Utilities.getUuid().slice(0,8);

          sh.appendRow([
              idTax, 
              body.fecha, 
              'CUENTA BANCARIA', 
              'IMPUESTO LEY 25413',
              detImpuesto, 
              taxMonto, 
              body.usuario || 'System', 
              ts, 
              'EGRESO' // El impuesto bancario SIEMPRE es un egreso
          ]);
      });
  }
}

function modifyTransaction(k, type, id, pin, dataObj) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheetData = ss.getSheetByName('CONFINANZAS');
  
  if (!sheetData) return { status: 'error', message: 'No existe la hoja CONFINANZAS' };

  // --- 1. VALIDACIÓN DE SEGURIDAD ---
  const datosSesion = obtenerDatosPorToken(k);
  const usuarioAccion = datosSesion.valido ? datosSesion.usuario : 'Desconocido';

  const autorizado = validarYRotarPin(
      usuarioAccion, 
      pin, 
      `MODIFICACION [${type}] ID:${id}` 
  );

  if (!autorizado) {
      return { status: 'error', message: 'PIN INVÁLIDO O YA UTILIZADO' };
  }

  // --- 2. BUSCAR REGISTRO ---
  const finder = sheetData.getRange("A:A").createTextFinder(String(id).trim()).matchEntireCell(true);
  const result = finder.findNext();

  if (!result) return { status: 'error', message: 'Registro no encontrado (pero el PIN se usó)' };

  const realRow = result.getRow();
  if (realRow === 1) return { status: 'error', message: 'No se puede modificar el encabezado' };

  // --- 3. AUDITORÍA INTERNA (Ahora lee 9 columnas para el backup) ---
  const oldData = sheetData.getRange(realRow, 1, 1, 9).getValues()[0];
  const historialRow = [
    ...oldData,
    new Date(),
    type === 'DELETE' ? 'ELIMINADO' : 'MODIFICADO_PREVIO',
    usuarioAccion
  ];
  _getHistorialSheet().appendRow(historialRow);

  // --- 4. EJECUTAR ACCIÓN ---
  if (type === 'DELETE') {
    sheetData.deleteRow(realRow); 
    registrarAlarma("ELIMINACIÓN", `[ID:${id}] Eliminado por ${usuarioAccion}.`, usuarioAccion);
    
  } else if (type === 'UPDATE') {
    const d = dataObj;
    const absMonto = Math.abs(Number(d.monto) || 0);
    const tipoStr = String(d.tipo).toUpperCase() === 'INGRESO' ? 'INGRESO' : 'EGRESO';

    // Actualizamos 8 columnas (desde la B hasta la I)
    sheetData.getRange(realRow, 2, 1, 8).setValues([[
      d.fecha, d.nivel1, d.nivel2, d.nivel3, absMonto, usuarioAccion, new Date(), tipoStr
    ]]);
    registrarAlarma("MODIFICACIÓN", `[ID:${id}] Modificado por ${usuarioAccion}.`, usuarioAccion);
  }

  return { status: 'success' };
}
 

function changeMasterPin(k, oldPin, newPin) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetUser = ss.getSheetByName("USUARIOS");
  
  if (sheetUser.getMaxColumns() < 21) {
      sheetUser.insertColumnsAfter(sheetUser.getMaxColumns(), 21 - sheetUser.getMaxColumns());
  }
  
  // CORRECCIÓN: Fila 4, Columna 21 (U4)
  const currentPin = String(sheetUser.getRange(4, 21).getValue() || "").trim();
  
  if (currentPin !== "" && String(oldPin).trim() !== currentPin) {
    return { status: 'error', message: 'PIN Actual Incorrecto' };
  }
  
  // Guardar en U4
  sheetUser.getRange(4, 21).setValue(String(newPin).trim()); 
  
  const datosSesion = typeof obtenerDatosPorToken === "function" ? obtenerDatosPorToken(k) : null;
  const usuarioAccion = (datosSesion && datosSesion.usuario) ? datosSesion.usuario : 'Sistema';
  
  registrarAlarma("SEGURIDAD", "Cambio de PIN MAESTRO realizado", usuarioAccion);
  
  return { status: 'success' };
}


// =======================================================
// 2. HELPERS Y FUNCIONES GENERALES
// =======================================================


function findColIndex(headers, possibleNames) {
  if (!headers) return -1;
  const upperHeaders = headers.map(h => String(h).toUpperCase().trim());
  for (let name of possibleNames) {
    const idx = upperHeaders.indexOf(name);
    if (idx > -1) return idx;
  }
  return -1;
}

function obtenerEstadoChoferes() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  const shCarga = ss.getSheetByName('CCARGA') || ss.getSheetByName('CONTROL_CARGA') || ss.getSheetByName('CSTOCK');
  
  const map = {}; 

  // --- 1. DEUDA (BD1) ---
  if (shBD1) {
    const data = shBD1.getDataRange().getValues();
    if (data.length >= 2) {
      const headers = data[1]; 
      
      const idxUser = findColIndex(headers, ['USUARIO', 'CHOFER', 'REPARTIDOR']);
      const idxArqueo = findColIndex(headers, ['ARQUEO_ID', 'ID_ARQUEO', 'ARQUEO']);
      const idxE = findColIndex(headers, ['E$', 'EFECTIVO', 'PAGO EFECTIVO']);
      const idxT = findColIndex(headers, ['T$', 'TRANSFERENCIA', 'PAGO TRANSFERENCIA']);
      const idxTotal = findColIndex(headers, ['TOTAL', 'MONTO', 'PRECIO']);
      const idxTipo = findColIndex(headers, ['TIPO', 'MOVIMIENTO']);
      
      const idxViaje = findColIndex(headers, ['ID_VIAJE', 'VIAJE_ID', 'VIAJE']);
      const idxFecha = findColIndex(headers, ['FECHA', 'DATE']);
      const idxDesc = findColIndex(headers, ['RECEPTOR', 'ZONA', 'DETALLE', 'DESCRIPCION', 'OBSERVACION']); // Agregado para extraer motivos de gastos

      if (idxUser > -1) {
        let arqueadosConsecutivos = 0; // Freno de seguridad para no leer la hoja entera

        // BUCLE INVERSO: De abajo hacia arriba
        for (let i = data.length - 1; i >= 2; i--) {
          const row = data[i];
          const chofer = String(row[idxUser]).toUpperCase().trim();
          if (!chofer) continue;

          const yaArqueada = (idxArqueo > -1) ? String(row[idxArqueo] || '').trim() : '';
          
          if (yaArqueada !== '') {
             arqueadosConsecutivos++;
             if (arqueadosConsecutivos > 150) break; // Si lee 150 filas viejas ya arqueadas, corta el bucle
             continue;
          }
          
          arqueadosConsecutivos = 0; // Resetea si encuentra una fila fresca sin arquear
          
          const idViaje = (idxViaje > -1 && row[idxViaje]) ? String(row[idxViaje]).trim() : chofer;
          
          let rawFecha = (idxFecha > -1) ? row[idxFecha] : '';
          let fechaStr = '';
          if (rawFecha instanceof Date) {
             fechaStr = Utilities.formatDate(rawFecha, Session.getScriptTimeZone(), 'dd/MM/yyyy');
          } else if (rawFecha) {
             fechaStr = String(rawFecha).substring(0,10);
          }

          // La nueva llave combinada a prueba de choferes que venden SIN_CAMION
          const mapKey = chofer + '|' + idViaje;

          if (!map[mapKey]) {
             map[mapKey] = { 
                 idViaje: idViaje, // Se conserva limpio para que el HTML lo lea bien
                 nombre: chofer, 
                 fecha: fechaStr, 
                 saldo: 0, 
                 enRuta: false,
                 efectivo: 0,
                 transf: 0,
                 gastos: 0,
                 listaGastos: []
             };
          }
          
          const tipo = idxTipo > -1 ? String(row[idxTipo]).toUpperCase() : 'VENTA';
          
          if (tipo.includes('GAST')) {
             const montoGasto = (Number(row[idxTotal]) || 0);
             map[mapKey].saldo -= montoGasto;
             map[mapKey].gastos += montoGasto;
             map[mapKey].listaGastos.push({ 
                 motivo: (idxDesc > -1 ? String(row[idxDesc]) : 'Gasto sin detalle'), 
                 monto: montoGasto 
             });
          } else {
             let e = (idxE > -1) ? (Number(row[idxE]) || 0) : 0;
             let t = (idxT > -1) ? (Number(row[idxT]) || 0) : 0;
             let suma = e + t;
             
             // Si el sistema no cargó desglose pero hay un total, lo forzamos a efectivo
             if(suma === 0 && idxTotal > -1) suma = (Number(row[idxTotal])||0);
             if(e === 0 && t === 0 && suma > 0) e = suma; 
             
             map[mapKey].efectivo += e;
             map[mapKey].transf += t;
             map[mapKey].saldo += suma;
          }
        }
      }
    }
  }

  // --- 2. RUTA (CCARGA) ---
  if (shCarga) {
    const data = shCarga.getDataRange().getValues();
    if (data.length > 1) {
       let headers = data[0];
       let idxEstado = findColIndex(headers, ['ESTADO', 'STATUS']);
       let idxChofer = findColIndex(headers, ['CHOFER', 'REPARTIDOR']);
       let idxViajeCarga = findColIndex(headers, ['ID_VIAJE', 'VIAJE_ID', 'VIAJE']);
       let startRow = 1;

       if (idxEstado === -1) {
           headers = data[1];
           idxEstado = findColIndex(headers, ['ESTADO', 'STATUS']);
           idxChofer = findColIndex(headers, ['CHOFER', 'REPARTIDOR']);
           idxViajeCarga = findColIndex(headers, ['ID_VIAJE', 'VIAJE_ID', 'VIAJE']);
           startRow = 2;
       }

       const safeIdxEstado = idxEstado > -1 ? idxEstado : 1; 
       const safeIdxChofer = idxChofer > -1 ? idxChofer : 2;

       // BUCLE INVERSO
       for (let i = data.length - 1; i >= startRow; i--) {
           const estado = String(data[i][safeIdxEstado] || '').toUpperCase().trim();
           if (estado === 'EN_RUTA') {
               const chofer = String(data[i][safeIdxChofer] || '').toUpperCase().trim();
               const idViajeRuta = (idxViajeCarga > -1 && data[i][idxViajeCarga]) ? String(data[i][idxViajeCarga]).trim() : chofer;
               
               if (chofer) {
                   const mapKey = chofer + '|' + idViajeRuta;
                   if (!map[mapKey]) {
                       map[mapKey] = { 
                           idViaje: idViajeRuta, 
                           nombre: chofer, 
                           fecha: 'HOY', 
                           saldo: 0, 
                           enRuta: false, 
                           efectivo: 0, 
                           transf: 0, 
                           gastos: 0, 
                           listaGastos: [] 
                       };
                   }
                   map[mapKey].enRuta = true;
               }
           }
       }
    }
  }

  return Object.values(map).filter(d => Math.abs(d.saldo) > 0 || d.enRuta);
}

function obtenerResumenFinanciero(chofer) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  if (!sh) return { efectivo: 0, transf: 0, gastos: 0, listaGastos: [] };

  const data = sh.getDataRange().getValues();
  if (data.length < 2) return { efectivo: 0, transf: 0, gastos: 0, listaGastos: [] };

  const idViajeBusqueda = String(chofer).toUpperCase().trim();
  const headers = data[1];
  
  const idxUser = findColIndex(headers, ['USUARIO', 'CHOFER', 'REPARTIDOR']);
  const idxArqueo = findColIndex(headers, ['ARQUEO_ID', 'ID_ARQUEO', 'ARQUEO']);
  const idxE = findColIndex(headers, ['E$', 'EFECTIVO']);
  const idxT = findColIndex(headers, ['T$', 'TRANSFERENCIA']);
  const idxTotal = findColIndex(headers, ['TOTAL', 'MONTO']);
  const idxTipo = findColIndex(headers, ['TIPO', 'MOVIMIENTO']);
  const idxDesc = findColIndex(headers, ['RECEPTOR', 'ZONA', 'DETALLE', 'DESCRIPCION', 'OBSERVACION']);
  const idxViaje = findColIndex(headers, ['ID_VIAJE', 'VIAJE_ID', 'VIAJE']);

  if (idxUser === -1) return { efectivo: 0, transf: 0, gastos: 0, listaGastos: [] };

  let efectivo = 0, transf = 0, gastos = 0, count = 0;
  let listaGastos = [];

  // BUCLE INVERSO
  for (let i = data.length - 1; i >= 2; i--) {
    const row = data[i];
    const userRow = String(row[idxUser]).toUpperCase().trim();
    const viajeRow = (idxViaje > -1 && row[idxViaje]) ? String(row[idxViaje]).toUpperCase().trim() : userRow;
    const yaArqueada = (idxArqueo > -1) ? String(row[idxArqueo] || '').trim() : '';

    if ((viajeRow === idViajeBusqueda || userRow === idViajeBusqueda) && yaArqueada === '') {
      const tipo = idxTipo > -1 ? String(row[idxTipo]).toUpperCase() : 'VENTA';
      
      if (tipo.includes('GAST')) {
        const monto = (Number(row[idxTotal]) || 0);
        gastos += monto;
        listaGastos.push({ 
            motivo: (idxDesc > -1 ? String(row[idxDesc]) : 'Gasto sin detalle'), 
            monto: monto 
        });
      } else {
        if (idxE > -1) efectivo += (Number(row[idxE]) || 0);
        if (idxT > -1) transf += (Number(row[idxT]) || 0);
        if (idxE === -1 && idxT === -1 && idxTotal > -1) efectivo += (Number(row[idxTotal])||0);
      }
      count++;
    }
  }

  return { efectivo, transf, gastos, movimientos: count, listaGastos: listaGastos };
}

function guardarArqueo(p, auditor) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let shArqueo = ss.getSheetByName('ARQUEOS') || ss.getSheetByName('ARQUEO'); 
  
  if (!shArqueo) {
    shArqueo = ss.insertSheet('ARQUEOS');
    shArqueo.appendRow(['ID_CIERRE', 'FECHA', 'HORA', 'CHOFER', 'SIS_EFECTIVO', 'SIS_TRANSF', 'SIS_GASTOS', 'REAL_EFECTIVO', 'REAL_TRANSF', 'DIFERENCIA', 'OBSERVACIONES', 'AUDITOR', 'ID_VIAJE']);
  }
  
  const shFinanzas = ss.getSheetByName('CONFINANZAS');

  const ahora = new Date();
  const idCierre = Utilities.getUuid().slice(0,8).toUpperCase();
  const fecha = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy');
  const hora = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'HH:mm:ss');
  
  // 1. DESARMAR LA CAJA DE VIAJES
  // El frontend manda un JSON con todos los viajes seleccionados
  const viajesSeleccionados = JSON.parse(p.viajesAgrupados);
  
  // Plata física total entregada
  let efectivoFisicoRestante = Number(p.realEfectivo) || 0;
  
  // Para marcar la BD1 rápido, armamos un array con los IDs que vamos a afectar
  const targetIds = viajesSeleccionados.map(v => String(v.idViaje || p.chofer).toUpperCase().trim());

  // 2. PROCESAR CADA VIAJE Y REPARTIR EL EFECTIVO
  for (let i = 0; i < viajesSeleccionados.length; i++) {
      const v = viajesSeleccionados[i];
      const esElUltimo = (i === viajesSeleccionados.length - 1);
      
      const sisE = Number(v.efectivo) || 0;
      const sisG = Number(v.gastos) || 0;
      const sisT = Number(v.transf) || 0;
      const teoricoViaje = sisE - sisG;
      
      let realEViaje = 0;
      let diferenciaViaje = 0;
      
      // Si el chofer rinde todo junto, asignamos el "teórico exacto" a los primeros viajes
      // y le volcamos la diferencia al último viaje.
      if (esElUltimo) {
          realEViaje = efectivoFisicoRestante;
          diferenciaViaje = realEViaje - teoricoViaje;
      } else {
          realEViaje = teoricoViaje;
          efectivoFisicoRestante -= realEViaje;
          diferenciaViaje = 0;
      }

      // 3. REGISTRAR EN ARQUEOS
      shArqueo.appendRow([
          idCierre, fecha, hora, p.chofer,
          sisE, sisT, sisG,
          realEViaje, sisT, diferenciaViaje,      
          p.observaciones, auditor, v.idViaje
      ]);

      if (Math.abs(diferenciaViaje) > 50) {
          const tipoAlarma = diferenciaViaje < 0 ? 'FALTANTE_CAJA' : 'SOBRANTE_CAJA';
          const desc = `Viaje Múltiple: ${v.idViaje}. Chofer: ${p.chofer}. Diferencia imputada: $${diferenciaViaje}. Obs: ${p.observaciones}`;
          registrarAlarma(tipoAlarma, desc, auditor);
      }
  }

  // 4. EL DOBLE IMPACTO (Mandar a CONFINANZAS) - UNIFICADO Y FUERA DEL BUCLE
  if (shFinanzas) {
      const cantViajes = viajesSeleccionados.length;
      const totalEfectivoReal = Number(p.realEfectivo) || 0;
      const totalTransferencias = Number(p.sisTransf) || 0;
      
      const strDetalle = `Arqueo consolidado (${cantViajes} viaje/s) | Chofer: ${p.chofer} | Efectivo físico ingresado: $${totalEfectivoReal} | (Pendiente conciliar: $${totalTransferencias} en transf.)`;
      
      shFinanzas.appendRow([
          idCierre, fecha, 'GAS', 'ARQUEO DE VENTA', strDetalle,
          Math.abs(totalEfectivoReal), auditor,
          Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss'),
          'INGRESO'
      ]);
  }

  // 5. MARCAR BD1 COMO ARQUEADO (BUCLE INVERSO)
  const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  if (shBD1) {
      const data = shBD1.getDataRange().getValues();
      if (data.length > 1) {
          const headers = data[1];
          const idxUser = findColIndex(headers, ['USUARIO', 'CHOFER']);
          let idxArqueo = findColIndex(headers, ['ARQUEO_ID', 'ID_ARQUEO']);
          const idxViaje = findColIndex(headers, ['ID_VIAJE', 'VIAJE_ID', 'VIAJE']);

          if (idxArqueo === -1) { 
            idxArqueo = headers.length; 
            shBD1.getRange(2, idxArqueo + 1).setValue('ARQUEO_ID'); 
          }

          for (let i = data.length - 1; i >= 2; i--) {
            const row = data[i];
            const userRow = String(row[idxUser]).toUpperCase().trim();
            const viajeRow = (idxViaje > -1 && row[idxViaje]) ? String(row[idxViaje]).toUpperCase().trim() : userRow;
            const yaArqueada = (idxArqueo < row.length) ? String(row[idxArqueo] || '').trim() : '';

            // Si el viaje de esta fila está en nuestra lista de targetIds, lo liquidamos
            if (targetIds.includes(viajeRow) && yaArqueada === '') {
              shBD1.getRange(i + 1, idxArqueo + 1).setValue(idCierre);
            }
          }
      }
  }
  
  return { status: 'success', message: 'Arqueo múltiple guardado. ID: ' + idCierre };
}

///////////////////////////
/////controlcomisiones/////
///////////////////////////


function obtenerChoferesComision() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  if (!shBD1) return [];

  const data = shBD1.getDataRange().getValues();
  if (data.length < 2) return [];

  const headers = data[1];
  const idxUser = findColIndex(headers, ['USUARIO', 'CHOFER', 'REPARTIDOR']);
  const idxComision = findColIndex(headers, ['COMISION', 'COMISIÓN']);
  const idxComisionPagada = findColIndex(headers, ['COMISION_PAGADA', 'PAGO_COMISION', 'COMISIÓN PAGADA']);

  if (idxUser === -1 || idxComision === -1 || idxComisionPagada === -1) return [];

  const map = {};

  // Bucle inverso: lee de abajo hacia arriba
  for (let i = data.length - 1; i >= 2; i--) {
    const row = data[i];
    const chofer = String(row[idxUser]).toUpperCase().trim();
    if (!chofer) continue;

    const montoComision = Number(row[idxComision]) || 0;
    const pagada = String(row[idxComisionPagada] || '').trim();

    // Si tiene plata y no fue pagada, la sumamos
    if (montoComision > 0 && pagada === '') {
      if (!map[chofer]) map[chofer] = { nombre: chofer, total: 0, diasArr: [] };
      map[chofer].total += montoComision;
      
      // Intentamos capturar la fecha para contar cuántos días distintos tiene
      const idxFecha = findColIndex(headers, ['FECHA', 'DATE']);
      let fechaStr = 'Sin Fecha';
      if (idxFecha > -1) {
          let rawFecha = row[idxFecha];
          if (rawFecha instanceof Date) fechaStr = Utilities.formatDate(rawFecha, Session.getScriptTimeZone(), 'dd/MM/yyyy');
          else if (rawFecha) fechaStr = String(rawFecha).substring(0,10);
      }
      
      if (!map[chofer].diasArr.includes(fechaStr)) {
          map[chofer].diasArr.push(fechaStr);
      }
    }
  }

  // Devolvemos el array transformando los diasArr en un simple "conteo"
  return Object.values(map).map(c => ({
      nombre: c.nombre,
      total: c.total,
      dias: c.diasArr.length
  }));
}

function obtenerDetalleComision(chofer) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  if (!shBD1) return [];

  const data = shBD1.getDataRange().getValues();
  if (data.length < 2) return [];

  const headers = data[1];
  const idxUser = findColIndex(headers, ['USUARIO', 'CHOFER', 'REPARTIDOR']);
  const idxComision = findColIndex(headers, ['COMISION', 'COMISIÓN']);
  const idxComisionPagada = findColIndex(headers, ['COMISION_PAGADA', 'PAGO_COMISION', 'COMISIÓN PAGADA']);
  const idxFecha = findColIndex(headers, ['FECHA', 'DATE']);

  if (idxUser === -1 || idxComision === -1 || idxComisionPagada === -1) return [];

  const target = String(chofer).toUpperCase().trim();
  const mapFechas = {};

  // Bucle inverso
  for (let i = data.length - 1; i >= 2; i--) {
    const row = data[i];
    const userRow = String(row[idxUser]).toUpperCase().trim();
    if (userRow !== target) continue;

    const montoComision = Number(row[idxComision]) || 0;
    const pagada = String(row[idxComisionPagada] || '').trim();

    if (montoComision > 0 && pagada === '') {
      let fechaStr = 'Sin Fecha';
      if (idxFecha > -1) {
          let rawFecha = row[idxFecha];
          if (rawFecha instanceof Date) fechaStr = Utilities.formatDate(rawFecha, Session.getScriptTimeZone(), 'dd/MM/yyyy');
          else if (rawFecha) fechaStr = String(rawFecha).substring(0,10);
      }

      if (!mapFechas[fechaStr]) mapFechas[fechaStr] = 0;
      mapFechas[fechaStr] += montoComision;
    }
  }

  // Convertimos el mapa a un array amigable para el HTML
  return Object.keys(mapFechas).map(fecha => ({
      fecha: fecha,
      monto: mapFechas[fecha]
  }));
}

function guardarPagoComision(p, auditor) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // 1. Crear o leer la hoja COMISIONES
  let shComisiones = ss.getSheetByName('COMISIONES');
  if (!shComisiones) {
    shComisiones = ss.insertSheet('COMISIONES');
    shComisiones.appendRow(['ID_PAGO', 'FECHA_PAGO', 'CHOFER', 'DIA_LIQUIDADO', 'MONTO_DEL_DIA', 'AUDITOR', 'OBSERVACIONES']);
  }

  const ahora = new Date();
  const idPago = "COM-" + Utilities.getUuid().slice(0,6).toUpperCase();
  const fechaHoy = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy');
  
  const diasSeleccionados = JSON.parse(p.diasPagados); // Viene del HTML

  // 2. Anotar el detalle en COMISIONES (Una línea por cada día)
  diasSeleccionados.forEach(dia => {
      shComisiones.appendRow([
          idPago,
          fechaHoy,
          p.chofer,
          dia.fecha,
          dia.monto,
          auditor,
          p.observaciones
      ]);
  });

  // 3. El Doble Impacto: Clavar el EGRESO consolidado en CONFINANZAS
  const shFinanzas = ss.getSheetByName('CONFINANZAS');
  if (shFinanzas) {
      // Formato exacto que pediste
      const strDetalle = `Chofer: ${p.chofer} | Total Pago $${p.totalPago} / ${diasSeleccionados.length} Días | Efvo: $${p.efvo} | Transf: $${p.transf} | Dep: $${p.dep} | Op Dep. ${p.refDep || 'S/N'} | OP Transf. ${p.refTransf || 'S/N'}`;
      
      shFinanzas.appendRow([
          idPago,
          fechaHoy,
          'GASTOS OPERATIVOS',         // Podés cambiar este Rubro si preferís otro
          'PAGO COMISIONES',   // Podés cambiar este Subrubro si preferís otro
          strDetalle,
          Math.abs(Number(p.totalPago)), // Número absoluto, la hoja sabrá que es Egreso
          auditor,
          Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss'),
          'EGRESO'
      ]);
  }

  // 4. Marcar BD1 como pagado (Bucle inverso)
  const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  if (shBD1) {
      const data = shBD1.getDataRange().getValues();
      if (data.length > 1) {
          const headers = data[1];
          const idxUser = findColIndex(headers, ['USUARIO', 'CHOFER', 'REPARTIDOR']);
          const idxComisionPagada = findColIndex(headers, ['COMISION_PAGADA', 'PAGO_COMISION', 'COMISIÓN PAGADA']);
          const idxFecha = findColIndex(headers, ['FECHA', 'DATE']);

          const target = String(p.chofer).toUpperCase().trim();
          // Array rápido con las fechas que estamos pagando
          const fechasPagadas = diasSeleccionados.map(d => d.fecha);

          if (idxUser > -1 && idxComisionPagada > -1 && idxFecha > -1) {
              for (let i = data.length - 1; i >= 2; i--) {
                  const row = data[i];
                  const userRow = String(row[idxUser]).toUpperCase().trim();
                  
                  if (userRow === target && String(row[idxComisionPagada] || '').trim() === '') {
                      // Sacamos la fecha de la fila actual para ver si hace match con las seleccionadas
                      let rawFecha = row[idxFecha];
                      let fechaStr = 'Sin Fecha';
                      if (rawFecha instanceof Date) fechaStr = Utilities.formatDate(rawFecha, Session.getScriptTimeZone(), 'dd/MM/yyyy');
                      else if (rawFecha) fechaStr = String(rawFecha).substring(0,10);
                      
                      // Si la fecha del viaje está dentro de las fechas que tildamos en la pantalla... ¡ZAS!
                      if (fechasPagadas.includes(fechaStr)) {
                          shBD1.getRange(i + 1, idxComisionPagada + 1).setValue(idPago);
                      }
                  }
              }
          }
      }
  }

  return { status: 'success', message: 'Comisiones pagadas. ID: ' + idPago };
}


// =======================================================
// 3. LOGICA DE CLIENTES Y PRECIOS
// =======================================================


function obtenerClientes() {
  const libro = SpreadsheetApp.getActiveSpreadsheet();
  const hoja  = libro.getSheetByName('CLIENTES');
  if (!hoja) throw new Error('No se encontró la hoja CLIENTES');

  const datos = hoja.getDataRange().getValues();
  if (datos.length < 2) return [];

  const headers = datos[0].map(h => String(h||'').trim().toUpperCase());
  const idx = (nameList)=> {
    for (const name of nameList) {
      const j = headers.indexOf(name);
      if (j !== -1) return j;
    }
    return -1;
  };

  const iId      = idx(['ID_CLIENTE', 'ID']);
  const iCuit    = idx(['CUIT_DNI', 'CUIT', 'DNI']);
  const iNombre  = idx(['NOMBRE','NOMBRE DEL COMERCIO','COMERCIO']);
  const iZona    = idx(['ZONA']);
  const iTipo    = idx(['TIPO','CATEGORIA','CATEGORÍA']);
  const iTel     = idx(['TELEFONO','TELÉFONO']);
  const iDir     = idx(['DIRECCION','DIRECCIÓN']);
  const iMail    = idx(['MAIL','EMAIL','CORREO']);
  const iCodigo  = idx(['CODIGO','CÓDIGO']); 
  
  // NUEVAS COLUMNAS
  const iPEsp10     = idx(['P_ESP_10']);
  const iPEsp15     = idx(['P_ESP_15']);
  const iPEsp45     = idx(['P_ESP_45']);
  const iPEspEnv10  = idx(['P_ESP_ENV_10']);
  const iPEspEnv15  = idx(['P_ESP_ENV_15']);
  const iPEspEnv45  = idx(['P_ESP_ENV_45']);
  const iVenc       = idx(['VENCIMIENTO']);
  
  // EL RADAR: Agregamos la columna de GPS
  const iCoord      = idx(['COORDENADAS', 'UBICACION', 'GPS']); 

  const clientes = [];
  for (let i = 1; i < datos.length; i++) {
    const f = datos[i];
    const nombre = iNombre>-1 ? String(f[iNombre]||'').trim() : '';
    if (!nombre) continue;

    // Formateo de fecha si existe
    let venc = iVenc > -1 ? f[iVenc] : '';
    if (venc instanceof Date) {
        venc = Utilities.formatDate(venc, Session.getScriptTimeZone(), "dd/MM/yyyy");
    }

    clientes.push({
      id_cliente:   iId>-1 ? String(f[iId]||'').trim() : '',
      cuit_dni:     iCuit>-1 ? String(f[iCuit]||'').trim() : '',
      nombre:       nombre,
      zona:         iZona>-1 ? String(f[iZona]||'').trim() : '',
      categoria:    normalizarCategoria(iTipo>-1 ? f[iTipo] : ''),
      telefono:     iTel>-1 ? String(f[iTel]||'').trim() : '',   
      direccion:    iDir>-1 ? String(f[iDir]||'').trim() : '',   
      codigo:       iCodigo>-1 ? String(f[iCodigo]||'').trim() : '',
      mail:         iMail>-1 ? String(f[iMail]||'').trim() : '',
      // NUEVOS DATOS PARA EL FORMULARIO
      p_esp_10:     iPEsp10 > -1 ? f[iPEsp10] : '',
      p_esp_15:     iPEsp15 > -1 ? f[iPEsp15] : '',
      p_esp_45:     iPEsp45 > -1 ? f[iPEsp45] : '',
      p_esp_env_10: iPEspEnv10 > -1 ? f[iPEspEnv10] : '',
      p_esp_env_15: iPEspEnv15 > -1 ? f[iPEspEnv15] : '',
      p_esp_env_45: iPEspEnv45 > -1 ? f[iPEspEnv45] : '',
      vencimiento:  venc,
      ubicacion:    iCoord > -1 ? String(f[iCoord]||'').trim() : '' // Pasamos la coordenada cruda al frontend
    });
  }
  return clientes;
}

function obtenerPrecios() {
  const libro = SpreadsheetApp.getActiveSpreadsheet();
  const hoja  = libro.getSheetByName('PRECIOS');
  if (!hoja) throw new Error('No se encontró la hoja PRECIOS');

  const data = hoja.getDataRange().getValues();
  if (data.length < 2) return [];

  const headers = data[0].map(v => String(v || '').toUpperCase().trim());
  const idxCat    = headers.indexOf('CATEGORIA');
  const idxTipo   = headers.indexOf('TIPO');
  const idxPrecio = headers.indexOf('PRECIO');
  
  if (idxCat === -1 || idxTipo === -1 || idxPrecio === -1) {
    throw new Error('La hoja PRECIOS debe tener columnas CATEGORIA, TIPO y PRECIO');
  }

  const out = [];
  for (let i = 1; i < data.length; i++) {
    const categoriaRaw = data[i][idxCat];
    const tipoRaw      = data[i][idxTipo];
    const precioRaw    = data[i][idxPrecio];
    const comisionRaw  = data[i][4]; // Columna E (índice 4)

    const categoria = normalizarCategoria(categoriaRaw);
    let tipo        = String(tipoRaw || '').toUpperCase().trim(); 
    
    // Alerta ajena: esto limpia cualquier letra y deja solo los números si no arranca con ENV. 
    if (!tipo.startsWith('ENV')) tipo = tipo.replace(/[^\d]/g, '');

    const precio = Number(precioRaw);
    if (categoria && tipo && !Number.isNaN(precio)) {
      // 1. Metemos el precio normal (carga o envase)
      out.push({ categoria, tipo, precio });

      // 2. INYECCIÓN FANTASMA: Comisión
      const comision = Number(comisionRaw);
      if (!tipo.startsWith('ENV') && comisionRaw !== '' && !Number.isNaN(comision)) {
        out.push({ categoria, tipo: 'COM' + tipo, precio: comision });
      }
    }
  }

  // --- INYECCIÓN NUEVA: LECTURA DEL RECARGO DE FLOTANTES EN HOJA 'DATOS' ---
  try {
    const hojaDatos = libro.getSheetByName('DATOS');
    if (hojaDatos) {
       const datosData = hojaDatos.getDataRange().getValues();
       if (datosData.length > 1) {
         const headersDatos = datosData[0].map(v => String(v).toUpperCase().trim());
         const idxRecargo = headersDatos.indexOf('RECARGO_DOMICILIO_FLOTANTE');
         if (idxRecargo > -1) {
             const recargoVal = Number(datosData[1][idxRecargo]) || 0;
             // Lo inyectamos como si fuera un producto más del sistema
             out.push({ categoria: 'SISTEMA', tipo: 'RECARGO_FLOTANTE', precio: recargoVal });
         }
       }
    }
  } catch(err) {
     Logger.log("No se pudo leer el recargo: " + err);
  }
  // -------------------------------------------------------------------------

  return out;
}

function listPrecios() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('PRECIOS');
    if (!sheet) return { status: 'error', message: 'No existe hoja PRECIOS' };
    
    const data = sheet.getDataRange().getValues();
    const preciosMap = new Map();
    
    // Lectura Inversa: De abajo hacia arriba. Atrapa el último precio cargado.
    for (let i = data.length - 1; i > 0; i--) {
      const cat = String(data[i][0]).trim().toUpperCase();
      const tipo = String(data[i][1]).trim().toUpperCase();
      const precio = Number(data[i][2]) || 0;
      
      if (!cat || !tipo) continue;
      
      const key = `${cat}_|_${tipo}`;
      if (!preciosMap.has(key)) {
        preciosMap.set(key, { categoria: cat, tipo: tipo, precio: precio });
      }
    }

    // ---> INYECCIÓN: LEER RECARGO FLOTANTE DESDE "DATOS" <---
    const shDatos = ss.getSheetByName('DATOS');
    if (shDatos) {
       const recargo = Number(shDatos.getRange(2, 8).getValue()) || 0; // Celda H2
       preciosMap.set('SISTEMA_|_RECARGO_FLOTANTE', { 
         categoria: 'SISTEMA', 
         tipo: 'RECARGO_FLOTANTE', 
         precio: recargo 
       });
    }
    
    return { status: 'success', precios: Array.from(preciosMap.values()) };
  } catch (e) {
    return { status: 'error', message: e.toString() };
  }
}


// =========================================================================
// NUEVO MOTOR ÚNICO DE CUENTAS CORRIENTES
// =========================================================================


function actualizarCuentaCorrienteUnificada(params, idCliente, nombreCliente, usuario, fecha, hora, idViaje, idTurno) {
  const n = (val) => Number(val) || 0;
  
  // Atrapamos los netos calculados en el frontend
  const neto10 = n(params.MOV_NETO_10);
  const neto15 = n(params.MOV_NETO_15);
  const neto45 = n(params.MOV_NETO_45);
  const netoDinero = n(params.MOV_NETO_DINERO);

  // Si la operación no generó movimiento neto de deuda/saldos, abortamos acá para no escribir filas en blanco.
  if (neto10 === 0 && neto15 === 0 && neto45 === 0 && netoDinero === 0) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let shSaldos = ss.getSheetByName('SALDOS_FLOTANTES');
  let shHist = ss.getSheetByName('HISTORIAL_FLOTANTES');

  // Si por alguna razón borraste las hojas, el script las crea solas para no romperse
  if (!shSaldos) {
      shSaldos = ss.insertSheet('SALDOS_FLOTANTES');
      shSaldos.appendRow(['ID_CLIENTE', 'CLIENTE_NOMBRE', 'SALDO_10', 'SALDO_15', 'SALDO_45', 'SALDO_DINERO', 'ULTIMA_ACTUALIZACION']);
  }
  if (!shHist) {
      shHist = ss.insertSheet('HISTORIAL_FLOTANTES');
      shHist.appendRow(['ID_TRANSACCION', 'FECHA', 'HORA', 'USUARIO', 'ID_CLIENTE', 'CLIENTE_NOMBRE', 'TIPO_MOV', 'MOV_ENV_10', 'MOV_ENV_15', 'MOV_ENV_45', 'MOV_DINERO', 'NOTAS']);
  }

  if (!idTurno) { try { idTurno = getTurnoAbierto(); } catch(e) { idTurno = ''; } }

  const data = shSaldos.getDataRange().getValues();
  const hS = data[0].map(x => String(x).trim().toUpperCase());
  
  const iId = hS.indexOf('ID_CLIENTE');
  const iCli = hS.indexOf('CLIENTE_NOMBRE');
  const i10 = hS.indexOf('SALDO_10');
  const i15 = hS.indexOf('SALDO_15');
  const i45 = hS.indexOf('SALDO_45');
  const iDin = hS.indexOf('SALDO_DINERO');
  const iUlt = hS.indexOf('ULTIMA_ACTUALIZACION');

  let filaEncontrada = -1;
  // Arrancamos el cálculo con el movimiento neto que viene de app.js
  let saldo10 = neto10, saldo15 = neto15, saldo45 = neto45, saldoDinero = netoDinero;

  // 1. BUSCAR Y SUMAR/RESTAR (La Foto Actualizada)
  for (let i = 1; i < data.length; i++) {
      const rowId = iId > -1 ? String(data[i][iId]).trim() : '';
      const rowCli = iCli > -1 ? String(data[i][iCli]).trim() : '';
      
      // Flexibilidad: busca por ID. Si no hay ID (cliente manual), busca por Nombre.
      if ((idCliente !== '' && rowId === String(idCliente).trim()) || 
          (idCliente === '' && rowCli === String(nombreCliente).trim())) {
          filaEncontrada = i + 1;
          saldo10 += n(data[i][i10]);
          saldo15 += n(data[i][i15]);
          saldo45 += n(data[i][i45]);
          saldoDinero += (parseFloat(String(data[i][iDin]).replace(/[^\d.-]/g, '')) || 0);
          break;
      }
  }

  const fechaHora = fecha + ' ' + hora;

  if (filaEncontrada > -1) {
      // Si el cliente pagó todo y devolvió todo (salida = 0), limpiamos la fila para no juntar basura
      if (saldo10 === 0 && saldo15 === 0 && saldo45 === 0 && saldoDinero === 0) {
          shSaldos.deleteRow(filaEncontrada);
      } else {
          // Actualizamos la celda pisando el valor viejo con el nuevo cálculo
          if (i10 > -1) shSaldos.getRange(filaEncontrada, i10 + 1).setValue(saldo10);
          if (i15 > -1) shSaldos.getRange(filaEncontrada, i15 + 1).setValue(saldo15);
          if (i45 > -1) shSaldos.getRange(filaEncontrada, i45 + 1).setValue(saldo45);
          if (iDin > -1) shSaldos.getRange(filaEncontrada, iDin + 1).setValue(saldoDinero);
          if (iUlt > -1) shSaldos.getRange(filaEncontrada, iUlt + 1).setValue(fechaHora);
      }
  } else {
      // Cliente nuevo en la cuenta corriente
      const nuevaFila = new Array(hS.length).fill('');
      if (iId > -1) nuevaFila[iId] = idCliente;
      if (iCli > -1) nuevaFila[iCli] = nombreCliente;
      if (i10 > -1) nuevaFila[i10] = saldo10;
      if (i15 > -1) nuevaFila[i15] = saldo15;
      if (i45 > -1) nuevaFila[i45] = saldo45;
      if (iDin > -1) nuevaFila[iDin] = saldoDinero;
      if (iUlt > -1) nuevaFila[iUlt] = fechaHora;
      shSaldos.appendRow(nuevaFila);
  }

  // 2. ESCRIBIR LA AUDITORÍA (La Película)
  let tipoMov = "MOV_CTA_CTE";
  if (params.esPagoDeuda === 'true' || params.esPagoDeuda === true) tipoMov = "COBRO/DEVOLUCION";
  else if (params.operacionEnvase === 'comodato') tipoMov = "COMODATO";
  else if (params.operacionEnvase === 'consignacion') tipoMov = "CONSIGNACION";
  else if (String(params.esFlotante).toLowerCase() === 'true') tipoMov = "FLOTANTE";

  const idTransaccion = 'CC-' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd-HHmmss');
  const notas = `Ref Op: ${params.N || 'S/N'} | Viaje: ${idViaje || ''} | Turno: ${idTurno || ''}`;

  shHist.appendRow([idTransaccion, fecha, hora, usuario, idCliente, nombreCliente, tipoMov, neto10, neto15, neto45, netoDinero, notas]);
}

// =======================================================
// 4. LOGICA DE REGISTRO EN BD1
// =======================================================


function procesarRegistro(params) {
  try {
    if (params.pin && String(params.pin).trim() !== '') {
        const accion = "AUTORIZACION " + (params.TIPO || "OPERACION");
        const pinValido = validarYRotarPin(params.USUARIO, params.pin, accion);
        if (!pinValido) {
            return { status: 'error', message: 'ERROR_PIN_INCORRECTO' };
        }
    }
    
    const idTurno = getTurnoAbierto();
    const libro = SpreadsheetApp.getActiveSpreadsheet();
    const hoja = libro.getSheetByName('BD1') || libro.insertSheet('BD1');
    const hojaFinanzas = libro.getSheetByName('MOVIMIENTOS_FINANZAS');

    let encabezadosFila2 = [];
    try {
        const lc = hoja.getLastColumn();
        if (lc > 0) {
            encabezadosFila2 = hoja.getRange(2, 1, 1, lc).getValues()[0];
        }
    } catch (e) {
        Logger.log("⚠️ Error pre-leyendo encabezados: " + e.toString());
    }

    let costos = { cu10: 0, cu15: 0, cu45: 0 };
    const cacheStr = CacheService.getScriptCache().get('COSTOS_ACTUALES');
    
    if (cacheStr) {
      costos = JSON.parse(cacheStr);
    } else {
      costos = actualizarCacheCostos();
    }
    
    const cu10 = costos.cu10;
    const cu15 = costos.cu15;
    const cu45 = costos.cu45;

    let ultimaFilaActual = hoja.getLastRow();
    if (ultimaFilaActual < 2) {
        crearEncabezadosHojaPrincipal(hoja);
    }

    if (params.esClienteNuevo === 'true') agregarNuevoCliente(params);

    const idViajeActual = obtenerViajeActivo(params.USUARIO);
    const idClienteActual = params.ID_CLIENTE || ''; 

    const n = (val) => { if (!val) return 0; if (typeof val === 'string') return parseFloat(val) || 0; return Number(val) || 0; };
    const catCliente = params.clienteCategoria || 'S/Cat';
    const nomCliente = params.C || params.nombreCliente || params.clienteNombre || 'S/Nombre';
    const infoCliente = `[${nomCliente}] [${catCliente}]`;

    if (params.esClienteNuevo === 'true') { 
        registrarAlarma('NUEVO_CLIENTE', `Alta de cliente: ${infoCliente} en zona ${params.clienteZona}`, params.USUARIO); 
    }

    const ahoraFecha = params.FECHA || Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy');
    const ahoraHora = params.HORA || Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'HH:mm:ss');
    const ahoraFechaHora = ahoraFecha + ' ' + ahoraHora;

    const isPago = (params.esPagoDeuda === 'true' || params.esPagoDeuda === true);
    const isFlotanteOp = String(params.esFlotante).toLowerCase() === 'true';

    actualizarCuentaCorrienteUnificada(params, idClienteActual, nomCliente, params.USUARIO, ahoraFecha, ahoraHora, idViajeActual, idTurno);

    const usuario = params.USUARIO || 'Sistema';
    const totalVenta = n(params['VS10$']) + n(params['VS15$']) + n(params['VS45$']) + n(params['VC10$']) + n(params['VC15$']) + n(params['VC45$']) + n(params['VRP10$']) + n(params['VRP15$']) + n(params['VRP45$']) + n(params['VU10$']) + n(params['VU15$']) + n(params['VU45$']) + n(params['CE10$']) + n(params['CE15$']) + n(params['CE45$']);
    const cobroDeuda = isPago ? n(params.pagoDeudaDinero) : 0;
    
    const linkGPS = (params.UBICACION && !params.UBICACION.includes("SIN_GPS")) ? `http://googleusercontent.com/maps.google.com/?q=${params.UBICACION}` : (params.UBICACION || "SIN_GPS");

    const pagoEfectivo = n(params['E$']);
    const pagoTransf = n(params['T$']);

    let comisionCalculada = n(params.COMISION_TOTAL);
    if (comisionCalculada === 0 && (totalVenta > 0)) {
       try {
         const listaRangos = obtenerRangosComision();
         let bultosArr = [];
         if (params.garrafas) {
           bultosArr = JSON.parse(params.garrafas);
         }
         bultosArr.forEach(g => {
           const pUnitario = n(g.precio);
           const cantidadBultos = n(g.cantidad);
           const tEnvase = String(g.tipo); 
           
           const rangoMatch = listaRangos.find(r => pUnitario >= n(r.RANGO_MENOR) && pUnitario <= n(r.RANGO_MAYOR));
           if (rangoMatch) {
             const factorComision = n(rangoMatch["COMISION_" + tEnvase]);
             comisionCalculada += (cantidadBultos * factorComision);
           }
         });
       } catch (errComes) {
         Logger.log("⚠️ Error en re-cálculo de comisiones por rango: " + errComes.toString());
       }
    }

    const dev10 = n(params.dev10);
    const dev15 = n(params.dev15);
    const dev45 = n(params.dev45);
    const hayRecupero = (dev10 > 0 || dev15 > 0 || dev45 > 0);
    
    let cashDisponible = pagoEfectivo;
    let transfDisponible = pagoTransf;

    const grabarEnBD1 = (objVenta, anotarFinanzas, tipoFinanzasOverride) => {
        let filaParaInsertar;
        try {
            if (encabezadosFila2.length > 0 && (encabezadosFila2.indexOf("COMISION") !== -1 || encabezadosFila2.indexOf("USUARIO") !== -1)) {
                filaParaInsertar = encabezadosFila2.map(titulo => {
                    const claveElemento = titulo.toString().trim();
                    return objVenta[claveElemento] !== undefined ? objVenta[claveElemento] : "";
                });
            } else {
                filaParaInsertar = convertirObjetoAFila(objVenta);
            }
        } catch (errFila) {
            filaParaInsertar = convertirObjetoAFila(objVenta);
        }
        hoja.appendRow(filaParaInsertar);

        if (anotarFinanzas && (n(objVenta['E$']) > 0 || n(objVenta['T$']) > 0 || n(objVenta.TOTAL) > 0)) {
            const ePesos = n(objVenta['E$']);
            const tPesos = n(objVenta['T$']);
            const estadoTransf = tPesos > 0 ? "PENDIENTE" : "N/A";
            const estadoArqueo = ePesos > 0 ? "PENDIENTE" : "N/A";
            
            if (hojaFinanzas) {
                hojaFinanzas.appendRow([
                    params.N,
                    ahoraFechaHora,
                    tipoFinanzasOverride,
                    idTurno,
                    idViajeActual,
                    nomCliente + (tipoFinanzasOverride === 'COBRO_DEUDA' ? ' (COBRO DEUDA)' : ''),
                    n(objVenta.TOTAL),
                    ePesos,
                    tPesos,
                    usuario,
                    estadoTransf,
                    "", "", estadoArqueo, "", "", ""
                ]);
            } else {
                Logger.log("⚠️ ERROR: No se encontró la hoja MOVIMIENTOS_FINANZAS.");
            }
        }
    };

    if (hayRecupero) {
        const dataRecupero = {
            USUARIO: usuario, TIPO: 'RECUPERO', 
            FECHA: ahoraFecha, HORA: ahoraHora, C: params.C || '', N: params.N || '', 
            'E$': 0, 'T$': 0, TOTAL: 0, G: params.G || 'Recupero de envases prestados',
            ALL10: 0, ALL15: 0, ALL45: 0,
            AV10: dev10, AV15: dev15, AV45: dev45, 
            CE10: 0, 'CE10$': 0, CE15: 0, 'CE15$': 0, CE45: 0, 'CE45$': 0,
            VS10: 0, 'VS10$': 0, VS15: 0, 'VS15$': 0, VS45: 0, 'VS45$': 0,
            VC10: 0, 'VC10$': 0, VC15: 0, 'VC15$': 0, VC45: 0, 'VC45$': 0,
            VRP10: 0, 'VRP10$': 0, VRP15: 0, 'VRP15$': 0, VRP45: 0, 'VRP45$': 0,
            VU10: 0, 'VU10$': 0, VU15: 0, 'VU15$': 0, VU45: 0, 'VU45$': 0,
            ID_CLIENTE: idClienteActual, ID_VIAJE: idViajeActual, UBICACION: linkGPS, PUNTO_GPS: params.PUNTO_GPS || '',
            ID_TURNO: idTurno, CU10: cu10, CU15: cu15, CU45: cu45, COMISION: 0, AUDIO: params.AUDIO_URL ? `${params.AUDIO_URL}` : ""
        };
        grabarEnBD1(dataRecupero, false, "N/A");
        
        let detRec = [];
        if (dev10 > 0) detRec.push(`10kg: ${dev10}`);
        if (dev15 > 0) detRec.push(`15kg: ${dev15}`);
        if (dev45 > 0) detRec.push(`45kg: ${dev45}`);
        let strRec = detRec.length > 0 ? ` [Cant: ${detRec.join(' | ')}]` : '';
        
        registrarAlarma('RECUPERO', `Recupero de envases vacíos de ${infoCliente}${strRec}`, usuario);
    }

    if (cobroDeuda > 0) {
        let cashParaDeuda = Math.min(cashDisponible, cobroDeuda);
        cashDisponible -= cashParaDeuda;
        let transfParaDeuda = Math.min(transfDisponible, cobroDeuda - cashParaDeuda);
        transfDisponible -= transfParaDeuda;

        const dataVentaPago = {
            USUARIO: usuario, TIPO: 'VENTA_PAGO', 
            FECHA: ahoraFecha, HORA: ahoraHora, C: params.C || '', N: params.N || '', 
            'E$': cashParaDeuda, 'T$': transfParaDeuda, TOTAL: cobroDeuda, G: params.G || 'Cobro de cuenta corriente / Saldo a Favor',
            ALL10: 0, ALL15: 0, ALL45: 0, AV10: 0, AV15: 0, AV45: 0,
            CE10: 0, 'CE10$': 0, CE15: 0, 'CE15$': 0, CE45: 0, 'CE45$': 0,
            VS10: 0, 'VS10$': 0, VS15: 0, 'VS15$': 0, VS45: 0, 'VS45$': 0,
            VC10: 0, 'VC10$': 0, VC15: 0, 'VC15$': 0, VC45: 0, 'VC45$': 0,
            VRP10: 0, 'VRP10$': 0, VRP15: 0, 'VRP15$': 0, VRP45: 0, 'VRP45$': 0,
            VU10: 0, 'VU10$': 0, VU15: 0, 'VU15$': 0, VU45: 0, 'VU45$': 0,
            ID_CLIENTE: idClienteActual, ID_VIAJE: idViajeActual, UBICACION: linkGPS, PUNTO_GPS: params.PUNTO_GPS || '',
            ID_TURNO: idTurno, CU10: 0, CU15: 0, CU45: 0, COMISION: 0, AUDIO: params.AUDIO_URL ? `${params.AUDIO_URL}` : ""
        };
        grabarEnBD1(dataVentaPago, true, "COBRO_DEUDA");
        registrarAlarma('COBRO_DEUDA', `Cobro de deuda por $${cobroDeuda} de ${infoCliente}`, usuario);
    }

    let esOperacionPrincipal = false;
    if (totalVenta > 0 || isFlotanteOp || n(params.ALL10) > 0 || n(params.ALL15) > 0 || n(params.ALL45) > 0) {
        esOperacionPrincipal = true;
    } else {
        if (n(params.AV10) > 0 || n(params.AV15) > 0 || n(params.AV45) > 0) {
            esOperacionPrincipal = true;
        } else if (params.TIPO && params.TIPO !== 'VENTA' && params.TIPO !== 'COBRO DEUDA') {
             esOperacionPrincipal = true; 
        }
    }

    if (esOperacionPrincipal) {
        let tipoOperacion = params.TIPO || 'VENTA';
        if (tipoOperacion === 'COBRO DEUDA') tipoOperacion = 'VENTA'; 

        const dataPrincipal = {
            USUARIO: usuario, TIPO: tipoOperacion, 
            FECHA: ahoraFecha, HORA: ahoraHora, C: params.C || '', N: params.N || '', 
            'E$': cashDisponible, 'T$': transfDisponible, TOTAL: totalVenta, G: params.G || '',
            ALL10: n(params.ALL10), ALL15: n(params.ALL15), ALL45: n(params.ALL45),
            AV10: n(params.AV10), AV15: n(params.AV15), AV45: n(params.AV45),
            CE10: n(params.CE10), 'CE10$': n(params['CE10$']), CE15: n(params.CE15), 'CE15$': n(params['CE15$']), CE45: n(params.CE45), 'CE45$': n(params['CE45$']),
            VS10: n(params.VS10), 'VS10$': n(params['VS10$']), VS15: n(params.VS15), 'VS15$': n(params['VS15$']), VS45: n(params.VS45), 'VS45$': n(params['VS45$']),
            VC10: n(params.VC10), 'VC10$': n(params['VC10$']), VC15: n(params.VC15), 'VC15$': n(params['VC15$']), VC45: n(params.VC45), 'VC45$': n(params['VC45$']),
            VRP10: n(params.VRP10), 'VRP10$': n(params['VRP10$']), VRP15: n(params.VRP15), 'VRP15$': n(params['VRP15$']), VRP45: n(params.VRP45), 'VRP45$': n(params['VRP45$']),
            VU10: n(params.VU10), 'VU10$': n(params['VU10$']), VU15: n(params.VU15), 'VU15$': n(params['VU15$']), VU45: n(params.VU45), 'VU45$': n(params['VU45$']),
            ID_CLIENTE: idClienteActual, ID_VIAJE: idViajeActual, UBICACION: linkGPS, PUNTO_GPS: params.PUNTO_GPS || '',
            ID_TURNO: idTurno,
            CU10: cu10, CU15: cu15, CU45: cu45,
            COMISION: comisionCalculada, 
            AUDIO: params.AUDIO_URL ? `${params.AUDIO_URL}` : ""
        };
        grabarEnBD1(dataPrincipal, true, "VENTA");
        
        const tOp = String(params.TIPO).toUpperCase();
        if (tOp === 'COMODATO' || tOp === 'CONSIGNACION' || tOp === 'VENTA_ENVASE') {
            let detEnv = [];
            if (n(params.ALL10) > 0) detEnv.push(`10kg: ${n(params.ALL10)}`);
            if (n(params.ALL15) > 0) detEnv.push(`15kg: ${n(params.ALL15)}`);
            if (n(params.ALL45) > 0) detEnv.push(`45kg: ${n(params.ALL45)}`);
            let strEnv = detEnv.length > 0 ? ` [Cant: ${detEnv.join(' | ')}]` : '';
            
            registrarAlarma('MOVIMIENTO_ENVASE', `Operación de ${tOp} con ${infoCliente}${strEnv}`, usuario);
        } else if (tOp === 'FLOTANTE') {
            let strFlot = `[Bajan llenos: 10kg(${n(params.ALL10)}) 15kg(${n(params.ALL15)}) 45kg(${n(params.ALL45)}) | Suben vacíos: 10kg(${n(params.AV10)}) 15kg(${n(params.AV15)}) 45kg(${n(params.AV45)})]`;
            registrarAlarma('FLOTANTE', `Registro de camión flotante en ${infoCliente} ${strFlot}`, usuario);
        }
    }

    if (String(params.declaracionGastos).trim().toLowerCase() === 'true' && n(params.GASTO_TOTAL) > 0) {
      const gastoMonto = n(params.GASTO_TOTAL);
      const dataGasto = {
        USUARIO: usuario, TIPO: 'GASTO', FECHA: ahoraFecha, HORA: ahoraHora, C: '-', N: '', 
        'E$': -gastoMonto, 
        'T$': 0, 
        TOTAL: -gastoMonto, 
        G: params.G || 'Gasto vario',
        ALL10: 0, ALL15: 0, ALL45: 0, AV10: 0, AV15: 0, AV45: 0, CE10: 0, 'CE10$': 0, CE15: 0, 'CE15$': 0, CE45: 0, 'CE45$': 0,
        VS10: 0, 'VS10$': 0, VS15: 0, 'VS15$': 0, VS45: 0, 'VS45$': 0, VC10: 0, 'VC10$': 0, VC15: 0, 'VC15$': 0, VC45: 0, 'VC45$': 0,
        VRP10: 0, 'VRP10$': 0, VRP15: 0, 'VRP15$': 0, VRP45: 0, 'VRP45$': 0, VU10: 0, 'VU10$': 0, VU15: 0, 'VU15$': 0, VU45: 0, 'VU45$': 0,
        ID_CLIENTE: idClienteActual, ID_VIAJE: idViajeActual, UBICACION: linkGPS, PUNTO_GPS: params.PUNTO_GPS || '',
        ID_TURNO: idTurno,
        CU10: 0, CU15: 0, CU45: 0, 
        COMISION: 0, 
        AUDIO: params.AUDIO_URL ? `=HIPERVINCULO("${params.AUDIO_URL}"; "▶️ ESCUCHAR")` : ""
      };

      let filaGastoParaInsertar;
      try {
        if (encabezadosFila2.length > 0 && (encabezadosFila2.indexOf("COMISION") !== -1 || encabezadosFila2.indexOf("USUARIO") !== -1)) {
          filaGastoParaInsertar = encabezadosFila2.map(titulo => {
            const claveElemento = titulo.toString().trim();
            return dataGasto[claveElemento] !== undefined ? dataGasto[claveElemento] : "";
          });
        } else {
          filaGastoParaInsertar = convertirObjetoAFila(dataGasto);
        }
      } catch (errGasto) {
        filaGastoParaInsertar = convertirObjetoAFila(dataGasto);
      }

      hoja.appendRow(filaGastoParaInsertar);

      if (hojaFinanzas) {
        hojaFinanzas.appendRow([
          "G-" + Utilities.getUuid().split('-')[0].toUpperCase(), 
          ahoraFechaHora,       
          "GASTO",              
          idTurno,              
          idViajeActual,        
          "GASTO: " + (params.G || 'Gasto vario'), 
          -gastoMonto,          
          -gastoMonto,          
          0,                    
          usuario,              
          "N/A",                
          "",                   
          "",                   
          "PENDIENTE",          
          "",                   
          "",                   
          ""                    
        ]);
      }
    }

    try {
      if (params.esClienteNuevo === 'true') {
        marcarActualizacion('TS_CLIENTES');
      }
      marcarActualizacion('TS_SALDOS');
      // ---> ACÁ ROMPEMOS LA CACHÉ PARA QUE AL VOLVER A CARGAR ESTÉ TODO FRESCO <---
      CacheService.getScriptCache().remove('INIT_APP_DATA'); 
    } catch(errTs) {
      Logger.log("⚠️ Fallo al actualizar Timestamps: " + errTs.toString());
    }

    return { status: 'success', message: 'Registro procesado correctamente' };
  } catch (error) { return { status: 'error', message: 'ERROR CRÍTICO: ' + error.toString() }; }
}

function obtenerRangosComision() {
  try {
    const libro = SpreadsheetApp.getActiveSpreadsheet();
    const hoja = libro.getSheetByName('RANGOS_COMISION');
    if (!hoja) return [];
    
    const valores = hoja.getDataRange().getValues();
    if (valores.length < 2) return [];
    
    const headers = valores[0].map(h => String(h).trim().toUpperCase());
    const idxRangoMenor = headers.indexOf('RANGO_MENOR');
    const idxRangoMayor = headers.indexOf('RANGO_MAYOR');
    const idxCom10 = headers.indexOf('COMISION_10');
    const idxCom15 = headers.indexOf('COMISION_15');
    const idxCom45 = headers.indexOf('COMISION_45');
    
    const rangos = [];
    for (let i = 1; i < valores.length; i++) {
      const fila = valores[i];
      rangos.push({
        RANGO_MENOR: fila[idxRangoMenor] !== undefined ? fila[idxRangoMenor] : 0,
        RANGO_MAYOR: fila[idxRangoMayor] !== undefined ? fila[idxRangoMayor] : 999999,
        COMISION_10: fila[idxCom10] !== undefined ? fila[idxCom10] : 0,
        COMISION_15: fila[idxCom15] !== undefined ? fila[idxCom15] : 0,
        COMISION_45: fila[idxCom45] !== undefined ? fila[idxCom45] : 0
      });
    }
    return rangos;
  } catch (e) {
    Logger.log("Error en obtenerRangosComision: " + e.toString());
    return [];
  }
}

function crearEncabezadosHojaPrincipal(hoja) {
  const encabezados = [
    'USUARIO','TIPO','FECHA','HORA','C','N','E$','T$','TOTAL','G',
    'ALL10','ALL15','ALL45','AV10','AV15','AV45',
    'CE10','CE10$','CE15','CE15$','CE45','CE45$',
    'VS10','VS10$','VS15','VS15$','VS45','VS45$',
    'VC10','VC10$','VC15','VC15$','VC45','VC45$',
    'VRP10','VRP10$','VRP15','VRP15$','VRP45','VRP45$',
    'VU10','VU10$','VU15','VU15$','VU45','VU45$',
    'ID_CLIENTE','ID_VIAJE','ARQUEO_ID','VERIFICADO_BANCO','DETALLE_BANCO','UBICACION'
  ];
  hoja.appendRow(encabezados);
}

function convertirObjetoAFila(obj) {
  const orden = [
    'USUARIO','TIPO','FECHA','HORA','C','N','E$','T$','TOTAL','G',
    'ALL10','ALL15','ALL45','AV10','AV15','AV45',
    'CE10','CE10$','CE15','CE15$','CE45','CE45$',
    'VS10','VS10$','VS15','VS15$','VS45','VS45$',
    'VC10','VC10$','VC15','VC15$','VC45','VC45$',
    'VRP10','VRP10$','VRP15','VRP15$','VRP45','VRP45$',
    'VU10','VU10$','VU15','VU15$','VU45','VU45$',
    'ID_CLIENTE','ID_VIAJE','ARQUEO_ID','VERIFICADO_BANCO','DETALLE_BANCO','UBICACION',
    'ID_TURNO', 'CU10', 'CU15', 'CU45' 
  ];
  return orden.map(k => obj[k] !== undefined ? obj[k] : "");
}

function normalizarCategoria(c) {
  let s = String(c || '').trim().toUpperCase();
  s = s.replace('USUARIO (PÚBLICO)', 'USUARIO (PUBLICO)');
  
  if (s.includes('ROT. Y PAN') || s.includes('ROT.Y PAN')) {
    s = 'ROT. Y PAN.';
  }
  
  return s;
}

function obtenerTipoVenta(categoria) {
  const tipos = {
    'SUBDISTRIBUIDOR': 'VS',
    'COMERCIO': 'VC',
    'ROT. Y PAN.': 'VRP',
    'USUARIO (PUBLICO)': 'VU'
  };
  const key = normalizarCategoria(categoria);
  return tipos[key] || 'VU';
}

function determinarTipoOperacion(params) {
  if (params.declaracionGastos === 'true') return 'GASTOS';
  if (params.ventaEnvases === 'true')         return 'COMPRA';
  return 'VENTA';
}

function agregarNuevoCliente(params) {
  const ss   = SpreadsheetApp.getActiveSpreadsheet();
  const sh   = ss.getSheetByName('CLIENTES');
  if (!sh) return;

  const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0]
    .map(h => String(h || '').trim().toUpperCase());

  const colIndex = (...names) => {
    for (const n of names) {
      const i = headers.indexOf(n);
      if (i !== -1) return i + 1;  
    }
    return -1;
  };

  const nuevoId = 'CL-' + Math.random().toString(36).substring(2, 6).toUpperCase();
  params.ID_CLIENTE = nuevoId; 

  const nuevo = {
    id_cliente: nuevoId,
    cuit_dni:  params.cuit_dni         || params.clienteCuit        || '',
    nombre:    params.nombreCliente    || params.clienteNombre      || '',
    zona:      params.nuevaZona        || params.clienteZona        || '',
    categoria: normalizarCategoria(params.categoria || params.clienteCategoria || ''),
    telefono:  params.nuevoTelefono    || params.clienteTelefono  || '',
    direccion: params.nuevaDireccion   || params.clienteDireccion || '',
    mail:      params.mail             || params.clienteMail        || ''
  };

  const width  = sh.getLastColumn();
  const rowNum = sh.getLastRow() + 1;
  const rowArr = new Array(width).fill('');

  const put = (value, ...headerNames) => {
    const c = colIndex(...headerNames);
    if (c > 0) rowArr[c - 1] = value;
  };

  put(nuevo.id_cliente, 'ID_CLIENTE', 'ID');
  put(nuevo.cuit_dni,   'CUIT_DNI', 'CUIT', 'DNI');
  put(nuevo.nombre,     'NOMBRE', 'NOMBRE DEL COMERCIO', 'COMERCIO');
  put(nuevo.zona,       'ZONA');
  put(nuevo.categoria,  'TIPO', 'CATEGORIA', 'CATEGORÍA');
  put(nuevo.telefono,   'TELEFONO', 'TELÉFONO');
  put(nuevo.direccion,  'DIRECCION', 'DIRECCIÓN');
  put(nuevo.mail,       'MAIL', 'EMAIL', 'CORREO');

  sh.getRange(rowNum, 1, 1, width).setValues([rowArr]);
}

function _toIdx(h){ const m={}; h.forEach((x,i)=>{ const key=String(x||'').trim().toUpperCase(); if(m[key]===undefined){m[key]=i;} }); return m; }

function _val(r,i){ return i==null? '' : (r[i]||''); }

function listUsuarios(){
  const sh = SpreadsheetApp.getActive().getSheetByName('USUARIOS');
  if (!sh) return { status:'error', message:'No existe hoja USUARIOS' };

  const data = sh.getDataRange().getValues();
  if (data.length < 2) return { status:'success', usuarios: [] };

  const H = _toIdx(data[0]);
  const U = H['USUARIO'],
        P = H['PASSWORD'],
        NA= H['NOMBRE A MOSTRAR'],
        NC= H['NOMBRE COMPLETO'],
        DNI=H['DNI'],
        DOM=H['DOMICILIO'],
        EX =H['DATOS EXTRA'],
        AL =H['ALARMAS'],
        TB =H['TABLERO'],
        US =H['USUARIOS'],
        FO =H['FORMULARIO'],
        CL =H['CLIENTES'],
        PR =H['PRECIOS'],
        ST =H['STOCK'],
        GA =H['GASTOS'],
        CR =H['CARGA'],
        FI =H['FINANZAS'],
        CN =H['CONFINANZAS'],
        PD =H['PIN_DINAMICO'],
        FL =H['FLOTANTES'];


  const out = [];
  for (let i=1; i<data.length; i++){
    const r = data[i];
    const isEmpty = [_val(r,U),_val(r,P),_val(r,NA),_val(r,NC),_val(r,DNI),_val(r,DOM),_val(r,EX)].every(v => String(v).trim()==='');
    if (isEmpty) continue;

    out.push({
      usuario:        _val(r,U),
      password:       _val(r,P),
      nombreMostrar:  _val(r,NA),
      nombreCompleto: _val(r,NC),
      dni:            _val(r,DNI),
      domicilio:      _val(r,DOM),
      datosExtra:     _val(r,EX),
      alarmas:        _val(r,AL),
      tablero:        _val(r,TB),
      usuarios:       _val(r,US),
      formulario:     _val(r,FO),
      clientes:       _val(r,CL),
      precios:        _val(r,PR),
      stock:          _val(r,ST),
      gastos:         _val(r,GA),
      carga:          _val(r,CR),
      finanzas:       _val(r,FI),
      confinanzas:    _val(r,CN),
      pinDinamico:    _val(r,PD),
      flotantes:      _val(r,FL) 
    });
  }
  return { status:'success', usuarios: out };
}

function saveUsuarios(rowsJson){
  const sh = SpreadsheetApp.getActive().getSheetByName('USUARIOS');
  if (!sh) return {status:'error', message:'No existe hoja USUARIOS'};

  const rows = Array.isArray(rowsJson) ? rowsJson : JSON.parse(rowsJson || '[]');
  const MAX = 50;
  
  const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(h => String(h).trim().toUpperCase());
  const currentData = sh.getRange(2, 1, MAX, headers.length).getValues();

  const data = [];
  for (let i = 0; i < MAX; i++) {
    const r = rows[i] || {};
    let newRow = new Array(headers.length).fill('');
    
    headers.forEach((colName, colIndex) => {
        switch(colName) {
            case 'USUARIO': newRow[colIndex] = r.usuario || ''; break;
            case 'PASSWORD': newRow[colIndex] = r.password || ''; break;
            case 'NOMBRE A MOSTRAR': newRow[colIndex] = r.nombreMostrar || ''; break;
            case 'NOMBRE COMPLETO': newRow[colIndex] = r.nombreCompleto || ''; break;
            case 'DNI': newRow[colIndex] = r.dni || ''; break;
            case 'DOMICILIO': newRow[colIndex] = r.domicilio || ''; break;
            case 'DATOS EXTRA': newRow[colIndex] = r.datosExtra || ''; break;
            case 'ALARMAS': newRow[colIndex] = r.alarmas || '0'; break;
            case 'TABLERO': newRow[colIndex] = r.tablero || '0'; break;
            case 'USUARIOS': newRow[colIndex] = r.usuarios || '0'; break;
            case 'FORMULARIO': newRow[colIndex] = r.formulario || '0'; break;
            case 'CLIENTES': newRow[colIndex] = r.clientes || '0'; break;
            case 'PRECIOS': newRow[colIndex] = r.precios || '0'; break;
            case 'STOCK': newRow[colIndex] = r.stock || '0'; break;
            case 'GASTOS': newRow[colIndex] = r.gastos || '0'; break;
            case 'CARGA': newRow[colIndex] = r.carga || '0'; break;
            case 'FINANZAS': newRow[colIndex] = r.finanzas || '0'; break;
            case 'CONFINANZAS': newRow[colIndex] = r.confinanzas || '0'; break;
            case 'FLOTANTES': newRow[colIndex] = r.flotantes || '0'; break;
            case 'PIN_DINAMICO': newRow[colIndex] = r.pinDinamico || '0'; break;
            default: 
                newRow[colIndex] = currentData[i][colIndex] || '';
                break;
        }
    });
    data.push(newRow);
  }
  
  sh.getRange(2, 1, MAX, headers.length).setValues(data);
  return {status:'success'};
}

function listClientes(){
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName('CLIENTES');
  if (!sh) return {status:'error', message:'No existe hoja CLIENTES'};

  const datos = sh.getDataRange().getValues();
  if (datos.length < 2) return {status:'success', clientes:[]};

  const headers = datos[0].map(h => String(h||'').trim().toUpperCase());
  const findCol = (...names)=> {
    for (const n of names){
      const j = headers.indexOf(n);
      if (j !== -1) return j;
    }
    return -1;
  };

  const iId      = findCol('ID_CLIENTE', 'ID');
  const iCuit    = findCol('CUIT_DNI', 'CUIT', 'DNI');
  const iNombre  = findCol('NOMBRE','NOMBRE DEL COMERCIO','COMERCIO');
  const iZona    = findCol('ZONA');
  const iTipo    = findCol('TIPO','CATEGORIA','CATEGORÍA');
  const iTel     = findCol('TELEFONO','TELÉFONO');
  const iDir     = findCol('DIRECCION','DIRECCIÓN');
  const iMail    = findCol('MAIL','EMAIL','CORREO');
  
  const iPEsp10     = findCol('P_ESP_10');
  const iPEsp15     = findCol('P_ESP_15');
  const iPEsp45     = findCol('P_ESP_45');
  const iPEspEnv10  = findCol('P_ESP_ENV_10');
  const iPEspEnv15  = findCol('P_ESP_ENV_15');
  const iPEspEnv45  = findCol('P_ESP_ENV_45');
  const iVenc       = findCol('VENCIMIENTO');
  const iCoord      = findCol('COORDENADAS');

  const out = [];
  for (let i=1; i<datos.length; i++){
    const r = datos[i];
    const id     = iId > -1 ? String(r[iId]||'').trim() : '';
    const cuit   = iCuit > -1 ? String(r[iCuit]||'').trim() : '';
    const nombre = iNombre > -1 ? String(r[iNombre]||'').trim() : '';
    const zona   = iZona > -1 ? String(r[iZona]||'').trim() : '';
    const tipo   = iTipo > -1 ? String(r[iTipo]||'').trim() : '';
    const tel    = iTel > -1 ? String(r[iTel]||'').trim() : '';
    const dir    = iDir > -1 ? String(r[iDir]||'').trim() : '';
    const mail   = iMail > -1 ? String(r[iMail]||'').trim() : '';
    
    const allEmpty = [nombre,zona,tipo,tel,dir,mail].every(v=>v==='');
    if (allEmpty) continue;

    const p_esp_10     = iPEsp10 > -1 ? r[iPEsp10] : '';
    const p_esp_15     = iPEsp15 > -1 ? r[iPEsp15] : '';
    const p_esp_45     = iPEsp45 > -1 ? r[iPEsp45] : '';
    const p_esp_env_10 = iPEspEnv10 > -1 ? r[iPEspEnv10] : '';
    const p_esp_env_15 = iPEspEnv15 > -1 ? r[iPEspEnv15] : '';
    const p_esp_env_45 = iPEspEnv45 > -1 ? r[iPEspEnv45] : '';
    const coordenadas  = iCoord > -1 ? String(r[iCoord]||'').trim() : '';
    
    let vencimiento = iVenc > -1 ? r[iVenc] : '';
    if (vencimiento instanceof Date) {
        vencimiento = Utilities.formatDate(vencimiento, Session.getScriptTimeZone(), "dd/MM/yyyy");
    }

    out.push({
      id_cliente: id, cuit_dni: cuit,
      nombre, zona, categoria: normalizarCategoria(tipo),
      telefono: tel, direccion: dir, mail,
      p_esp_10, p_esp_15, p_esp_45,
      p_esp_env_10, p_esp_env_15, p_esp_env_45,
      vencimiento, coordenadas
    });
  }
  return {status:'success', clientes: out};
}

function saveClientes(rowsJson){
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName('CLIENTES');
  if (!sh) return {status:'error', message:'No existe hoja CLIENTES'};

  const rows = Array.isArray(rowsJson) ? rowsJson : JSON.parse(rowsJson||'[]');

  const headers = sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0]
    .map(h => String(h||'').trim().toUpperCase());
  const col = (...names)=>{ for (const n of names){ const j = headers.indexOf(n); if (j!==-1) return j+1; } return -1; };

  const width = sh.getLastColumn();
  const data = [];

  for (let i=0; i<rows.length; i++){
    const r = rows[i] || {};
    const fila = new Array(width).fill('');
    const put = (val,...hs)=>{ const c = col(...hs); if (c>0) fila[c-1] = val||''; };

    put(r.id_cliente, 'ID_CLIENTE', 'ID');
    put(r.cuit_dni,   'CUIT_DNI', 'CUIT', 'DNI');
    
    put(r.nombre,     'NOMBRE','NOMBRE DEL COMERCIO','COMERCIO');
    put(r.zona,       'ZONA');
    put(normalizarCategoria(r.categoria),'TIPO','CATEGORIA','CATEGORÍA');
    put(r.telefono,   'TELEFONO','TELÉFONO');
    put(r.direccion,  'DIRECCION','DIRECCIÓN');
    put(r.mail,       'MAIL','EMAIL','CORREO');
    
    put(r.p_esp_10,     'P_ESP_10');
    put(r.p_esp_15,     'P_ESP_15');
    put(r.p_esp_45,     'P_ESP_45');
    put(r.p_esp_env_10, 'P_ESP_ENV_10');
    put(r.p_esp_env_15, 'P_ESP_ENV_15');
    put(r.p_esp_env_45, 'P_ESP_ENV_45');
    put(r.vencimiento,  'VENCIMIENTO');
    put(r.coordenadas,  'COORDENADAS');

    data.push(fila);
  }

  sh.getRange(2,1,Math.max(1,data.length),width).setValues(data.length?data:[new Array(width).fill('')]);
  
  // ---> ACÁ ROMPEMOS LA CACHÉ PARA QUE AL CARGAR CLIENTES SE ACTUALICE TODO <---
  CacheService.getScriptCache().remove('INIT_APP_DATA');

  return {status:'success'};
}

function obtenerPrecioGarrafa(nombreGarrafa) {
  if (!nombreGarrafa) return 0;
  const hojaPrecios = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("PRECIOS");
  if (!hojaPrecios) return 0;
  const datos = hojaPrecios.getRange("A2:B" + hojaPrecios.getLastRow()).getValues();
  const garrafa = datos.find(row => String(row[0]).trim() === String(nombreGarrafa));
  return garrafa ? Number(garrafa[1]) || 0 : 0;
}

function obtenerDatosFormulario() {
  const libro = SpreadsheetApp.getActiveSpreadsheet();
  const zonasData = {};
  
  ['ZONA1','ZONA2','ZONA3','ZONA4'].forEach(z => {
    const hoja = libro.getSheetByName(z);
    if (hoja) {
      const vals = hoja.getDataRange().getValues();
      const arr = [];
      for (let i = vals.length - 1; i >= 1; i--) {
        if (vals[i][0] !== "") arr.push(vals[i][0]);
      }
      zonasData[z] = arr.reverse(); 
    }
  });

  const hojaPrecios = libro.getSheetByName('PRECIOS');
  const garrafasData = [];
  if (hojaPrecios) {
    const dataP = hojaPrecios.getDataRange().getValues();
    for (let i = dataP.length - 1; i >= 1; i--) {
      if (dataP[i][0] !== "") {
        garrafasData.push({ nombre: String(dataP[i][0]).trim(), precio: dataP[i][1] });
      }
    }
    garrafasData.reverse();
  }

  return { zonas: zonasData, garrafas: garrafasData };
}

function obtenerZonasDeClientes() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('CLIENTES');
  if (!sh) return { status: 'success', zonas: [] };

  const data = sh.getDataRange().getValues();
  if (data.length < 2) return { status: 'success', zonas: [] };

  const headers = data[0].map(h => String(h).toUpperCase().trim());
  const idxZona = headers.indexOf('ZONA');
  if (idxZona === -1) return { status: 'success', zonas: [] };

  const zonasSet = new Set();
  for (let i = data.length - 1; i >= 1; i--) {
    const val = String(data[i][idxZona]).toUpperCase().trim();
    if (val) zonasSet.add(val);
  }

  return { status: 'success', zonas: Array.from(zonasSet).sort() };
}

// =======================================================
// 5. SISTEMA DE ALARMAS
// =======================================================


function _getAlarmsSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName('ALARMAS');
  if (!sh) {
    sh = ss.insertSheet('ALARMAS');
    sh.appendRow(['FECHA','HORA','TIPO','DESCRIPCION','USUARIO','PENDIENTE']);
  } else {
    const headers = sh.getRange(1,1,1,Math.max(6, sh.getLastColumn())).getValues()[0]
      .map(h=>String(h||'').toUpperCase().trim());
    if (headers.indexOf('PENDIENTE') === -1) {
      const lastCol = sh.getLastColumn();
      if (lastCol < 6) sh.insertColumnsAfter(lastCol, 6-lastCol);
      sh.getRange(1,6).setValue('PENDIENTE');
    }
  }
  return sh;
}

function registrarAlarma(tipo, descripcion, usuario) {
  const sh = _getAlarmsSheet();
  const ahora = new Date();
  const fecha = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy');
  const hora  = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'HH:mm:ss');

  sh.insertRows(2, 1);
  sh.getRange(2, 1, 1, 6).setValues([[fecha, hora, tipo || '', descripcion || '', usuario || 'Sin usuario', 1]]);
}

function alarmasCount() {
  const sh = _getAlarmsSheet();
  const lr = sh.getLastRow();
  if (lr < 2) return 0;
  const vals = sh.getRange(2, 6, lr-1, 1).getValues().flat();
  return vals.reduce((acc,v)=> acc + (String(v).trim()==='1' ? 1 : 0), 0);
}

function listAlarmas(onlyPending, limit) {
  const sh = _getAlarmsSheet();
  const lr = sh.getLastRow();
  const lc = Math.max(6, sh.getLastColumn());
  if (lr < 2) return [];

  const rows = sh.getRange(2,1,lr-1,lc).getValues();
  const out = [];
  for (let i=0; i<rows.length; i++){
    const r = rows[i];
    const item = {
      row: i+2,
      fecha: r[0], hora: r[1], tipo: r[2], descripcion: r[3], usuario: r[4],
      pendiente: String(r[5]).trim()==='1'
    };
    if (onlyPending && !item.pendiente) continue;
    out.push(item);
    if (limit && out.length >= limit) break;
  }
  return out;
}

function marcarAlarma(row) {
  const sh = _getAlarmsSheet();
  if (!row || row < 2 || row > sh.getLastRow()) return false;
  sh.getRange(row, 6).setValue(0);
  return true;
}

function marcarTodasAlarmas() {
  const sh = _getAlarmsSheet();
  const lr = sh.getLastRow();
  if (lr < 2) return;
  sh.getRange(2, 6, lr-1, 1).setValue(0);
}

function saveAlarmasBatch(list){
  try{
    const sh = _getAlarmsSheet();
    if (!Array.isArray(list) || list.length === 0) return true;

    const updates = [];
    list.forEach(x=>{
      const row = Number(x?.row || 0);
      if (!row || row < 2 || row > sh.getLastRow()) return;
      const pendiente = String(x?.pendiente).trim()==='1' || String(x?.pendiente).trim().toLowerCase()==='true';
      updates.push({ row, val: pendiente ? 1 : 0 });
    });

    updates.forEach(u => sh.getRange(u.row, 6).setValue(u.val));
    return true;
  }catch(err){
    return false;
  }
}


// =======================================================
// 6. AUTENTICACIÓN Y SESIONES
// =======================================================


function loginYGenerarToken(usuario, clave) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('USUARIOS');
  if (!sh) return { status:'error', message: 'No existe hoja USUARIOS' };

  const headers = sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0]
                  .map(h => String(h||'').trim().toUpperCase());
  const col = (name) => headers.indexOf(name) + 1;

  const cUSER = col('USUARIO');
  const cPASS = col('PASSWORD');
  const cNAME = col('NOMBRE A MOSTRAR');

  const cALM  = col('ALARMAS');
  const cTAB  = col('TABLERO');
  const cUSR  = col('USUARIOS');
  const cFOR  = col('FORMULARIO');
  const cCLI  = col('CLIENTES');
  const cPRE  = col('PRECIOS');
  const cSTK  = col('STOCK');
  const cGTO  = col('GASTOS');
  const cCRG  = col('CARGA');
  const cFIN  = col('FINANZAS');
  const cCNF  = col('CONFINANZAS');
  const cFLOT = col('FLOTANTES'); // <-- LA LLAVE MAESTRA

  const lr = sh.getLastRow();
  if (lr < 2) return { status:'error', message:'Usuarios no encontrados' };

  const data = sh.getRange(2, 1, lr-1, sh.getLastColumn()).getValues();
  for (let i=0; i<data.length; i++){
    const row = data[i];
    const u = String(row[cUSER-1]||'').trim();
    const p = String(row[cPASS-1]||'').trim();

    if (usuario.toLowerCase() === u.toLowerCase() && clave === p){
      const nombre = String((cNAME>0 ? row[cNAME-1] : u) || u);
      
      const hasPerm = (idx) => (idx > 0 && String(row[idx-1]||'').trim() === '1');
      
      const permsObj = {
          formulario:  hasPerm(cFOR),
          clientes:    hasPerm(cCLI),
          precios:     hasPerm(cPRE),
          usuarios:    hasPerm(cUSR),
          alarmas:     hasPerm(cALM),
          tablero:     hasPerm(cTAB),
          stock:       hasPerm(cSTK),
          gastos:      hasPerm(cGTO),
          carga:       hasPerm(cCRG),
          finanzas:    hasPerm(cFIN),
          confinanzas: hasPerm(cCNF),
          flotantes:   hasPerm(cFLOT) // <-- SE AGREGA AL PAQUETE
      };

      const k = Utilities.getUuid();
      const ahora = new Date().getTime();
      const expira = ahora + (TIEMPO_SESION * 1000); 

      const cache = CacheService.getScriptCache();
      const datosSesion = {
          usuario: u,
          nombre: nombre,
          perms: permsObj, 
          inicio: ahora
      };
      cache.put(k, JSON.stringify(datosSesion), TIEMPO_SESION);

      let sheetSesiones = ss.getSheetByName('SESIONES');
      if (!sheetSesiones) {
          sheetSesiones = ss.insertSheet('SESIONES');
          sheetSesiones.appendRow(['TOKEN', 'USUARIO', 'EXPIRA', 'PERMISOS_JSON', 'FECHA_CREACION']);
      }
      
      if(sheetSesiones.getLastRow() > 5000) {
         sheetSesiones.deleteRows(2, 100);
      }

      sheetSesiones.appendRow([k, u, expira, JSON.stringify(permsObj), new Date()]);

      return { status:'success', k: k, usuario: u, nombre: nombre, perms: permsObj };
    }
  }
  return { status:'error', message:'Credenciales incorrectas' };
}

function validarTokenSesion(k) {
  const datos = obtenerDatosPorToken(k);
  return datos.valido;
}

function obtenerDatosPorToken(k) {
  if (!k) return { valido: false };

  const cache = CacheService.getScriptCache();
  const cachedJson = cache.get(k);

  if (cachedJson) {
    const data = JSON.parse(cachedJson);
    cache.put(k, cachedJson, TIEMPO_SESION); // Renovar
    return { 
        valido: true, 
        usuario: data.usuario, 
        nombre: data.nombre, 
        perms: data.perms 
    };
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('SESIONES');
  if (!sh) return { valido: false };

  const data = sh.getDataRange().getValues();
  const ahora = new Date().getTime();

  for (let i = data.length - 1; i >= 1; i--) {
    const row = data[i];
    if (row[0] === k) {
        const expira = Number(row[2]);
        
        if (expira > ahora) {
             const usuarioRecuperado = row[1];
             let permsRecuperados = {};
             try { permsRecuperados = JSON.parse(row[3]); } catch(e){ permsRecuperados = {}; }
             
             const datosRecuperados = {
               usuario: usuarioRecuperado,
               nombre: usuarioRecuperado, 
               perms: permsRecuperados,
               inicio: ahora 
             };
             cache.put(k, JSON.stringify(datosRecuperados), TIEMPO_SESION);

             return { 
                 valido: true, 
                 usuario: usuarioRecuperado, 
                 nombre: usuarioRecuperado, 
                 perms: permsRecuperados 
             };
        } else {
            return { valido: false }; 
        }
    }
  }
  return { valido: false };
}

function getUserInfo(usuario) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('USUARIOS');
  if (!sh) return null;

  const headers = sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0]
                  .map(h => String(h||'').trim().toUpperCase());
  const col = (name) => headers.indexOf(name) + 1;

  const cUSER = col('USUARIO');
  const cNAME = col('NOMBRE A MOSTRAR');

  const cALM  = col('ALARMAS');
  const cTAB  = col('TABLERO');
  const cUSR  = col('USUARIOS');
  const cFOR  = col('FORMULARIO');
  const cCLI  = col('CLIENTES');
  const cPRE  = col('PRECIOS');
  const cSTK  = col('STOCK');
  const cGTO  = col('GASTOS');
  const cCRG  = col('CARGA');
  const cFIN  = col('FINANZAS');
  const cCNF  = col('CONFINANZAS');
  
  // ---> NUEVA LÍNEA: Buscamos la columna FLOTANTES
  const cFLOT = col('FLOTANTES'); 

  if (cUSER <= 0) return null;

  const lr = sh.getLastRow();
  const data = sh.getRange(2, 1, Math.max(lr-1,1), sh.getLastColumn()).getValues();
  
  for (let i = 0; i < data.length; i++) {
    const row = data[i];
    const u = String(row[cUSER - 1] || '').trim();
    if (u === usuario) {
      const nombre = String((cNAME > 0 ? row[cNAME - 1] : u) || u);
      
      const hasPerm = (idx) => (idx > 0 && String(row[idx-1]||'').trim() === '1');
      
      const permsObj = {
          formulario:  hasPerm(cFOR),
          clientes:    hasPerm(cCLI),
          precios:     hasPerm(cPRE),
          usuarios:    hasPerm(cUSR),
          alarmas:     hasPerm(cALM),
          tablero:     hasPerm(cTAB),
          stock:       hasPerm(cSTK),
          gastos:      hasPerm(cGTO),
          carga:       hasPerm(cCRG),
          finanzas:    hasPerm(cFIN),
          confinanzas: hasPerm(cCNF),
          // ---> NUEVA LÍNEA: Inyectamos el permiso al objeto final
          flotantes:   hasPerm(cFLOT) 
      };

      return { usuario: u, nombre, perms: permsObj };
    }
  }
  return null;
}


// =======================================================
// 7. CONTROL DE CARGA Y LOGÍSTICA
// =======================================================


function _getCargaSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName('CCARGA');
  if (!sh) {
    sh = ss.insertSheet('CCARGA');
    const headers = [
      'ID_VIAJE', 'ESTADO', 'CHOFER', 'FECHA_SAL', 'HORA_SAL',
      'S_L10', 'S_V10', 'S_L15', 'S_V15', 'S_L45', 'S_V45',
      'FECHA_LLEG', 'HORA_LLEG',
      'L_L10', 'L_V10', 'L_L15', 'L_V15', 'L_L45', 'L_V45',
      'DIFERENCIA', 'MOTIVO', 'AUDITOR', 'ALERTA_ENVIADA', 'TIPO_VIAJE'
    ];
    sh.appendRow(headers);
  }
  return sh;
}

function getDriversList() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('USUARIOS');
  if (!sh) return [];
  const vals = sh.getRange(2, 1, Math.max(sh.getLastRow()-1, 1), 1).getValues().flat();
  return vals.filter(u => u && String(u).trim() !== '');
}

function checkDriverAvailability(chofer) {
  const sh = _getCargaSheet();
  const data = sh.getDataRange().getValues();
  for (let i = data.length - 1; i >= 1; i--) {
     if (String(data[i][1]).trim() === 'EN_RUTA' && String(data[i][2]).trim() === chofer) {
       return false;
     }
  }
  return true;
}

function procesarTransporte(p, auditor) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName('CCARGA');
  if (!sh) sh = _getCargaSheet();

  // --- PEAJE DE SEGURIDAD ---
  const idTurno = getTurnoAbierto(); 

  const ahora = new Date();
  const fecha = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy');
  const hora = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'HH:mm:ss');
  const n = (val) => Number(val) || 0; 
  
  const tipoViaje = p.tipoViaje || 'REPARTO';

  // --- CASO 1: SALIDA ---
  if (p.modo === 'SALIDA') {
    const idViaje = Utilities.getUuid().slice(0,8).toUpperCase();
    const estadoSalida = tipoViaje === 'COMPRA' ? 'COMPRA_EN_RUTA' : 'EN_RUTA';

    // Agregamos el idTurno al final del array
    sh.appendRow([
      idViaje, estadoSalida, p.chofer, fecha, hora,
      n(p.L10), n(p.V10), n(p.L15), n(p.V15), n(p.L45), n(p.V45),
      '', '', '', '', '', '', '', '', '', '', auditor, '', tipoViaje, 
      '', '', '', '', '', '', '', idTurno // <--- ESTAMPA TURNO
    ]);
    return { status: 'success', message: 'Salida registrada', idViaje: idViaje };
  }

  // --- CASO 2: LLEGADA ---
  if (p.modo === 'LLEGADA') {
    const data = sh.getDataRange().getValues();
    let rowIndex = -1;
    
    // OPTIMIZACIÓN APLICADA: Bucle de abajo hacia arriba. No escaneamos toda la historia.
    for (let i = data.length - 1; i >= 1; i--) {
      if (String(data[i][0]) === p.idViaje) { rowIndex = i + 1; break; }
    }

    if (rowIndex === -1) return { status: 'error', message: 'Viaje no encontrado' };

    const rowData = data[rowIndex - 1];
    const esCompra = tipoViaje === 'COMPRA' || String(rowData[23]).trim() === 'COMPRA';

    let diferenciaTotal = 0;
    let detalleDiferencia = '';
    let huboAlerta = 'NO';
    
    if (esCompra) {
         // LÓGICA DE COMPRA (EXTRACTO MATEMÁTICO)
         const exp10 = n(rowData[6]) + n(rowData[5]) + n(p.compraEnv10);
         const exp15 = n(rowData[8]) + n(rowData[7]) + n(p.compraEnv15);
         const exp45 = n(rowData[10]) + n(rowData[9]) + n(p.compraEnv45);
         
         const arr10 = n(p.L10) + n(p.V10);
         const arr15 = n(p.L15) + n(p.V15);
         const arr45 = n(p.L45) + n(p.V45);

         const dif10 = exp10 - arr10;
         const dif15 = exp15 - arr15;
         const dif45 = exp45 - arr45;

         diferenciaTotal = Math.abs(dif10) + Math.abs(dif15) + Math.abs(dif45);

         let fallas = [];
         const difStr = (v) => v > 0 ? `Faltan ${v}` : `Sobran ${Math.abs(v)}`;
         if(dif10 !== 0) fallas.push(`[10kg: ${difStr(dif10)}]`);
         if(dif15 !== 0) fallas.push(`[15kg: ${difStr(dif15)}]`);
         if(dif45 !== 0) fallas.push(`[45kg: ${difStr(dif45)}]`);

         if (fallas.length > 0) { 
             detalleDiferencia = fallas.join(' '); 
             huboAlerta = 'SI'; 
         }

         // REGISTRO COMPRA DE ENVASES EN BD1 Y FINANZAS
         const compraronEnvases = n(p.compraEnv10) > 0 || n(p.compraEnv15) > 0 || n(p.compraEnv45) > 0 || n(p.montoCompraEnv) > 0;
         if (compraronEnvases) {
             const shFin = ss.getSheetByName('MOVIMIENTOS_FINANZAS');
             const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
             const detalleCompra = `COMPRA ENVASES: 10kg(${n(p.compraEnv10)}) 15kg(${n(p.compraEnv15)}) 45kg(${n(p.compraEnv45)}) | Remito: ${p.remitoPlanta || 'S/N'}`;

             if (shFin && n(p.montoCompraEnv) > 0) {
                 shFin.appendRow([
                      "CE-" + Utilities.getUuid().split('-')[0].toUpperCase(),
                      fecha + " " + hora, "GASTO", idTurno, p.idViaje, detalleCompra,
                      -n(p.montoCompraEnv), -n(p.montoCompraEnv), 0, auditor,
                      "N/A", "", "", "PENDIENTE", "", "", ""
                 ]);
             }

             if (shBD1) {
                 const lc = shBD1.getLastColumn();
                 if(lc > 0) {
                     const headers = shBD1.getRange(2, 1, 1, lc).getValues()[0];
                     const rowBD1 = headers.map(h => {
                         const t = String(h).toUpperCase().trim();
                         if(t === 'USUARIO') return auditor;
                         if(t === 'TIPO') return 'COMPRA_ENVASE';
                         if(t === 'FECHA') return fecha;
                         if(t === 'HORA') return hora;
                         if(t === 'C') return 'PLANTA ENVASADORA';
                         if(t === 'E$') return -n(p.montoCompraEnv);
                         if(t === 'TOTAL') return -n(p.montoCompraEnv);
                         if(t === 'G') return detalleCompra;
                         if(t === 'ID_TURNO') return idTurno;
                         if(t === 'ID_VIAJE') return p.idViaje;
                         return '';
                     });
                     shBD1.appendRow(rowBD1);
                 }
             }
         }
    } else {
         const chofer = rowData[2], fSal = rowData[3], hSal = rowData[4];
         const vDet = calcularVentas_Carga(chofer, fSal, hSal, p.idViaje);
         
         const exp = {
             L10: n(rowData[5]) - vDet[10].bajan_llenos,
             V10: n(rowData[6]) + vDet[10].suben_vacios,
             L15: n(rowData[7]) - vDet[15].bajan_llenos,
             V15: n(rowData[8]) + vDet[15].suben_vacios,
             L45: n(rowData[9]) - vDet[45].bajan_llenos,
             V45: n(rowData[10]) + vDet[45].suben_vacios
         };
         
         const arr = { L10: n(p.L10), V10: n(p.V10), L15: n(p.L15), V15: n(p.V15), L45: n(p.L45), V45: n(p.V45) };
         const difs = { L10: exp.L10 - arr.L10, V10: exp.V10 - arr.V10, L15: exp.L15 - arr.L15, V15: exp.V15 - arr.V15, L45: exp.L45 - arr.L45, V45: exp.V45 - arr.V45 };
         
         let totalExpected = exp.L10 + exp.V10 + exp.L15 + exp.V15 + exp.L45 + exp.V45;
         let totalArrived = arr.L10 + arr.V10 + arr.L15 + arr.V15 + arr.L45 + arr.V45;
         diferenciaTotal = totalExpected - totalArrived; 
         
         const difStr = (v) => v > 0 ? `Faltan ${v}` : `Sobran ${Math.abs(v)}`;
         let fallas = [];
         if(difs.L10 !== 0) fallas.push(`[L10: ${difStr(difs.L10)}]`);
         if(difs.V10 !== 0) fallas.push(`[V10: ${difStr(difs.V10)}]`);
         if(difs.L15 !== 0) fallas.push(`[L15: ${difStr(difs.L15)}]`);
         if(difs.V15 !== 0) fallas.push(`[V15: ${difStr(difs.V15)}]`);
         if(difs.L45 !== 0) fallas.push(`[L45: ${difStr(difs.L45)}]`);
         if(difs.V45 !== 0) fallas.push(`[V45: ${difStr(difs.V45)}]`);
         
         if (fallas.length > 0) { detalleDiferencia = fallas.join(' '); huboAlerta = 'SI'; }
    }

    const estadoFinal = esCompra ? 'COMPRA_FINALIZADA' : 'FINALIZADO';
    const row = rowIndex;
    sh.getRange(row, 2).setValue(estadoFinal); 
    sh.getRange(row, 12).setValue(fecha);       
    sh.getRange(row, 13).setValue(hora);         
    sh.getRange(row, 14).setValue(n(p.L10));     
    sh.getRange(row, 15).setValue(n(p.V10));     
    sh.getRange(row, 16).setValue(n(p.L15));     
    sh.getRange(row, 17).setValue(n(p.V15));     
    sh.getRange(row, 18).setValue(n(p.L45));     
    sh.getRange(row, 19).setValue(n(p.V45));     
    sh.getRange(row, 20).setValue(diferenciaTotal);   
    sh.getRange(row, 21).setValue(p.motivo || ''); 
    sh.getRange(row, 23).setValue(huboAlerta);   
    sh.getRange(row, 24).setValue(esCompra ? 'COMPRA' : 'REPARTO'); 
    
    if (esCompra && p.remitoPlanta) { sh.getRange(row, 26).setValue(p.remitoPlanta); }

    if (huboAlerta === 'SI') {
        let msgAlarma = `[LLEGADA ${esCompra?'COMPRA':'REPARTO'}] Chofer: ${rowData[2]}. `;
        if (!esCompra) msgAlarma += `Descuadre Físico: ${detalleDiferencia}. `;
        else msgAlarma += `Dif Total: ${diferenciaTotal}. `;
        msgAlarma += `Motivo: ${p.motivo}`;
        registrarAlarma('DIFERENCIA_CARGA', msgAlarma, auditor);
    }
    return { status: 'success', message: 'Viaje finalizado' };
  }

  // --- CASO 3: RETROACTIVO ---
  if (p.modo === 'RETROACTIVO') {
    const idViaje = Utilities.getUuid().slice(0,8).toUpperCase() + '-R';
    const diferencia = n(p.diferencia);
    const estado = (diferencia !== 0) ? 'CON_DIFERENCIA' : 'FINALIZADO';
    const huboAlerta = diferencia !== 0 ? 'SI' : 'NO';
    const marcaAuditoria = p.alertaAuditoria ? 'SI' : 'NO';
    
    sh.appendRow([
      idViaje, estado, p.chofer, fecha, hora,
      n(p.SL10), n(p.SV10), n(p.SL15), n(p.SV15), n(p.SL45), n(p.SV45),
      fecha, hora, 
      n(p.RL10), n(p.RV10), n(p.RL15), n(p.RV15), n(p.RL45), n(p.RV45),
      diferencia, p.motivo, auditor, huboAlerta, 'REPARTO', 
      marcaAuditoria, '', '', '', '', '', '', idTurno
    ]);

    if (diferencia !== 0) { registrarAlarma('DIFERENCIA_CARGA', `[RETRO] Chofer: ${p.chofer}. Faltan: ${diferencia}. Motivo: ${p.motivo}`, auditor); }
    if (p.alertaAuditoria) { registrarAlarma('CARGA_RETROACTIVA', `El usuario ${auditor} forzó una carga retroactiva para ${p.chofer} asumiendo responsabilidad.`, auditor); }

    return { status: 'success', message: 'Carga retroactiva guardada' };
  }
  return { status: 'error', message: 'Modo de transporte desconocido' };
}
 

// =======================================================
// 8. CONTROL DE STOCK (CSTOCK)
// =======================================================
 

function calcularMovimientosDesde(stockInicial) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const timeInicio = parseDateTime(stockInicial.fecha, stockInicial.hora).getTime();
  let final = { ...stockInicial };
  const n = (val) => Number(val) || 0;

  // 1. LA PUERTA DEL GALPÓN (CCARGA) - Todo lo que salió y entró físicamente por camión
  const shCarga = ss.getSheetByName('CCARGA');
  let viajesDelTurno = []; 
  
  if (shCarga) {
      const dataC = shCarga.getDataRange().getValues();
      for (let i = 1; i < dataC.length; i++) {
          const r = dataC[i];
          const tSal = parseDateTime(r[3], r[4]) ? parseDateTime(r[3], r[4]).getTime() : 0;
          
          if (tSal > timeInicio) {
              const idViaje = String(r[0]).trim();
              viajesDelTurno.push(idViaje); // Anotamos qué camiones salieron hoy
              
              // RESTAMOS lo que se llevó el camión al salir
              final.L10 -= n(r[5]); final.V10 -= n(r[6]);
              final.L15 -= n(r[7]); final.V15 -= n(r[8]);
              final.L45 -= n(r[9]); final.V45 -= n(r[10]);
              
              // SUMAMOS lo que devolvió el camión al llegar
              final.L10 += n(r[13]); final.V10 += n(r[14]);
              final.L15 += n(r[15]); final.V15 += n(r[16]);
              final.L45 += n(r[17]); final.V45 += n(r[18]);
          }
      }
  }

  // 2. MOSTRADOR DIRECTO (BD1) - Ventas sueltas sin camión
  const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  if (shBD1) {
    const dataBD1 = shBD1.getDataRange().getValues();
    const headers = dataBD1[1].map(h => String(h).toUpperCase().trim());
    const iF = headers.indexOf('FECHA'), iH = headers.indexOf('HORA');
    const iViaje = headers.indexOf('ID_VIAJE'); // CLAVE MAESTRA
    const iTipo = headers.indexOf('TIPO');
    
    for (let i = 2; i < dataBD1.length; i++) {
      const tOp = parseDateTime(dataBD1[i][iF], dataBD1[i][iH]) ? parseDateTime(dataBD1[i][iF], dataBD1[i][iH]).getTime() : 0;
      
      if (tOp > timeInicio) {
          const idViaje = iViaje > -1 ? String(dataBD1[i][iViaje]).trim() : '';
          
          // FILTRO: Si NO tiene ID_VIAJE, significa que la venta se hizo directo en mostrador
          if (!idViaje || !viajesDelTurno.includes(idViaje)) {
              const tipo = iTipo > -1 ? String(dataBD1[i][iTipo]).toUpperCase().trim() : 'VENTA';
              
              if (tipo === 'VENTA' || tipo === 'CONSIGNACION') {
                  const llenosVendidos10 = n(dataBD1[i][headers.indexOf('ALL10')]);
                  const llenosVendidos15 = n(dataBD1[i][headers.indexOf('ALL15')]);
                  const llenosVendidos45 = n(dataBD1[i][headers.indexOf('ALL45')]);

                  // Resto Lleno
                  final.L10 -= llenosVendidos10; final.L15 -= llenosVendidos15; final.L45 -= llenosVendidos45;
                  
                  // Si es venta normal, el tipo me deja un Vacío. Si es Consignación, se lleva el tubo sin dejar vacío.
                  if (tipo === 'VENTA') {
                      final.V10 += llenosVendidos10; final.V15 += llenosVendidos15; final.V45 += llenosVendidos45;
                  }
              }
          }
      }
    }
  }

  // 3. COMODATOS DE MOSTRADOR (HISTORIAL_CTA_CTE)
  const shHist = ss.getSheetByName('HISTORIAL_CTA_CTE');
  if (shHist) {
      const dataHist = shHist.getDataRange().getValues();
      for(let i = 1; i < dataHist.length; i++) {
          let tHist = (dataHist[i][0] instanceof Date) ? dataHist[i][0].getTime() : parseDateTime(String(dataHist[i][0]).split(' ')[0], String(dataHist[i][0]).split(' ')[1]).getTime();
          
          if (tHist > timeInicio) {
              const idViaje = String(dataHist[i][9]).trim(); // Columna J (VIAJE_REF)
              
              // FILTRO: Solo calculamos si el comodato se gestionó por mostrador
              if (!idViaje || !viajesDelTurno.includes(idViaje)) {
                  const mov = String(dataHist[i][3]).toUpperCase().trim();
                  const e10 = n(dataHist[i][4]), e15 = n(dataHist[i][5]), e45 = n(dataHist[i][6]);
                  
                  if (mov === 'DEUDA') { 
                      // Se lleva el tubo prestado (Sale Lleno)
                      final.L10 -= e10; final.L15 -= e15; final.L45 -= e45;
                  } else if (mov === 'DEVOLUCION') { 
                      // Devuelve el tubo que le prestamos (Entra Vacío)
                      final.V10 += e10; final.V15 += e15; final.V45 += e45;
                  }
              }
          }
      }
  }

  // 4. CAUCIONES (Siempre son por Mostrador)
  const shCau = ss.getSheetByName('CAUCIONES');
  if (shCau) {
     const dataCau = shCau.getDataRange().getValues();
     for (let i = 1; i < dataCau.length; i++) {
         const tCau = parseDateTime(dataCau[i][1], null) ? parseDateTime(dataCau[i][1], null).getTime() : 0;
         
         if (tCau > timeInicio) {
             // Generan caución -> Se llevan el envase
             final.L10 -= n(dataCau[i][3]); final.L15 -= n(dataCau[i][4]); final.L45 -= n(dataCau[i][5]);
         }
         
         if (String(dataCau[i][7]).trim() === 'FINALIZADA') {
             const tCierre = parseDateTime(dataCau[i][8], null) ? parseDateTime(dataCau[i][8], null).getTime() : 0;
             if (tCierre > timeInicio) {
                 // Devuelven la caución -> Recuperamos el Vacío
                 final.V10 += n(dataCau[i][3]); final.V15 += n(dataCau[i][4]); final.V45 += n(dataCau[i][5]);
             }
         }
     }
  }

  // 5. FLOTANTES (Ajuste matemático de vacíos en planta)
  const shFlot = ss.getSheetByName('FLOTANTES');
  if (shFlot) {
      const dataFlot = shFlot.getDataRange().getValues();
      if (dataFlot.length > 1) {
          const hF = dataFlot[0].map(h => String(h).toUpperCase().trim());
          const iF = hF.indexOf('FECHA');
          const iH = hF.indexOf('HORA');
          const i10 = hF.indexOf('ENV_10');
          const i15 = hF.indexOf('ENV_15');
          const i45 = hF.indexOf('ENV_45');

          if (iF > -1 && iH > -1 && i10 > -1) {
              for (let i = 1; i < dataFlot.length; i++) {
                  const tFlot = parseDateTime(dataFlot[i][iF], dataFlot[i][iH]) ? parseDateTime(dataFlot[i][iF], dataFlot[i][iH]).getTime() : 0;
                  
                  if (tFlot > timeInicio) {
                      // Sumamos la diferencia exacta (AV - ALL) que guardó la hoja Flotantes.
                      // Esto corrige automáticamente el desfase de BD1 y deja el número físico real.
                      final.V10 += n(dataFlot[i][i10]);
                      final.V15 += n(dataFlot[i][i15]);
                      final.V45 += n(dataFlot[i][i45]);
                  }
              }
          }
      }
  }

  return final;
}

function _getStockSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName('CSTOCK');
  if (!sh) {
    sh = ss.insertSheet('CSTOCK');
    sh.appendRow([
      'ID_TURNO','ESTADO','FECHA','HORA_INI','USUARIO',
      'INI_L10','INI_V10','INI_L15','INI_V15','INI_L45','INI_V45',
      'HORA_FIN',
      'FIN_L10','FIN_V10','FIN_L15','FIN_V15','FIN_L45','FIN_V45',
      'SISTEMA_CALC','HAY_DIF','MOTIVO'
    ]);
  }
  return sh;
}

function obtenerEstadoStock() {
  const sh = _getStockSheet();
  const data = sh.getDataRange().getValues();
  
  const bloqueo = hayCamionesEnRuta();
  
  if (data.length < 2) return { estado: 'CERRADO', sugerido: null, bloqueo: bloqueo };

  let filaAbierta = -1;
  let stockInicial = null;

  for (let i = data.length - 1; i >= 1; i--) {
    if (String(data[i][1]).toUpperCase().trim() === 'ABIERTO') {
      filaAbierta = i;
      stockInicial = {
        fecha: data[i][2], hora: data[i][3],
        L10: Number(data[i][5]), V10: Number(data[i][6]),
        L15: Number(data[i][7]), V15: Number(data[i][8]),
        L45: Number(data[i][9]), V45: Number(data[i][10])
      };
      break; 
    }
  }

  if (filaAbierta === -1) {
    const ult = data[data.length - 1];
    let sugerido = null;
    if (data.length > 1) {
       sugerido = {
         L10: ult[12], V10: ult[13], L15: ult[14], V15: ult[15], L45: ult[16], V45: ult[17]
       };
    }
    return { estado: 'CERRADO', sugerido: sugerido, bloqueo: bloqueo };
  }

  const calculado = calcularMovimientosDesde(stockInicial);
  
  return { 
    estado: 'ABIERTO', 
    idTurno: data[filaAbierta][0], 
    inicio: stockInicial,
    calculado: calculado,
    bloqueo: bloqueo 
  };
}

function nuevaSaveStock(e) {
  const p = e.parameter;
  const sh = _getStockSheet();
  const n = (v) => Number(v) || 0;
  
  const ahora = new Date();
  const fecha = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy');
  const hora = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'HH:mm:ss');

  // --- MODO APERTURA (INICIO) ---
  if (p.tipo === 'INICIO' || p.tipo === 'INICIAL') {
    const estado = obtenerEstadoStock();
    if (estado.estado === 'ABIERTO') return { status: 'error', message: 'Ya hay un turno abierto.' };

    const idTurno = Utilities.getUuid().slice(0,8).toUpperCase();
    
    sh.appendRow([
      idTurno, 'ABIERTO', fecha, hora, p.usuario,
      n(p.L10), n(p.V10), n(p.L15), n(p.V15), n(p.L45), n(p.V45),
      '', '', '', '', '', '', '', '', '', '' 
    ]);
    return { status: 'success', message: 'Turno iniciado' };
  }

  // --- MODO CIERRE (FINAL) ---
  if (p.tipo === 'FINAL' || p.tipo === 'CIERRE') {
    
    // 🔥 BLOQUEO DE SEGURIDAD 🔥
    if (hayCamionesEnRuta()) {
        return { 
            status: 'error', 
            message: '⛔ NO SE PUEDE CERRAR: Hay camiones EN RUTA. Finalícelos en Control de Carga primero.' 
        };
    }

    const data = sh.getDataRange().getValues();
    let rowIndex = -1;

    for (let i = data.length - 1; i >= 1; i--) {
       if (String(data[i][1]).toUpperCase().trim() === 'ABIERTO') {
         rowIndex = i + 1; 
         break;
       }
    }

    if (rowIndex === -1) return { status: 'error', message: 'No se encontró turno abierto para cerrar.' };

    sh.getRange(rowIndex, 12).setValue(hora);
    const stockFinal = [[ n(p.L10), n(p.V10), n(p.L15), n(p.V15), n(p.L45), n(p.V45) ]];
    sh.getRange(rowIndex, 13, 1, 6).setValues(stockFinal);
    sh.getRange(rowIndex, 19).setValue('Calculado OK'); 
    sh.getRange(rowIndex, 20).setValue(p.hasDiff === 'true' ? 'SI' : 'NO');
    sh.getRange(rowIndex, 21).setValue(p.motivo || '');
    sh.getRange(rowIndex, 2).setValue('CERRADO');

    if (p.hasDiff === 'true') {
       registrarAlarma('STOCK_DESCUADRE', `Cierre con diferencias. Usuario: ${p.usuario}. Motivo: ${p.motivo}`, p.usuario);
    }

    return { status: 'success', message: 'Turno cerrado correctamente' };
  }
}

function hayCamionesEnRuta() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CCARGA');
  if (!sh) return false;
  
  const data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
      const est = String(data[i][1]).toUpperCase().trim();
      if (est === 'EN_RUTA' || est === 'COMPRA_EN_RUTA') return true;
  }
  return false;
}


// =======================================================
// 9. AUDITORÍA DE VENTAS (La solución corregida)
// =======================================================


function getPendingTripsWithAlarms() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CCARGA');
  
  if (!sh) return [];
  const data = sh.getDataRange().getValues();
  if (data.length < 2) return []; 

  const trips = [];
  const n = (v) => Number(v) || 0;
  
  const fmt = (val, f) => {
      try { 
        if (!val) return '';
        return Utilities.formatDate(new Date(val), Session.getScriptTimeZone(), f); 
      } catch(e) { return String(val); } 
  };

  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const estado = String(row[1]).trim().toUpperCase();
    
    if (estado === 'EN_RUTA' || estado === 'COMPRA_EN_RUTA') {
      const idViaje = String(row[0]).trim().toUpperCase(); // Forzamos mayúsculas y sin espacios
      const chofer = String(row[2]).trim();
      const fSalida = row[3];
      const hSalida = row[4];
      
      const sL10=n(row[5]), sL15=n(row[7]), sL45=n(row[9]);
      const sV10=n(row[6]), sV15=n(row[8]), sV45=n(row[10]);
      
      const tipoViaje = String(row[23] || 'REPARTO').trim().toUpperCase();
      const isCompra = tipoViaje === 'COMPRA';

      let cargaLabel = "";
      // Corregimos los nombres de las variables acá para que coincidan con la calculadora
      let vDetalle = { 10: {bajan_llenos:0, suben_vacios:0}, 15: {bajan_llenos:0, suben_vacios:0}, 45: {bajan_llenos:0, suben_vacios:0} };
      
      let expL10 = 0, expV10 = 0, expL15 = 0, expV15 = 0, expL45 = 0, expV45 = 0;

      if (isCompra) {
          const totalVacios = sV10 + sV15 + sV45;
          cargaLabel = `Llevó: ${totalVacios} Vacíos a Planta`;
      } else {
          // Le enviamos el ID de viaje para el Plan A
          vDetalle = calcularVentas_Carga(chofer, fSalida, hSalida, idViaje);
          
          expL10 = sL10 - vDetalle[10].bajan_llenos;
          expV10 = sV10 + vDetalle[10].suben_vacios;
          expL15 = sL15 - vDetalle[15].bajan_llenos;
          expV15 = sV15 + vDetalle[15].suben_vacios;
          expL45 = sL45 - vDetalle[45].bajan_llenos;
          expV45 = sV45 + vDetalle[45].suben_vacios;

          cargaLabel = `Ideal -> 10kg: ${expL10}L|${expV10}V - 15kg: ${expL15}L|${expV15}V - 45kg: ${expL45}L|${expV45}V`;
      }

      trips.push({
        idViaje: idViaje,
        chofer: chofer,
        tipoViaje: tipoViaje,
        fechaSalida: fmt(fSalida, 'dd/MM'),
        horaSalida: fmt(hSalida, 'HH:mm'),
        cargaLabel: cargaLabel,
        isLate: false, 
        sDetails: {
          l10: sL10, v10: sV10,
          l15: sL15, v15: sV15,
          l45: sL45, v45: sV45
        },
        sugerencia: { 
          10: { L: expL10, V: expV10 },
          15: { L: expL15, V: expV15 },
          45: { L: expL45, V: expV45 }
        },
        ventasDetalle: vDetalle 
      });
    }
  }
  return trips;
}

function calcularVentasAuditoria(chofer, fechaSalida, horaSalida) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  
  const vacio = { 
    10: { gas:0, env:0 }, 15: { gas:0, env:0 }, 45: { gas:0, env:0 } 
  };

  if (!sh) return vacio;

  const data = sh.getDataRange().getValues();
  if (data.length < 3) return vacio; 

  const headers = data[1].map(h => String(h).toUpperCase().trim());
  const idx = (names) => {
    const list = Array.isArray(names) ? names : [names];
    for(let n of list) {
      const i = headers.indexOf(n);
      if(i > -1) return i;
    }
    return -1;
  };

  const iUser  = idx(['USUARIO', 'CHOFER', 'VENDEDOR', 'REPARTIDOR']);
  const iFecha = idx(['FECHA']);
  const iHora  = idx(['HORA']);

  if (iUser === -1 || iFecha === -1) return vacio;

  const map = {
    10: { gas: [idx('VS10'), idx('VC10'), idx('VRP10'), idx('VU10')], env: idx('CE10') },
    15: { gas: [idx('VS15'), idx('VC15'), idx('VRP15'), idx('VU15')], env: idx('CE15') },
    45: { gas: [idx('VS45'), idx('VC45'), idx('VRP45'), idx('VU45')], env: idx('CE45') }
  };

  const dtSalida = parseDateTime(fechaSalida, horaSalida);
  const timeSalida = dtSalida ? dtSalida.getTime() : 0;
  const choferID = String(chofer).toUpperCase().trim();
  const n = (val) => Number(val) || 0;

  let res = JSON.parse(JSON.stringify(vacio)); 

  for (let i = 2; i < data.length; i++) {
    const row = data[i];
    const rowUser = String(row[iUser] || '').toUpperCase().trim();

    if (rowUser === choferID) {
      const dtVenta = parseDateTime(row[iFecha], row[iHora]);
      
      // Si la fecha de venta es válida y MAYOR a la salida (+1 minuto de tolerancia)
      if (dtVenta && dtVenta.getTime() > (timeSalida + 60000)) {
         [10, 15, 45].forEach(k => {
             map[k].gas.forEach(c => { if(c > -1) res[k].gas += n(row[c]); });
             if(map[k].env > -1) res[k].env += n(row[map[k].env]);
         });
      }
    }
  }
  return res;
}


// =======================================================
// LECTOR DE FECHAS UNIVERSAL (A prueba de balas)
// =======================================================


function parseDateTime(f, h) {
  if (!f) return null;
  let y = 0, m = 0, d = 0;
  let hh = 0, mm = 0, ss = 0;

  // Si nos pasan un solo string con fecha y hora juntas (ej: "2026-03-21 08:44:23")
  if (typeof f === 'string' && f.includes(' ') && !h) {
      const parts = f.split(' ');
      f = parts[0];
      h = parts[1];
  }

  // 1. Entender la Fecha
  if (f instanceof Date) {
    y = f.getFullYear(); m = f.getMonth(); d = f.getDate();
    // Si f es un Date, ya tiene la hora incorporada, la extraemos si no nos pasaron 'h' por separado
    if (!h) {
        hh = f.getHours(); mm = f.getMinutes(); ss = f.getSeconds();
    }
  } else if (typeof f === 'string') {
    const fStr = f.split(' ')[0]; // Por si acaso quedó algo pegado
    let p = [];
    if (fStr.includes('/')) p = fStr.split('/');
    else if (fStr.includes('-')) p = fStr.split('-');
    
    if (p.length === 3) {
      y = p[2].length === 4 ? Number(p[2]) : Number(p[0]);
      m = Number(p[1]) - 1;
      d = p[2].length === 4 ? Number(p[0]) : Number(p[2]);
    } else {
       const hoy = new Date();
       y = hoy.getFullYear(); m = hoy.getMonth(); d = hoy.getDate();
    }
  }

  // 2. Entender la Hora
  if (h) {
     if (h instanceof Date) {
        hh = h.getHours(); mm = h.getMinutes(); ss = h.getSeconds();
     } else if (typeof h === 'string') {
        // Asegurarnos de limpiar espacios u otros caracteres raros
        const hStr = h.trim().split(' ')[0];
        const partsH = hStr.split(':');
        if (partsH.length >= 2) {
           hh = Number(partsH[0]); mm = Number(partsH[1]);
           if (partsH[2]) ss = Number(partsH[2]);
        }
     }
  }

  if (y === 0) return null;
  return new Date(y, m, d, hh, mm, ss);
}


// =======================================================
// BLOQUE EXCLUSIVO: CONTROL DE CARGA (AISLADO)
// =======================================================


function getPendingTrips_Carga() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CCARGA');
  
  if (!sh) return [];
  const data = sh.getDataRange().getValues();
  if (data.length < 2) return []; 

  const trips = [];
  const n = (v) => Number(v) || 0;
  const fmt = (val, f) => {
      try { return Utilities.formatDate(new Date(val), Session.getScriptTimeZone(), f); } 
      catch(e) { return String(val); } 
  };

  // Límite de seguridad: 48 horas atrás. No leemos prehistoria.
  const limiteTiempo = new Date().getTime() - (2 * 24 * 60 * 60 * 1000);

  // LA CIRUGÍA: Leer de abajo hacia arriba (desde la última fila hasta la fila 1)
  for (let i = data.length - 1; i >= 1; i--) {
    const row = data[i];
    const estado = String(row[1]).trim().toUpperCase();
    
    // Parseo rápido de la fecha de la fila para saber si ya pasamos los 2 días
    const fSalida = row[3]; 
    const hSalida = row[4]; 
    let timestampFila = 0;
    
    try {
        if (fSalida instanceof Date) {
            timestampFila = fSalida.getTime();
        } else {
            const partesF = String(fSalida).split(' ')[0].split(/[-/]/);
            const anio = partesF[0].length === 4 ? partesF[0] : partesF[2];
            const mes = partesF[0].length === 4 ? partesF[1]-1 : partesF[1]-1;
            const dia = partesF[0].length === 4 ? partesF[2] : partesF[0];
            timestampFila = new Date(anio, mes, dia).getTime();
        }
    } catch(e) {}

    // OPTIMIZACIÓN EXTREMA: Si la fila tiene fecha y es más vieja que 48hs, cortamos el escaneo
    if (timestampFila > 0 && timestampFila < limiteTiempo) {
        break;
    }

    if (estado === 'EN_RUTA' || estado === 'COMPRA_EN_RUTA') {
      const chofer = row[2];
      
      const sL10=n(row[5]), sL15=n(row[7]), sL45=n(row[9]);
      const sV10=n(row[6]), sV15=n(row[8]), sV45=n(row[10]);
      
      const tipoViaje = String(row[23] || 'REPARTO').trim().toUpperCase(); 
      const isCompra = tipoViaje === 'COMPRA';

      let cargaLabel = "";
      
      let sug = { 10: {L:0, V:0}, 15: {L:0, V:0}, 45: {L:0, V:0} };
      let totalEntregas = 0;

      if (isCompra) {
          const totalVacios = sV10 + sV15 + sV45;
          cargaLabel = `Llevó: ${totalVacios} Vacíos a Planta`;
      } else {
          // El sabueso trae los datos filtrados con el nuevo reglamento
          // ACÁ ESTÁ EL TALÓN DE AQUILES: Esta consulta adentro del bucle frena todo. 
          // Pasame esta función para optimizarla.
          let vDetalle = calcularVentas_Carga(chofer, fSalida, hSalida, row[0]);
          
          // Matemática limpia aplicando llenos que bajan y vacíos que suben
          sug[10].L = Math.max(0, sL10 - vDetalle[10].bajan_llenos);
          sug[10].V = sV10 + vDetalle[10].suben_vacios;
          
          sug[15].L = Math.max(0, sL15 - vDetalle[15].bajan_llenos);
          sug[15].V = sV15 + vDetalle[15].suben_vacios;
          
          sug[45].L = Math.max(0, sL45 - vDetalle[45].bajan_llenos);
          sug[45].V = sV45 + vDetalle[45].suben_vacios;

          cargaLabel = `Ideal -> 10kg: ${sug[10].L}L|${sug[10].V}V - 15kg: ${sug[15].L}L|${sug[15].V}V - 45kg: ${sug[45].L}L|${sug[45].V}V`;
          
          totalEntregas = vDetalle[10].bajan_llenos + vDetalle[15].bajan_llenos + vDetalle[45].bajan_llenos;
      }

      // Usamos unshift en vez de push para mantener el orden cronológico original (los más viejos arriba)
      trips.unshift({
        idViaje: row[0],
        chofer: chofer,
        tipoViaje: tipoViaje,
        fechaSalida: fmt(fSalida, 'dd/MM'),
        horaSalida: fmt(hSalida, 'HH:mm'),
        cargaLabel: cargaLabel,
        isLate: false, 
        sDetails: { l10: sL10, v10: sV10, l15: sL15, v15: sV15, l45: sL45, v45: sV45 },
        sugerencia: sug,            
        totalEntregas: totalEntregas,
        kmSalida: row[24] || 0 // Por si lo usás en la UI
      });
    }
  }
  return trips;
}

// Variable global para cachear BD1 durante la ejecución y matar el problema N+1
let CACHE_BD1_DATA = null;


function calcularVentas_Carga(chofer, fechaSalida, horaSalida, idViajeStr) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const idViajeTarget = String(idViajeStr || '').trim().toUpperCase(); 
  const n = (val) => Number(val) || 0;

  function crearTimestamp(fecha, hora) {
    try {
      let anio, mes, dia, h = 0, m = 0, s = 0;
      if (fecha instanceof Date) {
        anio = fecha.getFullYear(); mes = fecha.getMonth(); dia = fecha.getDate();
      } else {
        const partesF = String(fecha).split(' ')[0].split(/[-/]/);
        if (partesF[0] && partesF[0].length === 4) { anio = partesF[0]; mes = partesF[1]-1; dia = partesF[2]; } 
        else if (partesF.length === 3) { dia = partesF[0]; mes = partesF[1]-1; anio = partesF[2]; }
        else return 0;
      }
      if (hora instanceof Date) {
        h = hora.getHours(); m = hora.getMinutes(); s = hora.getSeconds();
      } else {
        const partesH = String(hora).trim().split(':');
        h = partesH[0] || 0; m = partesH[1] || 0; s = partesH[2] || 0;
      }
      return new Date(anio, mes, dia, h, m, s).getTime();
    } catch(e) { return 0; }
  }

  const res = { 
    10: { bajan_llenos: 0, suben_vacios: 0 }, 
    15: { bajan_llenos: 0, suben_vacios: 0 }, 
    45: { bajan_llenos: 0, suben_vacios: 0 } 
  };

  // Si por algún motivo nos llega vacío el ID, cortamos por lo sano para no sumar basura.
  if (!idViajeTarget) return res;

  // =======================================================
  // OPTIMIZACIÓN N+1: Usar caché global para no leer BD1 varias veces
  // =======================================================
  if (!CACHE_BD1_DATA) {
    const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
    if (!shBD1) return res;
    CACHE_BD1_DATA = shBD1.getDataRange().getValues();
  }
  
  const dataBD1 = CACHE_BD1_DATA;
  
  if (dataBD1.length < 3) return res;

  // Los encabezados reales en BD1 están en la Fila 2 (índice 1)
  const headers = dataBD1[1].map(h => String(h).toUpperCase().trim());
  const iF = headers.indexOf('FECHA'), iH = headers.indexOf('HORA'), iTipo = headers.indexOf('TIPO');
  const idxViaje = headers.indexOf('ID_VIAJE'); 

  const colALL = { 10: headers.indexOf('ALL10'), 15: headers.indexOf('ALL15'), 45: headers.indexOf('ALL45') };
  const colAV = { 10: headers.indexOf('AV10'), 15: headers.indexOf('AV15'), 45: headers.indexOf('AV45') };

  const tSalida = crearTimestamp(fechaSalida, horaSalida);
  
  // FRENO DE MANO: 3 días (72hs) para atrás desde la salida.
  const tCorte = tSalida - (3 * 24 * 60 * 60 * 1000);
  const MAX_FILAS = 300; // Freno extra solicitado
  let lineasProcesadas = 0;

  // Leemos de abajo hacia arriba hasta la fila 3 (índice 2)
  for (let i = dataBD1.length - 1; i >= 2; i--) {
    const tOp = crearTimestamp(dataBD1[i][iF], dataBD1[i][iH]);
    
    // Si la operación es más vieja que la fecha de corte, matamos el bucle. 
    // Chau tiempos de carga largos.
    if (tOp > 0 && tOp < tCorte) break;
    
    // FRENO EXTRA: Límite de filas escaneadas
    if (lineasProcesadas >= MAX_FILAS) break;
    lineasProcesadas++;

    const vID = idxViaje > -1 ? String(dataBD1[i][idxViaje]).trim().toUpperCase() : '';
    
    // VINCULACIÓN ESTRICTA: Solo sumamos si el ID es exactamente el mismo.
    if (vID === idViajeTarget) {
      const tipo = iTipo > -1 ? String(dataBD1[i][iTipo]).toUpperCase().trim() : '';

      [10, 15, 45].forEach(k => {
        let cantBajan = colALL[k] > -1 ? n(dataBD1[i][colALL[k]]) : 0;
        let cantSuben = colAV[k] > -1 ? n(dataBD1[i][colAV[k]]) : 0;
        
        if (tipo === 'VENTA' || tipo === 'FLOTANTE') {
            res[k].bajan_llenos += cantBajan;
            res[k].suben_vacios += cantSuben;
        } else if (tipo === 'CONSIGNACION' || tipo === 'VENTA_ENVASE' || tipo === 'COMODATO') {
            res[k].bajan_llenos += cantBajan;
        } else if (tipo === 'RECUPERO') {
            res[k].suben_vacios += cantSuben;
        }
      });
    }
  }

  return res;
}
  
function getTimestamp_Carga(f, h) {
  if (!f) return 0;
  
  let baseMs = 0;
  
  // A. Obtener fecha base (sin hora)
  if (Object.prototype.toString.call(f) === '[object Date]') {
    let temp = new Date(f.getTime());
    temp.setHours(0,0,0,0);
    baseMs = temp.getTime();
  } else if (typeof f === 'string') {
    // Asume DD/MM/YYYY
    const p = f.split('/');
    if (p.length === 3) {
      // Mes es base 0 en JS
      baseMs = new Date(p[2], p[1]-1, p[0]).getTime();
    }
  }
  
  if (!baseMs) return 0;

  // B. Sumar horas y minutos
  let addMs = 0;
  if (h) {
    if (Object.prototype.toString.call(h) === '[object Date]') {
      addMs = (h.getHours() * 3600000) + (h.getMinutes() * 60000);
    } else if (typeof h === 'string') {
      const ph = h.split(':');
      if (ph.length >= 2) {
        addMs = (Number(ph[0]) * 3600000) + (Number(ph[1]) * 60000);
      }
    }
  }

  return baseMs + addMs;
}


// =======================================================
// 5. HELPER FECHA BRUTA (CORREGIDO "WALL TIME")
// =======================================================


function getTimestamp_Bruto(f, h) {
  if (!f) return 0;
  
  let year = 0, month = 0, day = 0;
  let hours = 0, minutes = 0;

  // A. Extraer partes de FECHA
  if (Object.prototype.toString.call(f) === '[object Date]') {
    year = f.getFullYear();
    month = f.getMonth();
    day = f.getDate();
  } else if (typeof f === 'string') {
    const p = f.split('/'); // DD/MM/YYYY
    if (p.length === 3) {
      year = Number(p[2]); month = Number(p[1]) - 1; day = Number(p[0]);
    }
  }

  // B. Extraer partes de HORA
  if (h) {
    if (Object.prototype.toString.call(h) === '[object Date]') {
      hours = h.getHours();
      minutes = h.getMinutes();
    } else if (typeof h === 'string') {
      const ph = h.split(':'); // HH:mm
      if (ph.length >= 2) {
        hours = Number(ph[0]); minutes = Number(ph[1]);
      }
    }
  }

  // C. Construir fecha nueva LIMPIA
  if (year === 0) return 0;
  return new Date(year, month, day, hours, minutes, 0).getTime();
}


// ---> NUEVA FUNCIÓN AUXILIAR (El bisturí de la memoria)usa CCARGA <---
function leerBloqueOptimizado(ss, nombreHoja, fechaCorte) {
  const sh = ss.getSheetByName(nombreHoja);
  if (!sh) return [];

  const lr = sh.getLastRow();
  const lc = sh.getLastColumn();
  if (lr <= 2) return [[]]; // Solo encabezados o vacía

  // Matemática precisa: 100 registros por día aprox. 
  // Usamos 150 como factor de seguridad + 1000 filas de colchón
  const dias = Math.max(1, Math.ceil((new Date().getTime() - fechaCorte.getTime()) / (1000*60*60*24)));
  const filasNecesarias = (dias * 150) + 1000;

  // CIRUGÍA: Buscamos los títulos SÍ o SÍ en la Fila 2
  const headers = sh.getRange(2, 1, 1, lc).getValues()[0];

  // Si nos piden más filas de las que hay (descontando fila 1 y fila 2)
  if (filasNecesarias >= lr - 2) {
    // Traemos toda la data desde la fila 3 hasta el final
    const data = sh.getRange(3, 1, lr - 2, lc).getValues();
    return [headers].concat(data);
  }

  // Traemos solo el bloque final y lo unimos con los títulos
  const filaInicio = lr - filasNecesarias + 1;
  const data = sh.getRange(filaInicio, 1, filasNecesarias, lc).getValues();

  return [headers].concat(data);
}


// ============================================================
// ----- FUNCIÓN PARA OBTENER OPCIONES DE LA HOJA 'DATOS' -----
// ============================================================


function getOptionsData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName("DATOS");
  
  // Si no existe la hoja, devolvemos vacíos
  if (!sheet) return { status: 'success', zonas: [], categorias: [], productos: [] };

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return { status: 'success', zonas: [], categorias: [], productos: [] };

  // Leemos 3 columnas: A (Zonas), B (Categorías), C (Productos)
  // getRange(fila2, col1, hastaFondo, 3cols)
  const data = sheet.getRange(2, 1, lastRow - 1, 3).getValues();
  
  let zonas = new Set();
  let categorias = new Set();
  let productos = new Set();

  data.forEach(row => {
    // Columna A: Zonas
    if (row[0] && String(row[0]).trim() !== "") {
      zonas.add(String(row[0]).trim().toUpperCase());
    }
    // Columna B: Categorías
    if (row[1] && String(row[1]).trim() !== "") {
      categorias.add(String(row[1]).trim().toUpperCase());
    }
    // Columna C: Productos / Envases (NUEVO)
    if (row[2] && String(row[2]).trim() !== "") {
      productos.add(String(row[2]).trim().toUpperCase());
    }
  });

  return { 
    status: "success",
    zonas: Array.from(zonas).sort(), 
    categorias: Array.from(categorias).sort(),
    productos: Array.from(productos).sort()
  };
}

function guardarPrecioIndividual(p) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const cat = String(p.categoria || '').toUpperCase().trim();
  let tipo = String(p.tipo || '').toUpperCase().trim();
  const valorIngresado = Number(p.precio);

  if (!cat || !tipo) return { status: 'error', message: 'Faltan datos (Categoría o Tipo)' };

  // ---> DESVÍO QUIRÚRGICO: Recargo Flotante va a hoja DATOS, celda H2 <---
  if (cat === 'SISTEMA' && tipo === 'RECARGO_FLOTANTE') {
    let shDatos = ss.getSheetByName('DATOS');
    if (!shDatos) return { status: 'error', message: 'No existe hoja DATOS' };
    
    shDatos.getRange(2, 8).setValue(valorIngresado); // Fila 2, Columna 8 (H2)
    return { status: 'success' };
  }

  let sh = ss.getSheetByName('PRECIOS');
  
  if (!sh) return { status: 'error', message: 'No existe hoja PRECIOS' };

  const data = sh.getDataRange().getValues();
  const ahora = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm');

  // 1. Detectar si lo que llega es una comisión
  let esComision = false;
  if (tipo.startsWith('COM')) {
    esComision = true;
    tipo = tipo.replace('COM', '').trim(); // Transforma "COM10" -> "10"
  }

  let filasActualizadas = 0;

  // 2. Recorremos la base de datos
  for (let i = 1; i < data.length; i++) {
    const rowCat = String(data[i][0] || '').toUpperCase().trim();
    const rowTipo = String(data[i][1] || '').toUpperCase().trim();
    
    if (rowCat === cat) {
      let coincidencia = false;
      
      if (esComision) {
        // REGLA: Si es comisión de "10", impacta en "10" y "ENV10". Columna E es la 5.
        if (rowTipo === tipo || rowTipo === 'ENV' + tipo) {
           sh.getRange(i + 1, 5).setValue(valorIngresado); // Guarda en Comision (E)
           sh.getRange(i + 1, 4).setValue(ahora);          // Actualiza fecha (D)
           coincidencia = true;
        }
      } else {
        // Es un precio normal. Columna C es la 3.
        if (rowTipo === tipo) {
           sh.getRange(i + 1, 3).setValue(valorIngresado); // Guarda en Precio (C)
           sh.getRange(i + 1, 4).setValue(ahora);          // Actualiza fecha (D)
           coincidencia = true;
        }
      }

      if (coincidencia) filasActualizadas++;
    }
  }

  // 3. Manejo de filas nuevas
  if (filasActualizadas === 0) {
    if (esComision) {
      return { status: 'error', message: 'No se encontró el producto base para asignar esta comisión.' };
    } else {
      // Si es un producto totalmente nuevo, lo crea al final
      sh.appendRow([cat, tipo, valorIngresado, ahora, '']);
    }
  }

  return { status: 'success' };
}


// =======================================================
// 10. PROTOCOLO SOMBRA (EDICIÓN SEGURA Y PIN) - CORREGIDO
// =======================================================


function modifyTransaction(k, type, id, pin, dataObj) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  // const sheetUser = ss.getSheetByName("USUARIOS"); // Ya no lo necesitamos aquí directamente
  let sheetData = ss.getSheetByName('CONFINANZAS');
  
  if (!sheetData) return { status: 'error', message: 'No existe la hoja CONFINANZAS' };

  // --- 1. VALIDACIÓN DE SEGURIDAD (CON ROTACIÓN Y LOG) ---
  
  // Obtenemos quién está intentando hacer la acción
  const datosSesion = obtenerDatosPorToken(k);
  const usuarioAccion = datosSesion.valido ? datosSesion.usuario : 'Desconocido';

  // 🔥 AQUÍ ESTÁ LA CLAVE: Llamamos a la función validadora 🔥
  // Esta función verifica contra U2, si es correcto ROTA U2 y guarda en el historial V-Y
  const autorizado = validarYRotarPin(
      usuarioAccion, 
      pin, 
      `MODIFICACION [${type}] ID:${id}` // Descripción para el historial en Columna X
  );

  if (!autorizado) {
      // Si el PIN no coincide con U2 ni T2, o ya se usó.
      return { status: 'error', message: 'PIN INVÁLIDO O YA UTILIZADO' };
  }

  // --- SI LLEGAMOS AQUÍ, EL PIN YA ROTÓ Y SE GUARDÓ EL HISTORIAL. PROCEDEMOS. ---

  // --- 2. BUSCAR REGISTRO (TextFinder) ---
  const finder = sheetData.getRange("A:A").createTextFinder(String(id).trim()).matchEntireCell(true);
  const result = finder.findNext();

  if (!result) return { status: 'error', message: 'Registro no encontrado (pero el PIN se usó)' };

  const realRow = result.getRow();
  if (realRow === 1) return { status: 'error', message: 'No se puede modificar el encabezado' };

  // --- 3. AUDITORÍA INTERNA (Mover a HISTORIAL_FINANZAS) ---
  // Esto es el backup de los datos antes de tocarlos
  const oldData = sheetData.getRange(realRow, 1, 1, 8).getValues()[0];
  const historialRow = [
    ...oldData,
    new Date(),
    type === 'DELETE' ? 'ELIMINADO' : 'MODIFICADO_PREVIO',
    usuarioAccion
  ];
  _getHistorialSheet().appendRow(historialRow);

  // --- 4. EJECUTAR ACCIÓN EN CONFINANZAS ---
  if (type === 'DELETE') {
    sheetData.deleteRow(realRow); 
    registrarAlarma("ELIMINACIÓN", `[ID:${id}] Eliminado por ${usuarioAccion}.`, usuarioAccion);
    
  } else if (type === 'UPDATE') {
    const d = dataObj;
    // Actualizamos columnas B a G (Indices 2 a 7, total 6 columnas)
    sheetData.getRange(realRow, 2, 1, 6).setValues([[
      d.fecha, d.nivel1, d.nivel2, d.nivel3, Number(d.monto), usuarioAccion
    ]]);
    registrarAlarma("MODIFICACIÓN", `[ID:${id}] Modificado por ${usuarioAccion}.`, usuarioAccion);
  }

  return { status: 'success' };
}

function changeMasterPin(k, oldPin, newPin) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetUser = ss.getSheetByName("USUARIOS");
  
  // Asegurar que existe columna 20 (T)
  if (sheetUser.getMaxColumns() < 20) {
      sheetUser.insertColumnsAfter(sheetUser.getMaxColumns(), 20 - sheetUser.getMaxColumns());
  }
  
  const currentPin = String(sheetUser.getRange(2, 20).getValue() || "").trim();
  
  // Si no hay PIN seteado, permitimos cambiarlo sin verificar el viejo (primer uso)
  if (currentPin !== "" && String(oldPin).trim() !== currentPin) {
    return { status: 'error', message: 'PIN Actual Incorrecto' };
  }
  
  sheetUser.getRange(2, 20).setValue(String(newPin).trim()); // Set T2
  
  const usuarioAccion = obtenerDatosPorToken(k).usuario || 'Sistema';
  registrarAlarma("SEGURIDAD", "Cambio de PIN MAESTRO realizado", usuarioAccion);
  
  return { status: 'success' };
}

function _getHistorialSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName('HISTORIAL_FINANZAS');
  if (!sh) {
    sh = ss.insertSheet('HISTORIAL_FINANZAS');
    // Cabeceras: Las 8 originales + 3 de Auditoría
    sh.appendRow([
      'ID_ORIGINAL', 'FECHA', 'RUBRO', 'SUBRUBRO', 'DETALLE', 'MONTO', 'USUARIO_CREADOR', 'FECHA_CREACION', // Datos originales
      'FECHA_ACCION', 'TIPO_ACCION', 'USUARIO_ACCION' // Datos de auditoría
    ]);
    // Darle un colorcito al encabezado para que se vea serio (Opcional)
    sh.getRange("A1:K1").setBackground("#333333").setFontColor("#ffffff").setFontWeight("bold");
  }
  return sh;
}


// ==========================================
// GESTIÓN DE PIN DINÁMICO (COLUMNAS S, T, U, V...)
// ==========================================


function verificarPermisoYObtenerPin(usuario) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('USUARIOS');
  const data = sh.getDataRange().getValues();
  
  let tienePermiso = false;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).toLowerCase().trim() === String(usuario).toLowerCase().trim()) {
      if (data[i][18] == 1) tienePermiso = true;
      break;
    }
  }

  if (tienePermiso) {
    let pinGlobal = String(sh.getRange(2, 21).getValue()); 
    if (!pinGlobal || pinGlobal.trim() === '') {
       pinGlobal = generarNuevoPin();
       sh.getRange(2, 21).setValue(pinGlobal);
    }
    return pinGlobal;
  }
  return null;
}

function validarYRotarPin(usuario, pinIngresado, accion) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('USUARIOS');
  
  // LEEMOS CELDA U2 (Pin Dinámico) y U4 (Pin Maestro Fijo) -> CORREGIDO
  const pinActual = String(sh.getRange(2, 21).getValue()).trim(); // U2
  const pinMaestro = String(sh.getRange(4, 21).getValue()).trim(); // U4
  
  const input = String(pinIngresado).trim();

  // Caso 1: PIN DINÁMICO CORRECTO -> EJECUTAR Y ROTAR
  if (input === pinActual && input !== '') {
      registrarHistorialPin(ss, usuario, accion, input);
      
      // Rotamos el PIN
      const nuevoPin = generarNuevoPin();
      sh.getRange(2, 21).setValue(nuevoPin); 
      
      // OBLIGAMOS a Google Sheets a guardar el dato ya mismo, sin demoras
      SpreadsheetApp.flush(); 
      
      return true;
  } 
  // Caso 2: PIN MAESTRO CORRECTO -> EJECUTAR SIN ROTAR
  else if (input === pinMaestro && input !== '') {
      registrarHistorialPin(ss, usuario, accion + " [MASTER]", input);
      return true;
  }
  
  return false;
}

function generarNuevoPin() {
  return Math.random().toString(36).substring(2, 6).toLowerCase(); 
}

function registrarHistorialPin(ss, usuario, accion, pinUsado) {
  const sh = ss.getSheetByName('USUARIOS');
  // Usamos columnas V, W, X, Y para el historial infinito
  // Buscamos la primera fila vacía en la columna V
  let lastRow = sh.getRange("V:V").getValues().filter(String).length + 1;
  if (lastRow < 2) lastRow = 2; // Empezar despues del encabezado
  
  const fecha = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
  
  sh.getRange(lastRow, 22).setValue(fecha);    // V: Fecha
  sh.getRange(lastRow, 23).setValue(usuario);  // W: Usuario Ejecutor
  sh.getRange(lastRow, 24).setValue(accion);   // X: Acción
  sh.getRange(lastRow, 25).setValue(pinUsado); // Y: Pin Usado
}

// Ya no repetimos la función generarNuevoPin() porque la definiste dos veces
// Ya no repetimos la función registrarHistorialPin() porque la definiste dos veces
    
function pedirPinSiCorresponde(checkbox, inputId) {
        const input = document.getElementById(inputId);
        // Ya no usamos spans de aviso individuales, usamos el global
        // const span = ... (borrar lógica vieja de spans si quieres limpiar código)

        if(checkbox.checked) {
            // Solo habilitamos el campo para editar precio
            input.removeAttribute('readonly'); 
            input.focus();
            input.select(); // Seleccionar texto para facilitar edición rápida
        } else {
            // Desmarcó: Volvemos a precio automático y bloqueamos
            input.setAttribute('readonly', true);
            actualizarPreciosAutomaticos();
        }
        
        // Revisamos si hay que mostrar el campo de PIN global
        verificarSiNecesitaPin();
}

function verificarSiNecesitaPin() {
        // Verificar si ALGUNO de los checks de precio manual está activo
        const necesita = 
            document.getElementById('manualPriceCheck1').checked ||
            document.getElementById('manualPriceCheck2').checked ||
            document.getElementById('manualPriceCheck3').checked ||
            document.getElementById('precioAutorizadoCheck').checked;

        const container = document.getElementById('globalPinContainer');
        const pinInput = document.getElementById('globalPinInput');

        if (necesita) {
            container.style.display = 'block';
            pinInput.setAttribute('required', 'true');
        } else {
            container.style.display = 'none';
            pinInput.value = ''; // Limpiar si ya no es necesario
            pinInput.removeAttribute('required');
        }
        
        // Validamos el botón guardar de nuevo por si falta el PIN
        // (Aunque la validación final se hace al clickear)
}

function inyectarIDsClientes() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CLIENTES');
  
  if (!sh) {
    SpreadsheetApp.getUi().alert("Mierda, no encuentro la hoja CLIENTES.");
    return;
  }

  const data = sh.getDataRange().getValues();
  if (data.length < 2) return;

  let actualizados = 0;
  
  // Recorremos desde la fila 2 (índice 1)
  for (let i = 1; i < data.length; i++) {
    const idActual = String(data[i][0]).trim(); // Columna A (ID_CLIENTE)
    const nombre = String(data[i][2]).trim();   // Columna C (NOMBRE - asumiendo que empujaste todo 2 lugares)
    
    // Si la celda del ID está vacía pero hay un cliente anotado ahí...
    if (idActual === '' && nombre !== '') {
      // Generamos un hash de 4 letras/números (Ej: CL-A8F2)
      const nuevoID = 'CL-' + Math.random().toString(36).substring(2, 6).toUpperCase();
      
      // Lo clavamos en la Columna A de esa fila
      sh.getRange(i + 1, 1).setValue(nuevoID);
      actualizados++;
    }
  }
  
  SpreadsheetApp.getUi().alert(`¡Listo el pollo! Se inyectaron ${actualizados} IDs nuevos.`);
}


// =======================================================
// HELPER: RASTREADOR DE VIAJE ACTIVO
// =======================================================


function obtenerViajeActivo(chofer) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('CCARGA');
  if (!sh) return 'SIN_CAMION';
  const data = sh.getDataRange().getValues();
  const choferClean = String(chofer).toUpperCase().trim();
  
  for (let i = data.length - 1; i >= 1; i--) {
    const est = String(data[i][1]).trim();
    if ((est === 'EN_RUTA' || est === 'COMPRA_EN_RUTA') && String(data[i][2]).toUpperCase().trim() === choferClean) {
      return String(data[i][0]).trim(); 
    }
  }
  // Si no hay camión en ruta, le ponemos esta etiqueta en vez de dejarlo vacío
  return 'SIN_CAMION';
}

//tambien usa BD1 para ver cuentas corrientes

function obtenerDeudasPendientes() {
  try {
    const deudas = {};
    // AHORA LEE SOLO DE LA HOJA UNIFICADA
    const hojaFlotantes = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('SALDOS_FLOTANTES');
    
    if (hojaFlotantes) {
      const datos = hojaFlotantes.getDataRange().getValues();
      if (datos.length > 1) {
        const h = datos[0].map(x => String(x).trim().toUpperCase());
        const iId = h.indexOf('ID_CLIENTE');
        let iCli = h.indexOf('CLIENTE_NOMBRE'); if(iCli === -1) iCli = h.indexOf('CLIENTE');
        
        const i10 = h.indexOf('SALDO_10');
        const i15 = h.indexOf('SALDO_15');
        const i45 = h.indexOf('SALDO_45');
        const iDin = h.indexOf('SALDO_DINERO');
        
        for (let i = 1; i < datos.length; i++) {
           const key = (iId > -1 && datos[i][iId]) ? String(datos[i][iId]).trim() : (iCli > -1 ? String(datos[i][iCli]).trim() : '');
           if (!key) continue;
           
           const s10 = i10 > -1 ? (Number(datos[i][i10]) || 0) : 0;
           const s15 = i15 > -1 ? (Number(datos[i][i15]) || 0) : 0;
           const s45 = i45 > -1 ? (Number(datos[i][i45]) || 0) : 0;
           const sDinSucia = iDin > -1 ? String(datos[i][iDin]) : "0";
           const sDin = parseFloat(sDinSucia.replace(/[^\d.-]/g, '')) || 0;

           if (s10 !== 0 || s15 !== 0 || s45 !== 0 || sDin !== 0) {
              // Regla de signos: Positivo = Deuda (env o plata) | Negativo = A favor (flotante)
              deudas[key] = { 
                  env10: s10 > 0 ? s10 : 0, env_10: s10 > 0 ? s10 : 0, 
                  env15: s15 > 0 ? s15 : 0, env_15: s15 > 0 ? s15 : 0, 
                  env45: s45 > 0 ? s45 : 0, env_45: s45 > 0 ? s45 : 0, 
                  plata: sDin > 0 ? sDin : 0, deuda_dinero: sDin > 0 ? sDin : 0, 
                  
                  // Math.abs convierte el negativo en positivo para que el HTML lo lea bien
                  flotante10: s10 < 0 ? Math.abs(s10) : 0, 
                  flotante15: s15 < 0 ? Math.abs(s15) : 0, 
                  flotante45: s45 < 0 ? Math.abs(s45) : 0 
              };
           }
        }
      }
    }

    return deudas;
  } catch(e) {
    return {};
  }
}

function registrarMovimientoFlotante(params, idCliente, nombreCliente, usuario, fecha, hora, d10, d15, d45, movDinero, idTurno) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let shSaldos = ss.getSheetByName('SALDOS_FLOTANTES');
    let shHistorial = ss.getSheetByName('HISTORIAL_FLOTANTES');
    
    if (!shSaldos || !shHistorial) return;

    let saldo10 = d10, saldo15 = d15, saldo45 = d45, saldoDinero = movDinero;
    const datosSaldos = shSaldos.getDataRange().getValues();
    let filaEncontrada = -1;
    
    const hS = datosSaldos.length > 0 ? datosSaldos[0].map(x => String(x).trim().toUpperCase()) : [];
    const iId = hS.indexOf('ID_CLIENTE');
    const iCli = hS.indexOf('CLIENTE_NOMBRE');
    const i10 = hS.indexOf('SALDO_10');
    const i15 = hS.indexOf('SALDO_15');
    const i45 = hS.indexOf('SALDO_45');
    const iDin = hS.indexOf('SALDO_DINERO');
    const iUlt = hS.indexOf('ULTIMA_ACTUALIZACION');

    if (datosSaldos.length > 1) {
        for(let i = 1; i < datosSaldos.length; i++) {
            const rowId = iId > -1 ? String(datosSaldos[i][iId]).trim() : '';
            const rowNom = iCli > -1 ? String(datosSaldos[i][iCli]).trim() : '';
            
            // Busca por ID o por Nombre
            if ((idCliente !== '' && rowId === String(idCliente).trim()) || 
                (idCliente === '' && rowNom === String(nombreCliente).trim())) {
                filaEncontrada = i + 1;
                saldo10 += (Number(datosSaldos[i][i10]) || 0);
                saldo15 += (Number(datosSaldos[i][i15]) || 0);
                saldo45 += (Number(datosSaldos[i][i45]) || 0);
                saldoDinero += (parseFloat(String(datosSaldos[i][iDin]).replace(/[^\d.-]/g, '')) || 0);
                break;
            }
        }
    }

    if (filaEncontrada !== -1) {
        if (i10 > -1) shSaldos.getRange(filaEncontrada, i10 + 1).setValue(saldo10);
        if (i15 > -1) shSaldos.getRange(filaEncontrada, i15 + 1).setValue(saldo15);
        if (i45 > -1) shSaldos.getRange(filaEncontrada, i45 + 1).setValue(saldo45);
        if (iDin > -1) shSaldos.getRange(filaEncontrada, iDin + 1).setValue(saldoDinero);
        if (iUlt > -1) shSaldos.getRange(filaEncontrada, iUlt + 1).setValue(fecha + ' ' + hora);
    } else {
        const nuevaFila = new Array(hS.length).fill('');
        if (iId > -1) nuevaFila[iId] = idCliente;
        if (iCli > -1) nuevaFila[iCli] = nombreCliente;
        if (i10 > -1) nuevaFila[i10] = saldo10;
        if (i15 > -1) nuevaFila[i15] = saldo15;
        if (i45 > -1) nuevaFila[i45] = saldo45;
        if (iDin > -1) nuevaFila[iDin] = saldoDinero;
        if (iUlt > -1) nuevaFila[iUlt] = fecha + ' ' + hora;
        shSaldos.appendRow(nuevaFila);
    }

    let tipoMov = "MOVIMIENTO_MIXTO";
    if (movDinero < 0) tipoMov = "PAGO_DEUDA";
    else if (movDinero > 0 && d10 === 0 && d15 === 0 && d45 === 0) tipoMov = "DEUDA_NUEVA";
    else if (d10 > 0 || d15 > 0 || d45 > 0) tipoMov = "RECIBE_VACIOS";
    else if (d10 < 0 || d15 < 0 || d45 < 0) tipoMov = "CONSUME_FLOTANTE";

    const idTransaccion = 'F-' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd-HHmmss');
    const notas = `Ref Op: ${params.N || 'S/N'} | ${idTurno || ''}`;

    shHistorial.appendRow([idTransaccion, fecha, hora, usuario, idCliente, nombreCliente, tipoMov, d10, d15, d45, movDinero, notas]);
  } catch(e) {}
}

function actualizarCuentaCorriente(params, idCliente, nombreCliente, usuario, fechaHora, idViaje, idTurno) {
  // --- PATOVICA: Si es cliente flotante, esta función NO lo atiende. Van por SALDOS_FLOTANTES ---
  if (String(params.esFlotante).toLowerCase() === 'true') return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let shCta = ss.getSheetByName('CTA_CTE_ENVASES');
  let shHist = ss.getSheetByName('HISTORIAL_CTA_CTE');

  if (!shHist) {
    shHist = ss.insertSheet('HISTORIAL_CTA_CTE');
    shHist.appendRow(['FECHA_HORA', 'ID_CLIENTE', 'CLIENTE', 'TIPO_MOVIMIENTO', 'ENV_10', 'ENV_15', 'ENV_45', 'DINERO', 'USUARIO', 'VIAJE_REF', 'TIPO', 'ID_TURNO']);
  }

  if (!shCta) {
    shCta = ss.insertSheet('CTA_CTE_ENVASES');
    shCta.appendRow(['ID_CLIENTE', 'CLIENTE', 'ENV_10', 'ENV_15', 'ENV_45', 'DEUDA_DINERO', 'ESTADO', 'ULTIMA_ACTUALIZACION']);
  }

  // Si no pasamos idTurno (ej: desde otra función), lo buscamos como plan B
  if (!idTurno) { try { idTurno = getTurnoAbierto(); } catch(e) { idTurno = ''; } }

  const n = (val) => Number(val) || 0;

  // Variables base (para el cálculo final neto de la cuenta corriente)
  let sum10 = params.operacionEnvase === 'comodato' ? n(params.comodato10) : 0;
  let sum15 = params.operacionEnvase === 'comodato' ? n(params.comodato15) : 0;
  let sum45 = params.operacionEnvase === 'comodato' ? n(params.comodato45) : 0;
  let sumPlata = params.operacionEnvase === 'consignacion' ? n(params.deudaConsignacion) : 0;

  let dev10 = 0, dev15 = 0, dev45 = 0, pagoPlata = 0;

  // Si hubo cobro o recuperación, se restan del neto de la CTA CTE
  if (params.esPagoDeuda === 'true' || params.esPagoDeuda === true) {
     dev10 = n(params.dev10);
     dev15 = n(params.dev15);
     dev45 = n(params.dev45);
     pagoPlata = n(params.pagoDeudaDinero);
     
     sum10 -= dev10;
     sum15 -= dev15;
     sum45 -= dev45;
     sumPlata -= pagoPlata;
  }

  // Si no se movió ni un pelo, nos vamos
  if (sum10 === 0 && sum15 === 0 && sum45 === 0 && sumPlata === 0 && dev10 === 0 && dev15 === 0 && dev45 === 0 && pagoPlata === 0) return; 

  // =========================================================================
  // 1. SISTEMA DE HISTORIAL DESDOBLADO (EL NUEVO "SEMÁFORO" CLARO)
  // =========================================================================
  
  // A. PAGOS / DEVOLUCIONES (Separados en dos líneas, con etiqueta estricta)
  if (params.esPagoDeuda === 'true' || params.esPagoDeuda === true) {
    // Línea 1: Pago de plata (Achica deuda de CONSIGNACION)
    if (pagoPlata > 0) {
      shHist.appendRow([fechaHora, idCliente, nombreCliente, "PAGO", 0, 0, 0, pagoPlata, usuario, idViaje || '', "CONSIGNACION", idTurno]);
    }
    // Línea 2: Devolución de envases físicos (Achica deuda de COMODATO)
    if (dev10 > 0 || dev15 > 0 || dev45 > 0) {
      shHist.appendRow([fechaHora, idCliente, nombreCliente, "DEVOLUCION", dev10, dev15, dev45, 0, usuario, idViaje || '', "COMODATO", idTurno]);
    }
  }

  // B. NUEVAS DEUDAS (Unificadas para que no dupliquen líneas, con etiqueta estricta)
  if (params.operacionEnvase === 'comodato' || params.operacionEnvase === 'consignacion') {
    let gen10 = n(params.comodato10);
    let gen15 = n(params.comodato15);
    let gen45 = n(params.comodato45);
    let genPlata = n(params.deudaConsignacion);

    if (genPlata > 0 || gen10 > 0 || gen15 > 0 || gen45 > 0) {
      let tipoOp = params.operacionEnvase.toUpperCase(); // Escribirá exactamente 'COMODATO' o 'CONSIGNACION'
      shHist.appendRow([fechaHora, idCliente, nombreCliente, "DEUDA", gen10, gen15, gen45, genPlata, usuario, idViaje || '', tipoOp, idTurno]);
    }
  }
  // =========================================================================

  // 2. BUSCAR AL CLIENTE Y ACTUALIZAR O BORRAR EN CUENTA CORRIENTE (La Foto)
  const data = shCta.getDataRange().getValues();
  const headers = data[0].map(h => String(h).trim().toUpperCase());
  
  const idxId = headers.indexOf('ID_CLIENTE');
  let idxCli = headers.indexOf('CLIENTE'); if(idxCli === -1) idxCli = headers.indexOf('NOMBRE');
  let idx10 = headers.indexOf('ENV_10'); if(idx10 === -1) idx10 = headers.indexOf('ENV10');
  let idx15 = headers.indexOf('ENV_15'); if(idx15 === -1) idx15 = headers.indexOf('ENV15');
  let idx45 = headers.indexOf('ENV_45'); if(idx45 === -1) idx45 = headers.indexOf('ENV45');
  let idxDeuda = headers.indexOf('DEUDA_DINERO'); if(idxDeuda === -1) idxDeuda = headers.indexOf('DINERO');
  const idxEst = headers.indexOf('ESTADO');
  const idxUlt = headers.indexOf('ULTIMA_ACTUALIZACION');

  let filaEncontrada = -1;
  for (let i = 1; i < data.length; i++) {
     const rowId = idxId > -1 ? String(data[i][idxId]).trim() : '';
     const rowCli = idxCli > -1 ? String(data[i][idxCli]).trim() : '';
     if ((idCliente !== '' && rowId === idCliente) || (idCliente === '' && rowCli === nombreCliente)) {
        filaEncontrada = i + 1;
        break;
     }
  }

  if (filaEncontrada > -1) {
     // SI EXISTE: Leemos y calculamos nuevos saldos
     const act10 = Math.max(0, n(shCta.getRange(filaEncontrada, idx10 + 1).getValue()) + sum10);
     const act15 = Math.max(0, n(shCta.getRange(filaEncontrada, idx15 + 1).getValue()) + sum15);
     const act45 = Math.max(0, n(shCta.getRange(filaEncontrada, idx45 + 1).getValue()) + sum45);
     const plataVieja = parseFloat(String(shCta.getRange(filaEncontrada, idxDeuda + 1).getValue()).replace(/[^\d.-]/g, '')) || 0;
     const actPlata = Math.max(0, plataVieja + sumPlata);
     
     // Si quedó en 0 todo, borramos la fila (limpieza automática)
     if (act10 === 0 && act15 === 0 && act45 === 0 && actPlata === 0) {
         shCta.deleteRow(filaEncontrada);
     } else {
         if (idx10 > -1) shCta.getRange(filaEncontrada, idx10 + 1).setValue(act10);
         if (idx15 > -1) shCta.getRange(filaEncontrada, idx15 + 1).setValue(act15);
         if (idx45 > -1) shCta.getRange(filaEncontrada, idx45 + 1).setValue(act45);
         if (idxDeuda > -1) shCta.getRange(filaEncontrada, idxDeuda + 1).setValue(actPlata);
         if (idxEst > -1) shCta.getRange(filaEncontrada, idxEst + 1).setValue('PENDIENTE');
         if (idxUlt > -1) shCta.getRange(filaEncontrada, idxUlt + 1).setValue(fechaHora);
     }
  } else {
     // SI ES NUEVO (Y los saldos netos generados no son 0)
     if (Math.max(0, sum10) > 0 || Math.max(0, sum15) > 0 || Math.max(0, sum45) > 0 || Math.max(0, sumPlata) > 0) {
         const nuevaFila = new Array(headers.length).fill('');
         if (idxId > -1) nuevaFila[idxId] = idCliente;
         if (idxCli > -1) nuevaFila[idxCli] = nombreCliente;
         if (idx10 > -1) nuevaFila[idx10] = Math.max(0, sum10);
         if (idx15 > -1) nuevaFila[idx15] = Math.max(0, sum15);
         if (idx45 > -1) nuevaFila[idx45] = Math.max(0, sum45);
         if (idxDeuda > -1) nuevaFila[idxDeuda] = Math.max(0, sumPlata);
         if (idxEst > -1) nuevaFila[idxEst] = 'PENDIENTE';
         if (idxUlt > -1) nuevaFila[idxUlt] = fechaHora;
         shCta.appendRow(nuevaFila);
     }
  }
}


// =======================================================
// 11. MÓDULO DE CAUCIONES (LA BÓVEDA DE GARANTÍAS)
// =======================================================


function _getCaucionesSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName('CAUCIONES');
  if (!sh) {
    sh = ss.insertSheet('CAUCIONES');
    sh.appendRow([
      'ID_CAUCION', 'FECHA_ALTA', 'CLIENTE', 'ENV_10', 'ENV_15', 'ENV_45', 
      'MONTO_GARANTIA', 'ESTADO', 'FECHA_CIERRE', 'USUARIO', 'OBSERVACIONES'
    ]);
  }
  return sh;
}

function crearCaucion(params, usuario) {
  // --- PEAJE DE SEGURIDAD ---
  const idTurno = getTurnoAbierto();

  const sh = _getCaucionesSheet();
  const id = 'CAU-' + Utilities.getUuid().slice(0, 6).toUpperCase();
  const fechaAlta = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss');
  
  const n = (v) => Number(v) || 0;
  const monto = n(params.montoGarantia);
  const cliente = String(params.cliente || 'Consumidor Final').trim().toUpperCase();

  sh.appendRow([
    id, fechaAlta, cliente, n(params.env10), n(params.env15), n(params.env45), monto, 'ACTIVA', '', usuario, params.observaciones || '', idTurno // <--- ESTAMPA TURNO
  ]);

  registrarAlarma('NUEVA_CAUCION', `Caja debe recibir $${monto} por caución de ${cliente}.`, usuario);
  return { status: 'success', message: 'Caución creada. ID: ' + id, idTurno: idTurno };
}

function cerrarCaucion(params, usuario) {
  const sh = _getCaucionesSheet();
  const data = sh.getDataRange().getValues();
  const idBuscado = String(params.idCaucion).trim();

  let rowIndex = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === idBuscado) {
      rowIndex = i + 1;
      break;
    }
  }

  if (rowIndex === -1) return { status: 'error', message: 'Caución no encontrada' };

  const rowData = data[rowIndex - 1];
  if (String(rowData[7]).trim() === 'FINALIZADA') return { status: 'error', message: 'Esta caución ya fue cerrada' };

  const ahora = new Date();
  const fechaCierre = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss');
  const fechaCorta = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'dd/MM/yyyy');
  const horaCorta = Utilities.formatDate(ahora, Session.getScriptTimeZone(), 'HH:mm:ss');

  const n = (v) => Number(v) || 0;
  const prestado10 = n(rowData[3]), prestado15 = n(rowData[4]), prestado45 = n(rowData[5]);
  const garantia = n(rowData[6]);
  const cliente = rowData[2];

  // Datos que vienen del frontend cuando el cliente devuelve las cosas
  const dev10 = n(params.dev10), dev15 = n(params.dev15), dev45 = n(params.dev45);
  const montoDevueltoAlCliente = n(params.montoDevuelto); 
  const montoRetenido = garantia - montoDevueltoAlCliente; // Plata que nos quedamos por los cascos perdidos

  const faltan10 = Math.max(0, prestado10 - dev10);
  const faltan15 = Math.max(0, prestado15 - dev15);
  const faltan45 = Math.max(0, prestado45 - dev45);

  let obs = String(params.observaciones || '').trim();
  if (faltan10 > 0 || faltan15 > 0 || faltan45 > 0) {
     obs = `[PARCIAL] Retenido: $${montoRetenido} por falta de ${faltan10}x10, ${faltan15}x15, ${faltan45}x45. ` + obs;
  } else {
     obs = `[TOTAL] Todo devuelto OK. ` + obs;
  }

  // 1. Cerramos la caución en la hoja
  sh.getRange(rowIndex, 8).setValue('FINALIZADA');
  sh.getRange(rowIndex, 9).setValue(fechaCierre);
  sh.getRange(rowIndex, 11).setValue(obs);

  // 2. Si se quedó con envases, blanqueamos esa "venta" en BD1
  if (faltan10 > 0 || faltan15 > 0 || faltan45 > 0 || montoRetenido > 0) {
     const shBD1 = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('BD1') || SpreadsheetApp.getActiveSpreadsheet().getSheetByName('DB1');
     if (shBD1) {
         const dataVenta = {
           USUARIO: usuario,
           TIPO: 'CAUCION',
           FECHA: fechaCorta,
           HORA: horaCorta,
           C: cliente, N: '',
           'E$': montoRetenido, 'T$': 0, TOTAL: montoRetenido,
           G: `Cierre Caución ${idBuscado}`,
           // Mandamos en POSITIVO para que BD1 descuente el stock como si fuera una venta normal
           CE10: faltan10, 'CE10$': 0,
           CE15: faltan15, 'CE15$': 0,
           CE45: faltan45, 'CE45$': 0
         };
         // Usamos tu helper que ya tenías en Codigo.gs
         shBD1.appendRow(convertirObjetoAFila(dataVenta));
     }
  }

  // 3. Alarma para sacar la guita de la caja fuerte y dársela
  registrarAlarma('CIERRE_CAUCION', `Devolver $${montoDevueltoAlCliente} al cliente ${cliente}.`, usuario);

  return { status: 'success', message: 'Caución cerrada correctamente' };
}

function anularCaucion(params, usuario) {
  // El famoso "Ctrl+Z" si el chofer fue y rebotó (cliente no estaba o no quiso)
  const sh = _getCaucionesSheet();
  const data = sh.getDataRange().getValues();
  const idBuscado = String(params.idCaucion).trim();

  let rowIndex = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === idBuscado) {
      rowIndex = i + 1;
      break;
    }
  }

  if (rowIndex === -1) return { status: 'error', message: 'Caución no encontrada' };

  sh.getRange(rowIndex, 8).setValue('ANULADA');
  sh.getRange(rowIndex, 9).setValue(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss'));
  sh.getRange(rowIndex, 11).setValue('Rebotada / No concretada. Anulada por ' + usuario);

  registrarAlarma('CAUCION_ANULADA', `Caución ${idBuscado} anulada. No se debe cobrar la garantía.`, usuario);

  return { status: 'success', message: 'Caución anulada con éxito' };
}

function obtenerCaucionesActivas() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CAUCIONES');
  if (!sh) return { status: 'success', cauciones: [] };

  const data = sh.getDataRange().getValues();
  const activas = [];
  
  for (let i = 1; i < data.length; i++) {
    // Si la columna H (índice 7) dice ACTIVA, la mandamos al frontend
    if (String(data[i][7]).trim() === 'ACTIVA') {
      activas.push({
        id: data[i][0],
        fecha: data[i][1],
        cliente: data[i][2],
        env10: data[i][3],
        env15: data[i][4],
        env45: data[i][5],
        monto: data[i][6]
      });
    }
  }
  return { status: 'success', cauciones: activas };
}


// =======================================================
// 12. MÓDULO DE AUDITORÍA DE TRANSFERENCIAS (HOME BANKING)
// =======================================================


function ajustarMontosTransferencia(row, nuevoE, nuevoT, usuario) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('BD1') || SpreadsheetApp.getActiveSpreadsheet().getSheetByName('DB1');
  if (!sh) return { status: 'error', message: 'No se encontró la base de datos.' };

  const headers = sh.getRange(2, 1, 1, sh.getLastColumn()).getValues()[0].map(h => String(h).toUpperCase().trim());
  
  const colE = headers.indexOf('E$');
  const colT = headers.indexOf('T$');
  const colTotal = headers.indexOf('TOTAL');
  const colArq = headers.indexOf('ARQUEO_ID');

  if (colE === -1 || colT === -1 || colTotal === -1) {
      return { status: 'error', message: 'Faltan columnas de montos en BD1.' };
  }

  // Candado de Seguridad: Verificamos en el servidor que no haya sido arqueada
  if (colArq > -1) {
      const estadoArqueo = String(sh.getRange(row, colArq + 1).getValue()).trim();
      if (estadoArqueo !== '' && estadoArqueo !== 'S/D') {
          return { status: 'error', message: 'ACCESO DENEGADO: Esta operación ya fue arqueada.' };
      }
  }

  const valE = Number(nuevoE) || 0;
  const valT = Number(nuevoT) || 0;
  const valTotal = valE + valT; // Recalculamos el total exacto

  // Inyectamos los nuevos montos en BD1
  sh.getRange(row, colE + 1).setValue(valE);
  sh.getRange(row, colT + 1).setValue(valT);
  sh.getRange(row, colTotal + 1).setValue(valTotal);

  // Dejamos una huella en el detalle del banco para la auditoría
  let colDetalle = headers.indexOf('DETALLE_BANCO');
  if (colDetalle === -1) { 
      colDetalle = headers.length; 
      sh.getRange(2, colDetalle + 1).setValue('DETALLE_BANCO'); 
  }
  
  const notaAjuste = `[AJUSTADO por ${usuario} | E:$${valE} T:$${valT}]`;
  const actualDetalle = String(sh.getRange(row, colDetalle + 1).getValue());
  if (!actualDetalle.includes("AJUSTADO")) {
      sh.getRange(row, colDetalle + 1).setValue(notaAjuste + " " + actualDetalle);
  }

  return { status: 'success', message: 'Montos actualizados correctamente.' };
}

function getTransferencias(modo, fechaInicio, fechaFin) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('BD1') || SpreadsheetApp.getActiveSpreadsheet().getSheetByName('DB1');
  if (!sh) return [];
  
  const data = sh.getDataRange().getValues();
  if (data.length < 3) return [];

  const headers = data[1].map(h => String(h).toUpperCase().trim());
  
  // Verifica si existen las columnas de control, si no, las crea solitas
  let colVerificado = headers.indexOf('VERIFICADO_BANCO');
  if (colVerificado === -1) { colVerificado = headers.length; sh.getRange(2, colVerificado + 1).setValue('VERIFICADO_BANCO'); }
  
  let colDetalle = headers.indexOf('DETALLE_BANCO');
  if (colDetalle === -1) { colDetalle = headers.length; sh.getRange(2, colDetalle + 1).setValue('DETALLE_BANCO'); }
  
  const n = (val) => Number(val) || 0;
  const colT = headers.indexOf('T$');
  const colE = headers.indexOf('E$');
  const colTotal = headers.indexOf('TOTAL');
  const colU = headers.indexOf('USUARIO');
  const colF = headers.indexOf('FECHA');
  const colH = headers.indexOf('HORA');
  const colC = headers.indexOf('C');
  const colViaje = headers.indexOf('ID_VIAJE');
  const colArq = headers.indexOf('ARQUEO_ID');
  const colTipo = headers.indexOf('TIPO');

  if (colT === -1) return [];

  const result = [];
  const start = fechaInicio ? new Date(fechaInicio + 'T00:00:00') : new Date('2000-01-01');
  const end = fechaFin ? new Date(fechaFin + 'T23:59:59') : new Date('2100-01-01');

  for (let i = 2; i < data.length; i++) {
      const montoT = n(data[i][colT]);
      
      if (montoT > 0) {
          const estadoFirma = String(data[i][colVerificado]).trim();
          const detalleGuardado = String(data[i][colDetalle] || '').trim();
          const isAprobado = estadoFirma.startsWith('OK:');
          
          if (modo === 'PENDIENTES' && isAprobado) continue; 
          if (modo === 'HISTORIAL' && !isAprobado) continue;

          const dtObj = parseDateTime(data[i][colF], data[i][colH]);
          const dt = dtObj || new Date();
          
          if (modo === 'PENDIENTES' || (dt >= start && dt <= end)) {
              const fechaGrupo = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd/MM/yyyy');

              result.push({
                  row: i + 1,
                  fechaCorta: fechaGrupo,
                  hora: Utilities.formatDate(dt, Session.getScriptTimeZone(), 'HH:mm'),
                  chofer: data[i][colU],
                  cliente: data[i][colC],
                  tipoOp: data[i][colTipo] || 'VENTA',
                  montoT: montoT,
                  montoE: n(data[i][colE]),
                  montoTotal: n(data[i][colTotal]),
                  viaje: data[i][colViaje] || 'S/D',
                  arqueo: data[i][colArq] || 'S/D',
                  firma: isAprobado ? estadoFirma : '',
                  detalleBanco: detalleGuardado
              });
          }
      }
  }
  return result.reverse(); 
}

function updateTransferenciaBatch(rowsDataStr, accion, usuarioAuditor) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('BD1') || SpreadsheetApp.getActiveSpreadsheet().getSheetByName('DB1');
  const headers = sh.getRange(2, 1, 1, sh.getLastColumn()).getValues()[0].map(h => String(h).toUpperCase().trim());
  
  let colVerificado = headers.indexOf('VERIFICADO_BANCO');
  if (colVerificado === -1) { colVerificado = headers.length; sh.getRange(2, colVerificado + 1).setValue('VERIFICADO_BANCO'); }

  let colDetalle = headers.indexOf('DETALLE_BANCO');
  if (colDetalle === -1) { colDetalle = headers.length; sh.getRange(2, colDetalle + 1).setValue('DETALLE_BANCO'); }
  
  // Índices para capturar los datos necesarios para CONFINANZAS
  const idxChofer = headers.indexOf('USUARIO');
  const idxFecha = headers.indexOf('FECHA');
  let idxCliente = headers.indexOf('NOMBRE CLIENTE');
  if (idxCliente === -1) idxCliente = headers.indexOf('C'); // Fallback
  const idxE = headers.indexOf('E$');
  const idxT = headers.indexOf('T$');
  const idxTotal = headers.indexOf('TOTAL');

  const finSh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('CONFINANZAS');
  
  const rowsData = JSON.parse(rowsDataStr || '[]');
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm');

  // Procesa de a varias filas juntas
  rowsData.forEach(item => {
      const row = Number(item.row);
      const rowData = sh.getRange(row, 1, 1, sh.getLastColumn()).getValues()[0];
      
      if (accion === 'APROBAR') {
          const chofer = rowData[idxChofer] || 'S/D';
          const cliente = rowData[idxCliente] || 'S/D';
          const fechaStr = rowData[idxFecha] || '';
          const mE = parseFloat(rowData[idxE]) || 0;
          const mT = parseFloat(rowData[idxT]) || 0;
          const mTotal = parseFloat(rowData[idxTotal]) || 0;

          let firma = `OK: ${usuarioAuditor} - ${timestamp}`;

          // Solo aplica descuento y carga el capital si hay transferencia y existe la hoja CONFINANZAS
          if (mT > 0 && finSh) {
              const idOp = Utilities.getUuid().slice(0, 8);
              const impuesto = mT * 0.006;
              const notaUsuario = item.detalle ? ` ${item.detalle}` : '';
              const detalleTexto = `transferencia recibida ${fechaStr} | ${chofer} | ${cliente} Tot$${mTotal} Ef$${mE} Tr$${mT}${notaUsuario}`;

              // 1. Grabar el INGRESO de la Transferencia
              finSh.appendRow([
                  idOp,
                  fechaStr,
                  'GAS',
                  'TRANSFERENCIA',
                  detalleTexto,
                  mT,
                  usuarioAuditor,
                  new Date(),
                  'INGRESO'
              ]);

              // 2. Grabar el EGRESO del Impuesto
              finSh.appendRow([
                  idOp,
                  fechaStr,
                  'CUENTA BANCARIA',
                  'IMPUESTO LEY 25413',
                  detalleTexto,
                  impuesto,
                  usuarioAuditor,
                  new Date(),
                  'EGRESO'
              ]);
              
              firma = `OK: ${usuarioAuditor} - [${idOp}] ${timestamp}`;
          }

          sh.getRange(row, colVerificado + 1).setValue(firma);
          sh.getRange(row, colDetalle + 1).setValue(item.detalle || '');
          
      } else if (accion === 'REVERTIR') {
          // Leer la celda para extraer el ID
          const celdaVerificado = String(rowData[colVerificado] || '');
          const matchId = celdaVerificado.match(/\[(.*?)\]/);
          
          if (matchId && matchId[1] && finSh) {
              const idBuscado = matchId[1];
              const dataFin = finSh.getDataRange().getValues();
              // Búsqueda inversa para borrar sin romper el índice
              for (let i = dataFin.length - 1; i >= 1; i--) {
                  if (String(dataFin[i][0]) === idBuscado) {
                      finSh.deleteRow(i + 1);
                      // Ojo: acá le sacamos el "break;" para que siga subiendo y borre TANTO el ingreso como el impuesto.
                  }
              }
          }

          sh.getRange(row, colVerificado + 1).clearContent();
          sh.getRange(row, colDetalle + 1).clearContent();
      }
  });
  
  return { status: 'success', message: `${rowsData.length} operación(es) procesada(s)` };
}

function updateTransferenciaStatus(row, accion, usuarioAuditor) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('BD1') || SpreadsheetApp.getActiveSpreadsheet().getSheetByName('DB1');
  const headers = sh.getRange(2, 1, 1, sh.getLastColumn()).getValues()[0].map(h => String(h).toUpperCase().trim());
  
  let colVerificado = headers.indexOf('VERIFICADO_BANCO');
  if (colVerificado === -1) {
      colVerificado = headers.length;
      sh.getRange(2, colVerificado + 1).setValue('VERIFICADO_BANCO');
  }
  
  const idxChofer = headers.indexOf('USUARIO');
  const idxFecha = headers.indexOf('FECHA');
  let idxCliente = headers.indexOf('NOMBRE CLIENTE');
  if (idxCliente === -1) idxCliente = headers.indexOf('C');
  const idxE = headers.indexOf('E$');
  const idxT = headers.indexOf('T$');
  const idxTotal = headers.indexOf('TOTAL');

  const finSh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('CONFINANZAS');
  const rowData = sh.getRange(row, 1, 1, sh.getLastColumn()).getValues()[0];

  if (accion === 'APROBAR') {
      const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm');
      const chofer = rowData[idxChofer] || 'S/D';
      const cliente = rowData[idxCliente] || 'S/D';
      const fechaStr = rowData[idxFecha] || '';
      const mE = parseFloat(rowData[idxE]) || 0;
      const mT = parseFloat(rowData[idxT]) || 0;
      const mTotal = parseFloat(rowData[idxTotal]) || 0;

      let firma = `OK: ${usuarioAuditor} - ${timestamp}`;

      if (mT > 0 && finSh) {
          const idOp = Utilities.getUuid().slice(0, 8);
          const impuesto = mT * 0.006;
          const detalleTexto = `transferencia recibida ${fechaStr} | ${chofer} | ${cliente} Tot$${mTotal} Ef$${mE} Tr$${mT}`;

          // 1. Grabar el INGRESO de la Transferencia
          finSh.appendRow([
              idOp, fechaStr, 'GAS', 'TRANSFERENCIA', detalleTexto, mT, usuarioAuditor, new Date(), 'INGRESO'
          ]);

          // 2. Grabar el EGRESO del Impuesto
          finSh.appendRow([
              idOp, fechaStr, 'CUENTA BANCARIA', 'IMPUESTO LEY 25413', detalleTexto, impuesto, usuarioAuditor, new Date(), 'EGRESO'
          ]);
          
          firma = `OK: ${usuarioAuditor} - [${idOp}] ${timestamp}`;
      }

      sh.getRange(row, colVerificado + 1).setValue(firma);
      return { status: 'success', message: 'Aprobada' };
      
  } else if (accion === 'REVERTIR') {
      const celdaVerificado = String(rowData[colVerificado] || '');
      const matchId = celdaVerificado.match(/\[(.*?)\]/);
      
      if (matchId && matchId[1] && finSh) {
          const idBuscado = matchId[1];
          const dataFin = finSh.getDataRange().getValues();
          for (let i = dataFin.length - 1; i >= 1; i--) {
              if (String(dataFin[i][0]) === idBuscado) {
                  finSh.deleteRow(i + 1);
                  // También sin "break;" acá
              }
          }
      }

      sh.getRange(row, colVerificado + 1).clearContent();
      return { status: 'success', message: 'Revertida a Pendiente' };
  }
  
  return { status: 'error', message: 'Acción inválida' };
}


function FIX_HOJA_CARGA() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CCARGA');
  if (!sh) return;
  
  const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(h => String(h).toUpperCase().trim());
  
  // Buscamos si existe la columna, sino la creamos al final
  let idxTipo = headers.indexOf('TIPO_VIAJE');
  if (idxTipo === -1) {
    idxTipo = headers.length;
    sh.getRange(1, idxTipo + 1).setValue('TIPO_VIAJE');
  }
  
  // Recorremos los viajes y si alguno no tiene tipo, le clavamos 'REPARTO'
  const data = sh.getDataRange().getValues();
  for(let i = 1; i < data.length; i++) {
     if(String(data[i][idxTipo] || '').trim() === '') {
         sh.getRange(i + 1, idxTipo + 1).setValue('REPARTO');
     }
  }
}

function generarIdFinanzas() {
  return Math.floor(Math.random() * 0xFFFFFFFF).toString(16).padStart(8, '0').toLowerCase();
}

function getComprasAuditar(startStr, endStr) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CCARGA');
  const shDatos = ss.getSheetByName('DATOS'); 
  
  let retencionLey = 121;
  let saldoProveedor = 0;
  
  if (shDatos) {
      const dataDatos = shDatos.getRange("F1:G2").getValues();
      if(dataDatos[0][0] === 'RETENCION_LEY') retencionLey = Number(dataDatos[1][0]) || 0;
      if(dataDatos[0][1] === 'SALDO_PROVEEDOR') saldoProveedor = Number(dataDatos[1][1]) || 0;
  }

  if (!sh) return { pendientes: [], historial: [], retencionLey: retencionLey, saldoProveedor: saldoProveedor };
  const data = sh.getDataRange().getValues();
  if (data.length < 2) return { pendientes: [], historial: [], retencionLey: retencionLey, saldoProveedor: saldoProveedor };

  const headers = data[0].map(h => String(h).toUpperCase().trim());
  const col = (name) => headers.indexOf(name);
  const colLast = (name) => headers.lastIndexOf(name); 

  const cEst   = col('ESTADO');
  const cChof  = col('CHOFER');
  const cFLleg = colLast('FECHA_SAL'); 
  const cHLleg = colLast('HORA_SAL');  
  const cL10   = col('S_V10');
  const cL15   = col('S_V15');
  const cL45   = col('S_V45');
  const cTipo  = col('TIPO_VIAJE');
  const cRem   = col('REMITO'); 
  const cFac   = col('FACTURA');
  const cP10   = col('PRECIO_10'); 
  const cP15   = col('PRECIO_15');
  const cP45   = col('PRECIO_45');
  const cConc  = col('CONCILIADO');
  
  const cUConc = col('USUARIO_CONCILIA');
  const cFConc = col('FECHA_CONCILIA');
  const cUMod  = col('USUARIO_MODIFICA');
  const cFMod  = col('FECHA_MODIFICA');
  const cIvaP  = col('IVA_PORC');
  const cPercP = col('PERC_PORC');
  const cPDep  = col('PAGO_DEPOSITO');
  const cPTr   = col('PAGO_TRANSF');
  const cODep  = col('OP_DEPO');
  const cOTr   = col('OP_TRANSF');

  const start = startStr ? new Date(startStr + 'T00:00:00') : new Date('2000-01-01');
  const end = endStr ? new Date(endStr + 'T23:59:59') : new Date('2100-01-01');

  const pendientes = [];
  const historial = [];

  for (let i = data.length - 1; i >= 1; i--) {
    const row = data[i];
    const estado = cEst > -1 ? String(row[cEst] || '').toUpperCase().trim() : '';
    const tipoViaje = cTipo > -1 ? String(row[cTipo] || '').toUpperCase().trim() : '';
    const conciliado = cConc > -1 ? String(row[cConc] || '').toUpperCase().trim() : '';

    const esCompra = (estado === 'COMPRA_FINALIZADA') || 
                     (tipoViaje === 'COMPRA' && estado === 'CON_DIFERENCIA') ||
                     (tipoViaje === 'COMPRA' && estado === 'FINALIZADO');

    if (esCompra) {
      let dtLlegada = new Date();
      if (cFLleg > -1 && row[cFLleg]) {
          const p = String(row[cFLleg]).split('/');
          if (p.length === 3) dtLlegada = new Date(p[2], p[1]-1, p[0]);
          else dtLlegada = new Date(row[cFLleg]);
      }

      const obj = {
        idViaje: row[0],
        chofer: cChof > -1 ? row[cChof] : '',
        fecha: (cFLleg > -1 && row[cFLleg]) ? Utilities.formatDate(dtLlegada, Session.getScriptTimeZone(), 'dd/MM/yyyy') : '',
        horaLlegada: (cHLleg > -1 && row[cHLleg]) ? Utilities.formatDate(new Date(row[cHLleg]), Session.getScriptTimeZone(), 'HH:mm') : '',
        remito: cRem > -1 ? String(row[cRem] || '') : '',
        ll10: cL10 > -1 ? Number(row[cL10]) || 0 : 0,
        ll15: cL15 > -1 ? Number(row[cL15]) || 0 : 0,
        ll45: cL45 > -1 ? Number(row[cL45]) || 0 : 0,
        tsLlegada: dtLlegada.getTime()
      };

      if (conciliado !== 'SI') {
        pendientes.push(obj);
      } else {
        if (dtLlegada >= start && dtLlegada <= end) {
            obj.factura = cFac > -1 ? String(row[cFac] || '') : '';
            obj.p10 = cP10 > -1 ? Number(row[cP10]) || 0 : 0;
            obj.p15 = cP15 > -1 ? Number(row[cP15]) || 0 : 0;
            obj.p45 = cP45 > -1 ? Number(row[cP45]) || 0 : 0;
            
            const rawIva = cIvaP > -1 ? row[cIvaP] : 0;
            obj.ivaPorc = (rawIva instanceof Date) ? 0 : (Number(rawIva) || 0);
            
            const rawPerc = cPercP > -1 ? row[cPercP] : 0;
            obj.percPorc = (rawPerc instanceof Date) ? 0 : (Number(rawPerc) || 0);
            
            obj.pagoDepo = cPDep > -1 ? Number(row[cPDep]) || 0 : 0;
            obj.pagoTransf = cPTr > -1 ? Number(row[cPTr]) || 0 : 0;
            obj.opDepo = cODep > -1 ? String(row[cODep] || '') : '';
            obj.opTransf = cOTr > -1 ? String(row[cOTr] || '') : '';
            
            obj.uConc = cUConc > -1 ? String(row[cUConc] || '') : '';
            obj.fConc = cFConc > -1 && row[cFConc] ? String(row[cFConc]) : '';
            obj.uMod = cUMod > -1 ? String(row[cUMod] || '') : '';
            obj.fMod = cFMod > -1 && row[cFMod] ? String(row[cFMod]) : '';
            
            historial.push(obj);
        }
      }
    }
  }
  return { pendientes: pendientes, historial: historial, retencionLey: retencionLey, saldoProveedor: saldoProveedor };
}

function conciliarLoteCompras(p, auditor) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const shCarga = ss.getSheetByName('CCARGA');
  const hFinanzas = ss.getSheetByName('CONFINANZAS');
  const hDatos = ss.getSheetByName('DATOS');
  
  if (!shCarga) return { status: 'error', message: 'No se encontró la hoja CCARGA' };
  
  const remitos = JSON.parse(p.remitos);
  const pagos = JSON.parse(p.pagos);
  const retencionLey = Number(p.retencionLey) || 0;
  const nuevoSaldo = Number(p.nuevoSaldo) || 0;
  
  const ahoraStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm');
  const fechaSolaStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy');
  
  // Texto resumen de operaciones para inyectar en CCARGA (Compatibilidad con el sistema viejo)
  let textoOpDepo = pagos.depositos.map(d => `D:$${d.monto}(${d.ref})`).join(' | ');
  let textoOpTransf = pagos.transferencias.map(t => `T:$${t.monto}(${t.ref})`).join(' | ');
  
  // Texto detallado para CONFINANZAS
  let detallePagosGlobal = "PAGOS: ";
  if (pagos.depositos.length > 0) detallePagosGlobal += pagos.depositos.map(d => `Dep. N°${d.ref} ($${d.monto})`).join(', ') + ". ";
  if (pagos.transferencias.length > 0) detallePagosGlobal += pagos.transferencias.map(t => `Transf. N°${t.ref} ($${t.monto})`).join(', ');

  const dataCarga = shCarga.getDataRange().getValues();
  const headers = dataCarga[0].map(h => String(h).toUpperCase().trim());
  const getCol = (name) => {
      let idx = headers.indexOf(name);
      if (idx === -1) { headers.push(name); idx = headers.length - 1; shCarga.getRange(1, idx + 1).setValue(name); }
      return idx + 1; 
  };
  
  const cFac  = getCol('FACTURA'); const cP10  = getCol('PRECIO_10'); const cP15  = getCol('PRECIO_15');
  const cP45  = getCol('PRECIO_45'); const cConc = getCol('CONCILIADO'); const cUCon = getCol('USUARIO_CONCILIA');
  const cFCon = getCol('FECHA_CONCILIA'); const cIvaP = getCol('IVA_PORC'); const cPercP= getCol('PERC_PORC');
  const cPDep = getCol('PAGO_DEPOSITO'); const cPTr  = getCol('PAGO_TRANSF'); const cODep = getCol('OP_DEPO');
  const cOTr  = getCol('OP_TRANSF'); const cLL10 = getCol('L_L10'); const cLL15 = getCol('L_L15');
  const cLL45 = getCol('L_L45'); const cRem = getCol('REMITO');

  let filasAGrabarFinanzas = [];
  let fHeaders = [];
  if (hFinanzas) {
      fHeaders = hFinanzas.getRange(1, 1, 1, hFinanzas.getLastColumn()).getValues()[0].map(h => String(h).toUpperCase().trim());
  }
  
  // SOLUCIÓN 1: Mantenemos el monto positivo y le agregamos la columna TIPO = 'EGRESO'
  const crearFilaFinanzas = (subrubro, detalleTxt, montoBruto, rubroOverride = 'GAS') => {
      let fila = new Array(fHeaders.length).fill('');
      const colId = fHeaders.indexOf('ID'); if(colId > -1) fila[colId] = generarIdFinanzas ? generarIdFinanzas() : Utilities.getUuid().slice(0,8).toUpperCase();
      const colFecha = fHeaders.indexOf('FECHA'); if(colFecha > -1) fila[colFecha] = fechaSolaStr;
      const colRubro = fHeaders.indexOf('RUBRO'); if(colRubro > -1) fila[colRubro] = rubroOverride;
      const colSub = fHeaders.indexOf('SUBRUBRO'); if(colSub > -1) fila[colSub] = subrubro;
      const colDet = fHeaders.indexOf('DETALLE'); if(colDet > -1) fila[colDet] = detalleTxt;
      
      // Monto positivo absoluto
      const colMonto = fHeaders.indexOf('MONTO'); if(colMonto > -1) fila[colMonto] = Math.abs(montoBruto);
      
      const colUsu = fHeaders.indexOf('USUARIO'); if(colUsu > -1) fila[colUsu] = auditor;
      const colTs = fHeaders.indexOf('TIMESTAMP'); if(colTs > -1) fila[colTs] = ahoraStr;
      
      // Agregamos el identificador EGRESO a la columna TIPO (si existe)
      const colTipo = fHeaders.indexOf('TIPO'); if(colTipo > -1) fila[colTipo] = 'EGRESO';

      return fila;
  };

  // Iterar por cada remito seleccionado
  remitos.forEach(r => {
      // Buscar la fila exacta en CCARGA (bucle inverso por rendimiento)
      let rowIndex = -1;
      for (let i = dataCarga.length - 1; i >= 1; i--) {
          if (String(dataCarga[i][0]) === String(r.idViaje)) { rowIndex = i + 1; break; }
      }
      
      if (rowIndex > -1) {
          // 1. IMPACTO EN CCARGA
          shCarga.getRange(rowIndex, cLL10).setValue(r.ll10);
          shCarga.getRange(rowIndex, cLL15).setValue(r.ll15);
          shCarga.getRange(rowIndex, cLL45).setValue(r.ll45);
          shCarga.getRange(rowIndex, cFac).setValue(String(r.factura).trim());
          shCarga.getRange(rowIndex, cP10).setValue(r.p10);
          shCarga.getRange(rowIndex, cP15).setValue(r.p15);
          shCarga.getRange(rowIndex, cP45).setValue(r.p45);
          shCarga.getRange(rowIndex, cIvaP).setValue(r.iva);
          shCarga.getRange(rowIndex, cPercP).setValue(r.perc);
          
          shCarga.getRange(rowIndex, cODep).setValue(textoOpDepo);
          shCarga.getRange(rowIndex, cOTr).setValue(textoOpTransf);
          
          shCarga.getRange(rowIndex, cConc).setValue('SI');
          shCarga.getRange(rowIndex, cUCon).setValue(auditor);
          shCarga.getRange(rowIndex, cFCon).setValue(ahoraStr);
          
          // SOLUCIÓN 2: Forzamos a Google Sheets a escribir los datos de este remito AHORA MISMO
          // antes de pasar al siguiente remito en el bucle.
          SpreadsheetApp.flush();
          
          const remitoNum = String(dataCarga[rowIndex - 1][cRem - 1] || 'S/N');
          
          // 2. IMPACTO EN CONFINANZAS (Desglosado)
          if (hFinanzas) {
              const subtotal = (r.p10 * r.ll10) + (r.p15 * r.ll15) + (r.p45 * r.ll45);
              const ivaMonto = subtotal * (r.iva / 100);
              const percMonto = subtotal * (r.perc / 100);
              const totalFactura = subtotal + ivaMonto + percMonto;
              
              if (subtotal > 0) {
                  let detCompra = `Remito: ${remitoNum} | Fac: ${r.factura} | 10KG: $${(r.p10*r.ll10).toFixed(2)} 15KG: $${(r.p15*r.ll15).toFixed(2)} 45KG: $${(r.p45*r.ll45).toFixed(2)} | Subtotal: $${subtotal.toFixed(2)}. ${detallePagosGlobal}`;
                  filasAGrabarFinanzas.push(crearFilaFinanzas('COMPRA', detCompra, subtotal));
              }
              if (ivaMonto > 0) {
                  let detIva = `Remito: ${remitoNum} | Fac: ${r.factura} | Total Fac: $${totalFactura.toFixed(2)} | IVA Inscripto ${r.iva}%: $${ivaMonto.toFixed(2)}`;
                  filasAGrabarFinanzas.push(crearFilaFinanzas('IVA_Inscripto', detIva, ivaMonto));
              }
              if (percMonto > 0) {
                  let detPerc = `Remito: ${remitoNum} | Fac: ${r.factura} | Total Fac: $${totalFactura.toFixed(2)} | Percepción IVA ${r.perc}%: $${percMonto.toFixed(2)}`;
                  filasAGrabarFinanzas.push(crearFilaFinanzas('IVA_Percepción', detPerc, percMonto));
              }
          }
      }
  });

  // 3. IMPACTO DE RETENCIONES EN CONFINANZAS (Por cada transferencia real)
  if (hFinanzas && retencionLey > 0) {
      pagos.transferencias.forEach(transf => {
          let detRet = `RETENCION TRANSFERENCIA DE COMPRA CAÑUELAS. Transf. N°${transf.ref} (Por $${transf.monto})`;
          filasAGrabarFinanzas.push(crearFilaFinanzas('RETENCION TRANSFERENCIA LEY', detRet, retencionLey, 'CUENTA BANCARIA'));
      });
  }

  // Grabar todo el paquete en Finanzas de un solo golpe (Hiper veloz)
  if (hFinanzas && filasAGrabarFinanzas.length > 0) {
      hFinanzas.getRange(hFinanzas.getLastRow() + 1, 1, filasAGrabarFinanzas.length, fHeaders.length).setValues(filasAGrabarFinanzas);
  }

  // 4. ACTUALIZAR MEMORIA (Hoja DATOS F2 y G2)
  if (hDatos) {
      hDatos.getRange("F2").setValue(retencionLey);
      hDatos.getRange("G2").setValue(nuevoSaldo);
  }

  return { status: 'success', message: 'Lote conciliado y guardado con éxito' };
}

function modificarCompra(p, auditor) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CCARGA');
  if (!sh) return { status: 'error', message: 'No se encontró la hoja CCARGA' };

  const data = sh.getDataRange().getValues();
  let rowIndex = -1;
  
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]) === p.idViaje) { rowIndex = i + 1; break; }
  }
  if (rowIndex === -1) return { status: 'error', message: 'Viaje no encontrado' };

  const headers = data[0].map(h => String(h).toUpperCase().trim());
  const getCol = (name) => {
      let idx = headers.indexOf(name);
      if (idx === -1) { 
          headers.push(name);
          idx = headers.length - 1; 
          sh.getRange(1, idx + 1).setValue(name); 
      }
      return idx + 1; 
  };

  const cFac  = getCol('FACTURA');
  const cP10  = getCol('PRECIO_10');
  const cP15  = getCol('PRECIO_15');
  const cP45  = getCol('PRECIO_45');
  const cUMod = getCol('USUARIO_MODIFICA'); 
  const cFMod = getCol('FECHA_MODIFICA'); 
  const cIvaP = getCol('IVA_PORC'); 
  const cPercP= getCol('PERC_PORC');
  const cPDep = getCol('PAGO_DEPOSITO');
  const cPTr  = getCol('PAGO_TRANSF');
  const cODep = getCol('OP_DEPO');
  const cOTr  = getCol('OP_TRANSF');
  const cLL10 = getCol('L_L10');
  const cLL15 = getCol('L_L15');
  const cLL45 = getCol('L_L45');

  const ll10 = Number(p.ll10) || 0;
  const ll15 = Number(p.ll15) || 0;
  const ll45 = Number(p.ll45) || 0;
  
  const p10 = Number(p.precio10) || 0;
  const p15 = Number(p.precio15) || 0;
  const p45 = Number(p.precio45) || 0;
  const ivaPorc = Number(p.ivaPorc) || 0;
  const percPorc = Number(p.percPorc) || 0;

  sh.getRange(rowIndex, cLL10).setValue(ll10);
  sh.getRange(rowIndex, cLL15).setValue(ll15);
  sh.getRange(rowIndex, cLL45).setValue(ll45);

  sh.getRange(rowIndex, cFac).setValue(String(p.factura).trim());
  sh.getRange(rowIndex, cP10).setValue(p10);
  sh.getRange(rowIndex, cP15).setValue(p15);
  sh.getRange(rowIndex, cP45).setValue(p45);
  sh.getRange(rowIndex, cIvaP).setValue(ivaPorc);
  sh.getRange(rowIndex, cPercP).setValue(percPorc);
  sh.getRange(rowIndex, cPDep).setValue(Number(p.pagoDepo) || 0);
  sh.getRange(rowIndex, cPTr).setValue(Number(p.pagoTransf) || 0);
  sh.getRange(rowIndex, cODep).setValue(String(p.opDepo).trim());
  sh.getRange(rowIndex, cOTr).setValue(String(p.opTransf).trim());
  
  sh.getRange(rowIndex, cUMod).setValue(auditor);
  sh.getRange(rowIndex, cFMod).setValue(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm'));

  const subtotal = (p10 * ll10) + (p15 * ll15) + (p45 * ll45);
  const ivaMonto = subtotal * (ivaPorc / 100);
  const percMonto = subtotal * (percPorc / 100);
  const factorImpuestos = subtotal > 0 ? 1 + ((ivaMonto + percMonto) / subtotal) : 1;

  const hDatos = ss.getSheetByName('DATOS');
  if (hDatos) {
    const dVals = hDatos.getDataRange().getValues();
    const headD = dVals[0].map(h => String(h).toUpperCase().trim());
    const idxTipo = headD.indexOf('TIPO_COSTO');
    const idxValor = headD.indexOf('VALOR_COSTO');
    
    if (idxTipo !== -1 && idxValor !== -1) {
      for (let i = 1; i < dVals.length; i++) {
        const tipo = String(dVals[i][idxTipo]).trim();
        if (tipo === '10' && p10 > 0) hDatos.getRange(i + 1, idxValor + 1).setValue(p10 * factorImpuestos);
        if (tipo === '15' && p15 > 0) hDatos.getRange(i + 1, idxValor + 1).setValue(p15 * factorImpuestos);
        if (tipo === '45' && p45 > 0) hDatos.getRange(i + 1, idxValor + 1).setValue(p45 * factorImpuestos);
      }
    }
  }

  if (typeof registrarAlarma === "function") {
      registrarAlarma('COMPRA_MODIFICADA', `El usuario ${auditor} modificó los datos de la compra ${p.idViaje}. Recordar ajustar manualmente la hoja CONFINANZAS.`, auditor);
  }
  
  return { status: 'success', message: 'Compra modificada correctamente. Recordá revisar CONFINANZAS.' };
}


// =======================================================
// NUEVO: MOTOR DE AUDITORÍA OPERATIVA (COMPRAS Y VENTAS)
// =======================================================


function getAuditoriaFinanzas(startStr, endStr) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const start = startStr ? new Date(startStr + 'T00:00:00') : new Date('2000-01-01');
  const end = endStr ? new Date(endStr + 'T23:59:59') : new Date('2100-01-01');
  const n = (val) => Number(val) || 0;

  // 1. COMPRAS (Desde CCARGA, solo las que ya pasaron por caja/conciliadas)
  const shCarga = ss.getSheetByName('CCARGA');
  const compras = [];
  if (shCarga) {
    const data = shCarga.getDataRange().getValues();
    const headers = data[0].map(h => String(h).toUpperCase().trim());
    const col = (name, fb) => { const i = headers.indexOf(name); return i > -1 ? i : fb; };
    
    const cChof = col('CHOFER', 2), cFLleg = col('FECHA_LLEG', 11);
    const cRem = col('REMITO_PLANTA', 25), cFac = col('FACTURA', 26);
    const cP10 = col('PRECIO_10', 27), cP15 = col('PRECIO_15', 28), cP45 = col('PRECIO_45', 29);
    const cConc = col('CONCILIADO', 30), cComp = col('COMPROBANTE_PAGO', 31);
    const cL10 = col('L_L10', 13), cL15 = col('L_L15', 15), cL45 = col('L_L45', 17);

    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      if (String(row[cConc]).toUpperCase().trim() === 'SI') {
         let dt = parseDateTime(row[cFLleg], null);
         if (dt && dt >= start && dt <= end) {
             let dtStrFmt = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd/MM/yyyy');
             const t10 = n(row[cL10]), t15 = n(row[cL15]), t45 = n(row[cL45]);
             const p10 = n(row[cP10]), p15 = n(row[cP15]), p45 = n(row[cP45]);
             compras.push({
                 idViaje: row[0], chofer: row[cChof], fecha: dtStrFmt,
                 remito: row[cRem], factura: row[cFac], comprobante: row[cComp],
                 montoTotal: (t10*p10) + (t15*p15) + (t45*p45),
                 detalleStr: `${t10} x 10kg | ${t15} x 15kg | ${t45} x 45kg`,
                 ts: dt.getTime()
             });
         }
      }
    }
  }

  // 2. VENTAS Y GASTOS (Desde BD1, agrupadas por Arqueo)
  const shBD1 = ss.getSheetByName('BD1') || ss.getSheetByName('DB1');
  const ventasMap = {};
  if (shBD1) {
     const data = shBD1.getDataRange().getValues();
     if (data.length > 2) {
       const headers = data[1].map(h => String(h).toUpperCase().trim()); 
       const col = (name) => headers.indexOf(name);
       
       const cF = col('FECHA'), cU = col('USUARIO'), cE = col('E$'), cT = col('T$');
       const cTot = col('TOTAL'), cArq = col('ARQUEO_ID'), cC = col('C'), cTipo = col('TIPO');
       const cUbic = col('UBICACION');
       
       for (let i = 2; i < data.length; i++) {
          const row = data[i];
          const arqueoId = String(row[cArq]).trim();
          const tipo = String(row[cTipo]).trim().toUpperCase();
          
          // ⚡ ACÁ DEJAMOS ENTRAR A LOS GASTOS
          if (arqueoId) { 
              let dt = parseDateTime(row[cF], null);
              
              if (dt && dt >= start && dt <= end) {
                  let dtStrFmt = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd/MM/yyyy');
                  let isGasto = tipo.includes('GAST');
                  
                  if (!ventasMap[arqueoId]) {
                      ventasMap[arqueoId] = {
                          idArqueo: arqueoId, chofer: row[cU], fecha: dtStrFmt,
                          totalE: 0, totalT: 0, totalNeto: 0, totalGastos: 0, operaciones: [], ts: dt.getTime()
                      };
                  }
                  
                  // Sumamos ingresos por un lado, y acumulamos gastos por otro para no romper el total
                  if (!isGasto) {
                      ventasMap[arqueoId].totalE += n(row[cE]);
                      ventasMap[arqueoId].totalT += n(row[cT]);
                      ventasMap[arqueoId].totalNeto += n(row[cTot]);
                  } else {
                      ventasMap[arqueoId].totalGastos += n(row[cTot]); 
                  }
                  
                  let linkGps = cUbic > -1 ? String(row[cUbic]).trim() : '';
                  
                  // Metemos detalle súper granular
                  ventasMap[arqueoId].operaciones.push({ 
                      cliente: isGasto ? (row[cC] || 'GASTO OPERATIVO') : (row[cC] || 'S/N'), 
                      monto: n(row[cTot]), 
                      montoE: n(row[cE]),
                      montoT: n(row[cT]),
                      tipo: tipo,
                      ubicacion: linkGps,
                      isGasto: isGasto
                  });
              }
          }
       }
     }
  }
  
  const ventas = Object.values(ventasMap).sort((a,b) => b.ts - a.ts);
  compras.sort((a,b) => b.ts - a.ts);
  
  return { status: 'success', compras, ventas };
}

function obtenerDatosTablero(startStr, endStr, view) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // 1. CHALECO ANTIBALAS PARA FECHAS
  let fStart = new Date('2000-01-01T00:00:00');
  let fEnd = new Date('2100-01-01T23:59:59');

  const esInvalido = (val) => !val || val === 'undefined' || val === 'null' || val === '';

  if (!esInvalido(startStr)) {
      fStart = parseDateTime(startStr, "00:00:00") || new Date(startStr + "T00:00:00");
      if (isNaN(fStart.getTime())) fStart = new Date('2000-01-01T00:00:00');
  }
  
  if (!esInvalido(endStr)) {
      fEnd = parseDateTime(endStr, "23:59:59") || new Date(endStr + "T23:59:59");
      if (isNaN(fEnd.getTime())) fEnd = new Date('2100-01-01T23:59:59');
  }

  const formatDay = (dObj) => Utilities.formatDate(dObj, "GMT-3", "dd/MM");

  let payload = {};

  // ==========================================
  // 💰 VISTA: FINANZAS
  // ==========================================
  if (view === 'finanzas') {
    // APLICACIÓN DEL BISTURÍ: Solo lee desde la fecha de inicio pedida
    const dataBD1 = leerBloqueOptimizado(ss, 'BD1', fStart);
    const dataConf = leerBloqueOptimizado(ss, 'CONFINANZAS', fStart);
    
    let ingresos = 0, egresos = 0;
    let diasMap = {}; 
    let gastosMap = {}; 
    let adeudados = [];

    for (let i = 1; i < dataBD1.length; i++) {
      let fStr = dataBD1[i][2];
      if (!fStr) continue;
      
      let dObj = parseDateTime(fStr, dataBD1[i][3]); 
      if (!dObj) continue;
      
      if (dObj >= fStart && dObj <= fEnd) {
        let monto = parseFloat(dataBD1[i][8]) || 0;
        let transf = parseFloat(dataBD1[i][7]) || 0;
        let verif = dataBD1[i][49] ? dataBD1[i][49].toString().trim() : '';
        
        if (dataBD1[i][1] === 'VENTA') {
           ingresos += monto;
           
           let diaKey = formatDay(dObj);
           if(!diasMap[diaKey]) diasMap[diaKey] = { in: 0, out: 0 };
           diasMap[diaKey].in += monto;

           if(transf > 0 && verif === '') {
              adeudados.push({
                 cliente: dataBD1[i][4],
                 fecha: formatDay(dObj),
                 monto: transf
              });
           }
        }
      }
    }

    for (let i = 1; i < dataConf.length; i++) {
      let fStr = dataConf[i][1];
      if (!fStr) continue;
      let dObj = parseDateTime(fStr, null);
      if (!dObj) continue;

      if (dObj >= fStart && dObj <= fEnd) {
         let monto = parseFloat(dataConf[i][5]) || 0;
         let rubro = dataConf[i][2] || 'Varios';
         let diaKey = formatDay(dObj);
         if(!diasMap[diaKey]) diasMap[diaKey] = { in: 0, out: 0 };

         if(monto < 0) { 
            let absMonto = Math.abs(monto);
            egresos += absMonto;
            diasMap[diaKey].out += absMonto;
            gastosMap[rubro] = (gastosMap[rubro] || 0) + absMonto;
         } else { 
            ingresos += monto;
            diasMap[diaKey].in += monto;
         }
      }
    }

    let sortedDays = Object.keys(diasMap).sort((a, b) => {
       let [d1, m1] = a.split('/'); let [d2, m2] = b.split('/');
       return new Date(`2026-${m1}-${d1}`) - new Date(`2026-${m2}-${d2}`); 
    });

    payload = {
       ingresos: ingresos,
       egresos: egresos,
       adeudados: adeudados,
       graficoEvolucion: {
           labels: sortedDays,
           datasets: [
               { label: 'Ingresos', data: sortedDays.map(d => diasMap[d].in), borderColor: '#2dd4bf', backgroundColor: 'rgba(45, 212, 191, 0.1)', fill: true, tension: 0.3 },
               { label: 'Egresos', data: sortedDays.map(d => diasMap[d].out), borderColor: '#ff4757', backgroundColor: 'transparent', tension: 0.3 }
           ]
       },
       graficoGastos: {
           labels: Object.keys(gastosMap),
           datasets: [{ data: Object.values(gastosMap), backgroundColor: ['#FFD700', '#ff9100', '#ff4757', '#a855f7', '#3b82f6', '#2dd4bf'], borderWidth: 0 }]
       }
    };
  }

  // ==========================================
  // 🚚 VISTA: OPERATIVA
  // ==========================================
  else if (view === 'operativa') {
    // Calculamos 6 meses para proteger los promedios
    const seisMesesAtras = new Date();
    seisMesesAtras.setMonth(seisMesesAtras.getMonth() - 6);
    const fechaCorteBD1 = new Date(Math.min(fStart.getTime(), seisMesesAtras.getTime()));

    // APLICACIÓN DEL BISTURÍ
    const dataBD1 = leerBloqueOptimizado(ss, 'BD1', fechaCorteBD1);
    const dataCarga = leerBloqueOptimizado(ss, 'CCARGA', fStart);
    
    // El padrón de clientes se lee entero porque no es cronológico
    const dataClientes = ss.getSheetByName('CLIENTES').getDataRange().getValues();

    const headersBD1 = dataBD1[0].map(h => String(h).toUpperCase().trim());
    let idxUbic = headersBD1.indexOf('UBICACION');

    // SOLUCIÓN MAPA: Si no encontró el título en la Fila 1, busca en la Fila 2
    if (idxUbic === -1 && dataBD1.length > 1) {
        const headersFila2 = dataBD1[1].map(h => String(h).toUpperCase().trim());
        idxUbic = headersFila2.indexOf('UBICACION');
    }

    let mapZonas = {};
    for (let i = 1; i < dataClientes.length; i++) { mapZonas[dataClientes[i][0]] = dataClientes[i][3] || 'S/D'; }

    let kilosTotales = 0, dineroKilos = 0;
    let u10 = 0, u15 = 0, u45 = 0;
    let chofMap = {};
    let zonaMap = {};
    let mapaCalor = []; 
    
    let p_bk = 0, p_pk = 0, p_u10 = 0, p_u15 = 0, p_u45 = 0;

    for (let i = 1; i < dataBD1.length; i++) {
      if (dataBD1[i][1] !== 'VENTA') continue;
      
      let fStr = dataBD1[i][2];
      if (!fStr) continue;
      let dObj = parseDateTime(fStr, dataBD1[i][3]);
      if (!dObj) continue;

      let c10 = parseInt(dataBD1[i][10]) || 0;
      let c15 = parseInt(dataBD1[i][11]) || 0;
      let c45 = parseInt(dataBD1[i][12]) || 0;
      let monto = parseFloat(dataBD1[i][8]) || 0;
      let chofer = dataBD1[i][0];
      let zona = mapZonas[dataBD1[i][46]] || 'S/D';
      
      if (dObj >= fStart && dObj <= fEnd) {
         u10 += c10; u15 += c15; u45 += c45;
         let kgLinea = (c10*10) + (c15*15) + (c45*45);
         kilosTotales += kgLinea;
         dineroKilos += monto;
         
         chofMap[chofer] = (chofMap[chofer] || 0) + monto;
         
         if(!zonaMap[zona]) zonaMap[zona] = { plata: 0, unid: 0 };
         zonaMap[zona].plata += monto;
         zonaMap[zona].unid += (c10+c15+c45);

         if (idxUbic > -1 && dataBD1[i][idxUbic]) {
             let link = String(dataBD1[i][idxUbic]);
             let match = link.match(/(-?\d{1,2}\.\d+),\s*(-?\d{1,2}\.\d+)/);
             if (match) {
                 mapaCalor.push([parseFloat(match[1]), parseFloat(match[2]), kgLinea || 10]); 
             }
         }
      }

      if (dObj >= seisMesesAtras) {
         p_u10 += c10; p_u15 += c15; p_u45 += c45;
         p_bk += (c10*10) + (c15*15);
         p_pk += (c45*45);
      }
    }

    let viajesTerminados = 0, dineroViajes = dineroKilos;
    let llevadosTotales = 0; 

    for(let i=1; i < dataCarga.length; i++){
       let fStr = dataCarga[i][3];
       if(!fStr) continue;
       let dObj = parseDateTime(fStr, dataCarga[i][4]);
       if(!dObj) continue;

       if(dObj >= fStart && dObj <= fEnd && dataCarga[i][23] !== 'COMPRA') { 
           viajesTerminados++; 
           llevadosTotales += (parseInt(dataCarga[i][5])||0) + (parseInt(dataCarga[i][7])||0) + (parseInt(dataCarga[i][9])||0);
       }
    }

    payload = {
       kilosTotales: kilosTotales,
       dineroKilos: dineroKilos,
       unidades: { '10kg': u10, '15kg': u15, '45kg': u45 },
       totalViajes: viajesTerminados,
       dineroViajes: dineroViajes,
       graficoEfectividad: { llevados: llevadosTotales, vendidos: (u10 + u15 + u45) },
       mapaCalor: mapaCalor,
       graficoMix: {
           labels: ['10kg', '15kg', '45kg'],
           datasets: [{ data: [u10, u15, u45], backgroundColor: ['#2dd4bf', '#3b82f6', '#FFD700'], borderWidth: 0 }]
       },
       graficoGases: {
           labels: ['Butano', 'Propano'],
           datasets: [{ data: [(u10*10 + u15*15), (u45*45)], backgroundColor: ['#a855f7', '#ff9100'], borderWidth: 0 }]
       },
       graficoChoferes: {
           labels: Object.keys(chofMap),
           datasets: [{ label: 'Ventas ($)', data: Object.values(chofMap), backgroundColor: '#FFD700', borderRadius: 4 }]
       },
       graficoZonas: {
           labels: Object.keys(zonaMap),
           datasets: [{ 
              label: 'Facturado ($)', 
              data: Object.values(zonaMap).map(z => z.plata), 
              unidades: Object.values(zonaMap).map(z => z.unid), 
              backgroundColor: '#a855f7', borderRadius: 4 
           }]
       },
       promedios: {
           semanal: { butanoKg: Math.round(p_bk/24), propanoKg: Math.round(p_pk/24), u10: Math.round(p_u10/24), u15: Math.round(p_u15/24), u45: Math.round(p_u45/24) },
           mensual: { butanoKg: Math.round(p_bk/6), propanoKg: Math.round(p_pk/6), u10: Math.round(p_u10/6), u15: Math.round(p_u15/6), u45: Math.round(p_u45/6) }
       }
    };
  }

  // ==========================================
  // ⚠️ VISTA: RIESGO Y STOCK
  // ==========================================
  else if (view === 'riesgo') {
    // Para esta vista necesitamos un rango razonable, 60 días atrás cubren remitos y deudas recientes
    const fechaCorteRiesgo = new Date(Date.now() - (60 * 24 * 60 * 60 * 1000));
    
    // APLICACIÓN DEL BISTURÍ
    const dataHistCte = leerBloqueOptimizado(ss, 'HISTORIAL_CTA_CTE', fechaCorteRiesgo);
    const dataBD1Riesgo = leerBloqueOptimizado(ss, 'BD1', fechaCorteRiesgo);
    const dataCarga = leerBloqueOptimizado(ss, 'CCARGA', fechaCorteRiesgo);

    // Los padrones se leen completos
    const dataCauciones = ss.getSheetByName('CAUCIONES').getDataRange().getValues();
    const dataCtaCteEnvases = ss.getSheetByName('CTA_CTE_ENVASES').getDataRange().getValues();
    
    let pL10=0, pL15=0, pL45=0, pV10=0, pV15=0, pV45=0; 
    let cL10=0, cL15=0, cL45=0, cV10=0, cV15=0, cV45=0; 
    let flotaActiva = [];

    const stockStatus = obtenerEstadoStock();
    const camionesEnRuta = getPendingTrips_Carga();
    
    if (stockStatus.estado === 'ABIERTO') {
        if (stockStatus.calculado) {
            pL10 = stockStatus.calculado.L10 || 0; pV10 = stockStatus.calculado.V10 || 0;
            pL15 = stockStatus.calculado.L15 || 0; pV15 = stockStatus.calculado.V15 || 0;
            pL45 = stockStatus.calculado.L45 || 0; pV45 = stockStatus.calculado.V45 || 0;
        }

        camionesEnRuta.forEach(c => {
            let chL10=0, chV10=0, chL15=0, chV15=0, chL45=0, chV45=0;
            if (c.tipoViaje === 'COMPRA') {
                chV10 = c.sDetails.v10 || 0; chV15 = c.sDetails.v15 || 0; chV45 = c.sDetails.v45 || 0;
            } else {
                chL10 = c.sugerencia[10].L || 0; chV10 = c.sugerencia[10].V || 0;
                chL15 = c.sugerencia[15].L || 0; chV15 = c.sugerencia[15].V || 0;
                chL45 = c.sugerencia[45].L || 0; chV45 = c.sugerencia[45].V || 0;
            }
            cL10 += chL10; cV10 += chV10; cL15 += chL15; cV15 += chV15; cL45 += chL45; cV45 += chV45;
            flotaActiva.push({ chofer: c.chofer, tipo: c.tipoViaje, hora: c.horaSalida, llenos: {'10kg': chL10, '15kg': chL15, '45kg': chL45}, vacios: {'10kg': chV10, '15kg': chV15, '45kg': chV45} });
        });
    } else {
        if (stockStatus.sugerido) {
            pL10 = stockStatus.sugerido.L10 || 0; pV10 = stockStatus.sugerido.V10 || 0;
            pL15 = stockStatus.sugerido.L15 || 0; pV15 = stockStatus.sugerido.V15 || 0;
            pL45 = stockStatus.sugerido.L45 || 0; pV45 = stockStatus.sugerido.V45 || 0;
        }
    }

    let tL10 = pL10 + cL10; let tV10 = pV10 + cV10;
    let tL15 = pL15 + cL15; let tV15 = pV15 + cV15;
    let tL45 = pL45 + cL45; let tV45 = pV45 + cV45;

    let com10=0, com15=0, com45=0;
    let con10=0, con15=0, con45=0;
    let clientesRiesgo = {}; 
    let ctaCteDetalle = []; 

    const headersCte = dataCtaCteEnvases[0].map(h => String(h).toUpperCase().trim());
    const idxDeuda = Math.max(headersCte.indexOf('DEUDA_DINERO'), headersCte.indexOf('DINERO'));

    for(let i=1; i<dataCtaCteEnvases.length; i++) {
        let cli = dataCtaCteEnvases[i][1];
        if(!cli) continue;
        
        let c10 = parseInt(dataCtaCteEnvases[i][2]) || 0;
        let c15 = parseInt(dataCtaCteEnvases[i][3]) || 0;
        let c45 = parseInt(dataCtaCteEnvases[i][4]) || 0;
        let estado = String(dataCtaCteEnvases[i][6]).toUpperCase().trim();
        let montoDeuda = idxDeuda > -1 ? parseFloat(String(dataCtaCteEnvases[i][idxDeuda]).replace(/[^\d.-]/g, '')) || 0 : 0;
        let totalEnv = c10 + c15 + c45;
        
        if (totalEnv > 0 && (estado === 'COMODATO' || estado === 'CONSIGNACION')) {
            if(!clientesRiesgo[cli]) clientesRiesgo[cli] = { env: 0, ultMov: 0, d10:0, d15:0, d45:0 };
            clientesRiesgo[cli].env += totalEnv;
            clientesRiesgo[cli].d10 += c10;
            clientesRiesgo[cli].d15 += c15;
            clientesRiesgo[cli].d45 += c45;
            
            if (estado === 'COMODATO') {
                com10 += c10; com15 += c15; com45 += c45;
            } else if (estado === 'CONSIGNACION') {
                con10 += c10; con15 += c15; con45 += c45;
            }
            
            let actStr = dataCtaCteEnvases[i][7];
            let dObj = parseDateTime(actStr, null);
            if (dObj && dObj.getTime() > clientesRiesgo[cli].ultMov) {
                clientesRiesgo[cli].ultMov = dObj.getTime();
            }
        }

        if (estado === 'COMODATO' && totalEnv > 0) {
            ctaCteDetalle.push({ cliente: cli, c10: c10, c15: c15, c45: c45, estado: estado, monto: montoDeuda });
        } else if (estado === 'CONSIGNACION' && (totalEnv > 0 || montoDeuda > 0)) {
            ctaCteDetalle.push({ cliente: cli, c10: c10, c15: c15, c45: c45, estado: estado, monto: montoDeuda });
        }
    }

    ctaCteDetalle.sort((a, b) => {
        if (a.estado !== b.estado) return a.estado.localeCompare(b.estado);
        return a.cliente.localeCompare(b.cliente);
    });

    for(let i=1; i<dataHistCte.length; i++) {
        let cli = dataHistCte[i][2];
        if(!cli || !clientesRiesgo[cli]) continue;
        let dObj = parseDateTime(dataHistCte[i][0], null);
        if(dObj && dObj.getTime() > clientesRiesgo[cli].ultMov) { clientesRiesgo[cli].ultMov = dObj.getTime(); }
    }

    const headersBD1Riesgo = dataBD1Riesgo[0].map(h => String(h).toUpperCase().trim());
    const idxC_BD1 = headersBD1Riesgo.indexOf('C');
    const idxF_BD1 = headersBD1Riesgo.indexOf('FECHA');
    
    if (idxC_BD1 > -1 && idxF_BD1 > -1) {
        for(let i=1; i<dataBD1Riesgo.length; i++) {
            let cli = dataBD1Riesgo[i][idxC_BD1];
            if (clientesRiesgo[cli]) {
                let dObj = parseDateTime(dataBD1Riesgo[i][idxF_BD1], dataBD1Riesgo[i][3]);
                if (dObj && dObj.getTime() > clientesRiesgo[cli].ultMov) { clientesRiesgo[cli].ultMov = dObj.getTime(); }
            }
        }
    }

    const limiteTiempo = Date.now() - 3888000000;
    let secuestrados = [];
    for(let cli in clientesRiesgo) {
        if (clientesRiesgo[cli].env > 0 && clientesRiesgo[cli].ultMov < limiteTiempo) {
            let dias = Math.floor((Date.now() - clientesRiesgo[cli].ultMov) / (1000*60*60*24));
            secuestrados.push({
                cliente: cli, dias: dias, envases: clientesRiesgo[cli].env,
                detalle: `${clientesRiesgo[cli].d10}x10, ${clientesRiesgo[cli].d15}x15, ${clientesRiesgo[cli].d45}x45`
            });
        }
    }
    secuestrados.sort((a,b) => b.dias - a.dias); 

    let caucionesDetalle = [];
    for(let i=1; i<dataCauciones.length; i++){
       if(dataCauciones[i][7] !== 'FINALIZADA') {
          caucionesDetalle.push({
              id: dataCauciones[i][0],
              cliente: dataCauciones[i][2], 
              c10: dataCauciones[i][3], 
              c15: dataCauciones[i][4], 
              c45: dataCauciones[i][5], 
              monto: dataCauciones[i][6],
              estado: dataCauciones[i][7]
          });
       }
    }

    let arqueosP = [];
    let remitosP = [];
    for(let i=1; i<dataCarga.length; i++) {
       let st = dataCarga[i][1];
       let tipo = dataCarga[i][23];
       if(st !== 'FINALIZADO' && st !== 'COMPRA_FINALIZADA') {
           arqueosP.push({ chofer: dataCarga[i][2], viaje: dataCarga[i][0], hora: dataCarga[i][4] ? dataCarga[i][4].toString() : 'S/D' });
       }
       if(tipo === 'COMPRA' && dataCarga[i][30] !== 'SI') {
           remitosP.push({ remito: dataCarga[i][25] || 'Sin Remito', fecha: formatDay(new Date(dataCarga[i][3])), chofer: dataCarga[i][2], monto: 0 });
       }
    }

    let adeudadosReales = [];
    try {
        let transferencias = getTransferencias('PENDIENTES', null, null);
        adeudadosReales = transferencias.map(t => ({ cliente: t.cliente, fecha: t.fechaCorta, monto: t.montoT }));
    } catch(e) { console.error("Error cargando adeudados:", e); }

    payload = {
       estadoTurno: stockStatus.estado,
       stockTotal:  { llenos: {'10kg': tL10, '15kg': tL15, '45kg': tL45}, vacios: {'10kg': tV10, '15kg': tV15, '45kg': tV45} },
       stockPlanta: { llenos: {'10kg': pL10, '15kg': pL15, '45kg': pL45}, vacios: {'10kg': pV10, '15kg': pV15, '45kg': pV45} },
       flotaActiva: flotaActiva,
       stock: { llenos: {'10kg': pL10, '15kg': pL15, '45kg': pL45}, vacios: {'10kg': pV10, '15kg': pV15, '45kg': pV45} },
       diasQuiebre: (tL10+tL15+tL45) > 0 ? 3 : 0, 
       calle: { comodato: { '10kg': com10, '15kg': com15, '45kg': com45 }, consignacion: { '10kg': con10, '15kg': con15, '45kg': con45 } },
       secuestrados: secuestrados,
       adeudados: adeudadosReales,
       caucionesDetalle: caucionesDetalle,
       ctaCteDetalle: ctaCteDetalle,       
       arqueosPendientes: arqueosP,
       remitosPendientes: remitosP
    };
  }

  return payload;
}


// =======================================================
// MÓDULO: CALENDARIO DE PAGOS
// =======================================================


function agregarPagoCalendario(p) {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('FIN_CALENDARIO');
    if (!sheet) throw new Error("Falta la hoja FIN_CALENDARIO");

    const nombre = p.nombre || '';
    const detalle = p.detalle || '';
    const fechaHTML = p.fecha || ''; 
    const importe = parseFloat(p.importe || 0);
    const categoria = p.categoria || '';
    const prioridad = p.prioridad || 'Media';
    
    // Invertimos la fecha de YYYY-MM-DD a DD/MM/YYYY para que Sheets no se maree
    let fechaGuardar = fechaHTML;
    if (fechaHTML.includes('-')) {
       let partes = fechaHTML.split('-');
       fechaGuardar = `${partes[2]}/${partes[1]}/${partes[0]}`;
    }

    sheet.appendRow([nombre, detalle, fechaGuardar, importe, categoria, prioridad, "Pendiente"]);
    return { status: 'success' };
  } catch (e) {
    return { status: 'error', message: e.toString() };
  }
}

function obtenerProximosPagos() {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('FIN_CALENDARIO');
    if (!sheet) throw new Error("Falta la hoja FIN_CALENDARIO");

    const data = sheet.getDataRange().getValues();
    let pendientes = [];

    // Empezamos de la fila 2 (índice 1) para saltar encabezados
    for (let i = 1; i < data.length; i++) {
      let estado = String(data[i][6]).trim(); // Columna G
      if (estado === 'Pendiente') {
        let dStr = String(data[i][2]);
        let ts = 0;
        
        // Transformamos a timestamp para poder ordenar de más viejo a más nuevo
        if (dStr.includes('/')) {
           let partes = dStr.split('/');
           ts = new Date(partes[2], partes[1]-1, partes[0]).getTime();
        } else if (data[i][2] instanceof Date) {
           ts = data[i][2].getTime();
           dStr = Utilities.formatDate(data[i][2], "GMT-3", "dd/MM/yyyy");
        }

        pendientes.push({
          nombre: data[i][0],
          detalle: data[i][1],
          fechaStr: dStr,
          timestamp: ts,
          importe: data[i][3],
          categoria: data[i][4],
          prioridad: data[i][5]
        });
      }
    }

    // Ordenar: Los que queman primero (fecha más antigua/cercana)
    pendientes.sort((a, b) => a.timestamp - b.timestamp);

    // Devolvemos el top 10
    return { status: 'success', payload: pendientes.slice(0, 10) };
  } catch (e) {
    return { status: 'error', message: e.toString() };
  }
}

function getTurnoAbierto() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('CSTOCK');
  
  if (!sh) return 'SIN_TURNO';

  const data = sh.getDataRange().getValues();
  
  // Buscamos el turno abierto normal
  for (let i = data.length - 1; i > 0; i--) {
    const estado = String(data[i][1]).toUpperCase().trim(); 
    if (estado === 'ABIERTO') {
      return String(data[i][0]).trim(); 
    }
  }
  
  // Si llegamos acá es porque está todo cerrado (madrugada, etc).
  // En vez de tirar un ERROR y bloquear el front-end, pasamos el comodín.
  return 'FUERA_DE_HORARIO'; 
}


// =================================================================
// NUEVO MÓDULO: FLOTANTES (RECEPCIÓN Y SALDOS)
// =================================================================


function getDatosPlanta(k) {
  try {
    if (!validarTokenSesion(k)) throw new Error("Sesión inválida o expirada.");
    const datosUser = obtenerDatosPorToken(k); 
    const nombreUsuario = datosUser.usuario || 'Desconocido';

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const shClientes = ss.getSheetByName('CLIENTES');
    if (!shClientes) throw new Error("Falta hoja CLIENTES");
    
    const dataClientes = shClientes.getDataRange().getValues();
    if (dataClientes.length < 2) throw new Error("Hoja CLIENTES vacía");

    let shFlotantes = ss.getSheetByName('FLOTANTES');
    if (!shFlotantes) {
      shFlotantes = ss.insertSheet('FLOTANTES');
      shFlotantes.appendRow(['ID_TRANSACCION', 'FECHA', 'HORA', 'USUARIO', 'ID_CLIENTE', 'CLIENTE_NOMBRE', 'TIPO_MOV', 'ENV_10', 'ENV_15', 'ENV_45', 'SALDO_10', 'SALDO_15', 'SALDO_45', 'CONCILIADO_CSTOCK', 'NOTAS']);
    }
    
    const dataFlotantes = shFlotantes.getDataRange().getValues();
    const clientesMap = {};

    const cHead = _toIdx(dataClientes[0]);
    const idxID = cHead['ID'] !== undefined ? cHead['ID'] : (cHead['ID_CLIENTE'] || 0);
    const idxNom = cHead['NOMBRE'] !== undefined ? cHead['NOMBRE'] : 1;
    
    // --- MAGIA NUEVA: Buscamos las columnas de DNI y Domicilio ---
    const idxDni = cHead['DNI'] !== undefined ? cHead['DNI'] : (cHead['CUIL'] !== undefined ? cHead['CUIL'] : (cHead['CUIT'] !== undefined ? cHead['CUIT'] : -1));
    const idxDom = cHead['DOMICILIO'] !== undefined ? cHead['DOMICILIO'] : (cHead['DIRECCION'] !== undefined ? cHead['DIRECCION'] : -1);

    for (let i = 1; i < dataClientes.length; i++) {
      const r = dataClientes[i];
      const id = String(r[idxID] || '').trim();
      const nombre = String(r[idxNom] || '').trim();
      const dni = idxDni >= 0 ? String(r[idxDni] || '').trim() : '';
      const domicilio = idxDom >= 0 ? String(r[idxDom] || '').trim() : '';
      
      if (id !== '' && nombre !== '') { 
        // Agregamos DNI y Domicilio al paquete que viaja a la web
        clientesMap[id] = { id: id, nombre: nombre, dni: dni, domicilio: domicilio, saldo10: 0, saldo15: 0, saldo45: 0 };
      }
    }

    if (dataFlotantes.length > 1) {
      const fHead = _toIdx(dataFlotantes[0]);
      const fIdC = fHead['ID_CLIENTE'] !== undefined ? fHead['ID_CLIENTE'] : 4;
      const fS10 = fHead['SALDO_10'] !== undefined ? fHead['SALDO_10'] : 10;
      const fS15 = fHead['SALDO_15'] !== undefined ? fHead['SALDO_15'] : 11;
      const fS45 = fHead['SALDO_45'] !== undefined ? fHead['SALDO_45'] : 12;

      for (let i = dataFlotantes.length - 1; i > 0; i--) {
        const row = dataFlotantes[i];
        const idCliente = String(row[fIdC]);
        if (clientesMap[idCliente] && clientesMap[idCliente].saldo10 === 0 && clientesMap[idCliente].saldo15 === 0 && clientesMap[idCliente].saldo45 === 0) {
          clientesMap[idCliente].saldo10 = parseInt(row[fS10]) || 0;
          clientesMap[idCliente].saldo15 = parseInt(row[fS15]) || 0;
          clientesMap[idCliente].saldo45 = parseInt(row[fS45]) || 0;
        }
      }
    }

    return { status: 'success', usuario: nombreUsuario, clientes: Object.values(clientesMap) };

  } catch (e) {
    return { status: 'error', message: e.toString() };
  }
}

function registrarIngresoFlotante(p) {
  try {
    if (!validarTokenSesion(p.k)) throw new Error("Sesión inválida.");
    const datosUser = obtenerDatosPorToken(p.k); 
    const nombreUsuario = datosUser.usuario || 'Desconocido';

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let shFlotantes = ss.getSheetByName('FLOTANTES');
    if(!shFlotantes) throw new Error("No existe la hoja FLOTANTES");

    let saldoAnt10 = 0, saldoAnt15 = 0, saldoAnt45 = 0;
    const dataF = shFlotantes.getDataRange().getValues();
    if(dataF.length > 1) {
       const fHead = _toIdx(dataF[0]);
       const fIdC = fHead['ID_CLIENTE'] !== undefined ? fHead['ID_CLIENTE'] : 4;
       const fS10 = fHead['SALDO_10'] !== undefined ? fHead['SALDO_10'] : 10;
       const fS15 = fHead['SALDO_15'] !== undefined ? fHead['SALDO_15'] : 11;
       const fS45 = fHead['SALDO_45'] !== undefined ? fHead['SALDO_45'] : 12;
       
       for (let i = dataF.length - 1; i > 0; i--) {
          if (String(dataF[i][fIdC]) === String(p.idCliente)) {
            saldoAnt10 = parseInt(dataF[i][fS10]) || 0;
            saldoAnt15 = parseInt(dataF[i][fS15]) || 0;
            saldoAnt45 = parseInt(dataF[i][fS45]) || 0;
            break; 
          }
       }
    }

    const nuevo10 = saldoAnt10 + (parseInt(p.q10) || 0);
    const nuevo15 = saldoAnt15 + (parseInt(p.q15) || 0);
    const nuevo45 = saldoAnt45 + (parseInt(p.q45) || 0);

    const now = new Date();
    const idTx = 'F-' + Utilities.formatDate(now, "GMT-3", "yyyyMMdd-HHmmss");
    const dStr = Utilities.formatDate(now, "GMT-3", "dd/MM/yyyy");
    const hStr = Utilities.formatDate(now, "GMT-3", "HH:mm:ss");

    shFlotantes.appendRow([
      idTx, dStr, hStr, nombreUsuario, p.idCliente, p.nombreCliente, 
      'RECIBE_VACIOS', 
      p.q10 || 0, p.q15 || 0, p.q45 || 0, 
      nuevo10, nuevo15, nuevo45, 
      'FALSE', 
      p.nota || ''
    ]);

    return { status: 'success' };

  } catch (e) {
    return { status: 'error', message: e.toString() };
  }
}

function testPermisos() {
  // Reemplazá 'TU_USUARIO' por tu nombre de usuario real (el que usas para loguearte)
  var resultado = getUserInfo("TU_USUARIO"); 
  console.log(JSON.stringify(resultado));
}

function esHorarioMantenimiento() {
  var ahora = new Date();
  
  // Usamos HH y mm (Formato correcto de Apps Script)
  var h = parseInt(Utilities.formatDate(ahora, "GMT-3", "HH"), 10);
  var m = parseInt(Utilities.formatDate(ahora, "GMT-3", "mm"), 10);
  
  if ((h === 23 && m >= 55) || (h === 0 && m <= 1)) {
    return true;
  }
  return false;
}

function getDatosTreeview(fechaInicio, fechaFin) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('AUDITORIA_TURNOS');
    
    if (!sheet) return { status: 'error', message: 'No existe la hoja AUDITORIA_TURNOS' };

    const data = sheet.getDataRange().getValues();
    const rows = data.slice(1);
    
    const dInicio = new Date(fechaInicio + "T00:00:00");
    const dFin = new Date(fechaFin + "T23:59:59");
    
    let resultados = [];
    
    const normalizeToDDMMYYYY = (val) => {
      if (!val) return "";
      if (val instanceof Date) return Utilities.formatDate(val, Session.getScriptTimeZone(), "dd/MM/yyyy");
      
      let str = String(val).trim();
      let datePart = str.split(" ")[0]; 
      
      if (datePart.includes("-")) {
        let p = datePart.split("-");
        if (p[0].length === 4) return `${p[2].padStart(2, '0')}/${p[1].padStart(2, '0')}/${p[0]}`; 
      }
      if (datePart.includes("/")) {
        let p = datePart.split("/");
        return `${p[0].padStart(2, '0')}/${p[1].padStart(2, '0')}/${p[2].length === 2 ? '20' + p[2] : p[2]}`; 
      }
      return datePart;
    };

    // -------------------------------------------------------------
    // 1. CARGA HISTÓRICA NORMAL
    // -------------------------------------------------------------
    rows.forEach(row => {
      let fechaFila = null;
      if (row[1] instanceof Date) fechaFila = row[1];
      else if (row[1]) {
        let p = String(row[1]).split('/');
        if (p.length === 3) fechaFila = new Date(p[2], p[1] - 1, p[0]);
      }

      if (fechaFila && fechaFila >= dInicio && fechaFila <= dFin) {
        const safeParse = (str, fallback) => { try { return str ? JSON.parse(str) : fallback; } catch(e) { return fallback; } };
        
        // --- INYECCIÓN DRIVE + CACHÉ (Bypass de límite de celdas) ---
        let viajesData = [];
        let viajesRaw = String(row[9]).trim();
        let idTurno = String(row[0]).trim();

        if (viajesRaw.startsWith("DRIVE_ID:")) {
          let fileId = viajesRaw.replace("DRIVE_ID:", "").trim();
          let cache = CacheService.getScriptCache();
          let cachedJson = cache.get("CACHE_VIAJES_" + idTurno);
          
          if (cachedJson) {
            // Lectura relámpago desde la RAM de Google
            viajesData = safeParse(cachedJson, []);
          } else {
            // Ir a buscar el archivo a Drive (con el ID alcanza para encontrarlo en cualquier carpeta)
            try {
              let fileText = DriveApp.getFileById(fileId).getBlob().getDataAsString();
              viajesData = safeParse(fileText, []);
              // Intentar guardar en RAM por 6 horas para la próxima consulta
              try { cache.put("CACHE_VIAJES_" + idTurno, fileText, 21600); } catch(e){} 
            } catch (e) {
              // Si falla (ej. borraron el archivo de la carpeta), evitamos que crashee la pantalla
              viajesData = [];
            }
          }
        } else {
          // Compatibilidad: leer los turnos viejos que siguen teniendo el JSON crudo en la celda
          viajesData = safeParse(viajesRaw, []);
        }
        // -----------------------------------------------------------

        resultados.push({
          idTurno: idTurno, fecha: Utilities.formatDate(fechaFila, Session.getScriptTimeZone(), 'dd/MM/yyyy'),
          estado: row[2], apertura: row[3], cierre: row[4],
          stockInicial: safeParse(row[5], {}), stockFinal: safeParse(row[6], {}),
          resumenCaja: safeParse(row[7], {}), alarmas: safeParse(row[8], []), viajes: viajesData 
        });
      }
    });

    // -------------------------------------------------------------
    // 2. ESCÁNER DINÁMICO DE TURNOS EN VIVO / ABIERTOS
    // -------------------------------------------------------------
    const hBd1 = ss.getSheetByName('BD1');
    const hCarga = ss.getSheetByName('CCARGA');
    const hStock = ss.getSheetByName('CSTOCK');
    const hCtaCte = ss.getSheetByName('HISTORIAL_CTA_CTE');
    const hCaucion = ss.getSheetByName('CAUCIONES');

    if (hBd1 && hCarga && hStock) {
      
      // --- DETECTOR INTELIGENTE DE DOBLE ENCABEZADO ---
      const getSheetDataInfo = (matrix) => {
        let headerIndex = 0;
        // Si la segunda fila contiene las palabras clave, significa que la primera es de diseño uniforme
        if (matrix[1] && (matrix[1].map(c => String(c).toUpperCase()).includes("ID_TURNO") || 
                          matrix[1].map(c => String(c).toUpperCase()).includes("USUARIO") || 
                          matrix[1].map(c => String(c).toUpperCase()).includes("FECHA"))) {
          headerIndex = 1;
        }
        const map = matrix[headerIndex].reduce((acc, col, i) => { 
          acc[String(col).trim().toUpperCase()] = i; 
          return acc; 
        }, {});
        return { map: map, dataStart: headerIndex + 1 };
      };
      
      const dBd1 = hBd1.getDataRange().getValues();
      const dCarga = hCarga.getDataRange().getValues();
      const dStock = hStock.getDataRange().getValues();
      const dCta = hCtaCte ? hCtaCte.getDataRange().getValues() : [];
      const dCau = hCaucion ? hCaucion.getDataRange().getValues() : [];

      const infoB = getSheetDataInfo(dBd1);     const mB = infoB.map;         const startB = infoB.dataStart;
      const infoCarga = getSheetDataInfo(dCarga); const mCarga = infoCarga.map; const startCarga = infoCarga.dataStart;
      const infoStock = getSheetDataInfo(dStock); const mStock = infoStock.map; const startStock = infoStock.dataStart;
      const mC = dCta.length > 0 ? getSheetDataInfo(dCta).map : {};
      const mCa = dCau.length > 0 ? getSheetDataInfo(dCau).map : {};

      const fTime = (val) => val instanceof Date ? Utilities.formatDate(val, Session.getScriptTimeZone(), "HH:mm") : String(val).substring(0,5);

      let currentLoopDate = new Date(dInicio.getTime());
      while (currentLoopDate <= dFin) {
        let loopDateStr = Utilities.formatDate(currentLoopDate, Session.getScriptTimeZone(), "dd/MM/yyyy");
        let yaAuditado = resultados.some(r => r.fecha === loopDateStr);
        
        if (!yaAuditado) {
          let stockRow = null;
          // Buscamos la fila ignorando las celdas de los títulos superiores
          for (let i = startStock; i < dStock.length; i++) {
            if (normalizeToDDMMYYYY(dStock[i][mStock['FECHA']]) === loopDateStr) {
              stockRow = dStock[i];
              break;
            }
          }

          let tieneActividad = stockRow !== null ||
            dBd1.slice(startB).some(f => normalizeToDDMMYYYY(f[mB['FECHA']]) === loopDateStr) ||
            dCarga.slice(startCarga).some(f => normalizeToDDMMYYYY(f[mCarga['FECHA_SAL']]) === loopDateStr);

          if (tieneActividad) {
            let idTurnoVivo = stockRow ? stockRow[mStock['ID_TURNO']] : ("TURNO-" + loopDateStr.replace(/\//g, ''));
            let estadoVivo = stockRow ? stockRow[mStock['ESTADO']] : "ABIERTO";
            
            let hoyStrActual = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy");
            let labelTurno = (loopDateStr === hoyStrActual) ? "🔴 EN VIVO" : `⚠️ NO CERRADO (${idTurnoVivo})`;

            let opsPorViaje = {};
            let ventasDia = { e10: 0, e15: 0, e45: 0 };
            let caja = { TOTAL: 0, EFECTIVO: 0, TRANSF: 0 };

            const inicializarViaje = (idV) => {
                if (!opsPorViaje[idV]) {
                    opsPorViaje[idV] = {
                        idViaje: idV, tipo: idV === "PLANTA" ? "BASE" : "REPARTO", chofer: idV === "PLANTA" ? "SISTEMA" : "-", remito: "", salida: "-", llegada: idV === "PLANTA" ? "-" : "EN RUTA",
                        envases: idV === "PLANTA" ? null : { salida: {L10:0,V10:0,L15:0,V15:0,L45:0,V45:0}, llegada: {L10:0,V10:0,L15:0,V15:0,L45:0,V45:0} },
                        ventas: { L10:0, L15:0, L45:0 }, totales: { ops: 0, total: 0, efectivo: 0, transf: 0 }, operaciones: []
                    };
                }
            };

            // A. BD1 Ventas
            dBd1.slice(startB).forEach(fila => {
                if (normalizeToDDMMYYYY(fila[mB['FECHA']]) === loopDateStr) {
                    let idV = fila[mB['ID_VIAJE']] || "PLANTA";
                    inicializarViaje(idV);
                    
                    let e10 = (Number(fila[22])||0) + (Number(fila[28])||0) + (Number(fila[34])||0) + (Number(fila[40])||0);
                    let e15 = (Number(fila[24])||0) + (Number(fila[30])||0) + (Number(fila[36])||0) + (Number(fila[42])||0);
                    let e45 = (Number(fila[26])||0) + (Number(fila[32])||0) + (Number(fila[38])||0) + (Number(fila[44])||0);
                    let efec = Number(fila[mB['E$']])||0, trans = Number(fila[mB['T$']])||0, total = Number(fila[mB['TOTAL']])||0;

                    ventasDia.e10 += e10; ventasDia.e15 += e15; ventasDia.e45 += e45;
                    caja.TOTAL += total; caja.EFECTIVO += efec; caja.TRANSF += trans;

                    opsPorViaje[idV].ventas.L10 += e10; opsPorViaje[idV].ventas.L15 += e15; opsPorViaje[idV].ventas.L45 += e45;
                    opsPorViaje[idV].chofer = fila[mB['USUARIO']] || opsPorViaje[idV].chofer;
                    opsPorViaje[idV].operaciones.push({
                        hora: fTime(fila[mB['HORA']]), cliente: fila[mB['C']] || '-', tipo: fila[mB['TIPO']] || '-', gps: fila[mB['UBICACION']] || "",
                        env10: e10, env15: e15, env45: e45, efectivo: efec, transf: trans
                    });
                    opsPorViaje[idV].totales.ops += 1; opsPorViaje[idV].totales.total += total;
                    opsPorViaje[idV].totales.efectivo += efec; opsPorViaje[idV].totales.transf += trans;
                }
            });

            // B. HISTORIAL_CTA_CTE (Comodatos)
            if (dCta.length > 0) {
                dCta.slice(1).forEach(fila => {
                    if (normalizeToDDMMYYYY(fila[mC['FECHA_HORA']]) === loopDateStr) {
                        let idV = fila[mC['VIAJE_REF']] || "PLANTA";
                        inicializarViaje(idV);
                        let tipoMov = fila[mC['TIPO']] || "CTA_CTE";
                        let env10 = Number(fila[mC['ENV_10']])||0; let env15 = Number(fila[mC['ENV_15']])||0; let env45 = Number(fila[mC['ENV_45']])||0;
                        let dinero = Number(fila[mC['DINERO']])||0;

                        opsPorViaje[idV].operaciones.push({
                            hora: fTime(fila[mC['FECHA_HORA']]), cliente: fila[mC['CLIENTE']] || '-', tipo: tipoMov, gps: "-",
                            env10: env10, env15: env15, env45: env45, efectivo: 0, transf: 0, deuda: dinero
                        });
                        opsPorViaje[idV].totales.ops += 1;
                    }
                });
            }

            // C. CAUCIONES
            if (dCau.length > 0) {
                dCau.slice(1).forEach(fila => {
                    if (normalizeToDDMMYYYY(fila[mCa['FECHA_ALTA']]) === loopDateStr) {
                        let idV = "PLANTA";
                        inicializarViaje(idV);
                        let env10 = Number(fila[mCa['ENV_10']])||0; let env15 = Number(fila[mCa['ENV_15']])||0; let env45 = Number(fila[mCa['ENV_45']])||0;
                        let dinero = Number(fila[mCa['MONTO_GARANTIA']])||0;

                        opsPorViaje[idV].operaciones.push({
                            hora: "-", cliente: fila[mCa['CLIENTE']] || '-', tipo: "CAUCION", gps: "-",
                            env10: env10, env15: env15, env45: env45, efectivo: dinero, transf: 0
                        });
                        opsPorViaje[idV].totales.ops += 1; opsPorViaje[idV].totales.efectivo += dinero; opsPorViaje[idV].totales.total += dinero;
                        caja.TOTAL += dinero; caja.EFECTIVO += dinero;
                    }
                });
            }

            // D. CCARGA
            dCarga.slice(startCarga).forEach(fila => {
                if (normalizeToDDMMYYYY(fila[mCarga['FECHA_SAL']]) === loopDateStr) {
                    let idV = String(fila[mCarga['ID_VIAJE']]).trim();
                    if (opsPorViaje[idV]) {
                        opsPorViaje[idV].salida = fTime(fila[mCarga['HORA_SAL']]);
                        opsPorViaje[idV].envases.salida = { L10: fila[mCarga['S_L10']]||0, V10: fila[mCarga['S_V10']]||0, L15: fila[mCarga['S_L15']]||0, V15: fila[mCarga['S_V15']]||0, L45: fila[mCarga['S_L45']]||0, V45: fila[mCarga['S_V45']]||0 };
                        opsPorViaje[idV].tipo = fila[mCarga['TIPO_VIAJE']] || "REPARTO";
                        opsPorViaje[idV].remito = fila[mCarga['REMITO']] || "";

                        if (String(fila[mCarga['ESTADO']]).toUpperCase() === "EN_RUTA" || String(fila[mCarga['ESTADO']]).toUpperCase() === "ABIERTO") {
                            let v = opsPorViaje[idV].ventas;
                            opsPorViaje[idV].envases.llegada = {
                                L10: Math.max(0, (fila[mCarga['S_L10']]||0) - v.L10), V10: (fila[mCarga['S_V10']]||0) + v.L10,
                                L15: Math.max(0, (fila[mCarga['S_L15']]||0) - v.L15), V15: (fila[mCarga['S_V15']]||0) + v.L15,
                                L45: Math.max(0, (fila[mCarga['S_L45']]||0) - v.L45), V45: (fila[mCarga['S_V45']]||0) + v.L45
                            };
                        } else {
                            opsPorViaje[idV].llegada = fTime(fila[mCarga['HORA_LLEG']]);
                            opsPorViaje[idV].envases.llegada = { L10: fila[mCarga['L_L10']]||0, V10: fila[mCarga['L_V10']]||0, L15: fila[mCarga['L_L15']]||0, V15: fila[mCarga['L_V15']]||0, L45: fila[mCarga['L_L45']]||0, V45: fila[mCarga['L_V45']]||0 };
                        }
                    }
                }
            });

            // E. CSTOCK
            let stockIn = { L10: 0, V10: 0, L15: 0, V15: 0, L45: 0, V45: 0 };
            if (stockRow) {
                stockIn = { 
                  L10: stockRow[mStock['L10']]||0, V10: stockRow[mStock['V10']]||0, 
                  L15: stockRow[mStock['L15']]||0, V15: stockRow[mStock['V15']]||0, 
                  L45: stockRow[mStock['L45']]||0, V45: stockRow[mStock['V45']]||0 
                };
            }

            let stockFi = {
                L10: Math.max(0, stockIn.L10 - ventasDia.e10), V10: stockIn.V10 + ventasDia.e10,
                L15: Math.max(0, stockIn.L15 - ventasDia.e15), V15: stockIn.V15 + ventasDia.e15,
                L45: Math.max(0, stockIn.L45 - ventasDia.e45), V45: stockIn.V45 + ventasDia.e45
            };

            resultados.push({
                idTurno: labelTurno, fecha: loopDateStr, estado: estadoVivo === "ABIERTO" ? "SISTEMA_VIVO" : estadoVivo, 
                apertura: stockRow ? `${fTime(stockRow[mStock['HORA_INI']])}|${stockRow[mStock['USUARIO']]}` : "06:00|sys", 
                cierre: stockRow && stockRow[mStock['HORA_FIN']] ? `${fTime(stockRow[mStock['HORA_FIN']])}|bot` : "--:--|--",
                stockInicial: stockIn, stockFinal: stockFi, resumenCaja: caja, alarmas: [], 
                viajes: Object.values(opsPorViaje).sort((a,b) => a.idViaje === "PLANTA" ? -1 : 1)
            });
          }
        }
        currentLoopDate.setDate(currentLoopDate.getDate() + 1);
      }
    }

    return { status: 'success', data: resultados.reverse() };
    
  } catch (error) {
    return { status: 'error', message: "Error interno: " + error.toString() };
  }
}


function guardarAudioEnDrive(base64Data, nombreArchivo) {
  try {
    const folderId = "1F4h7wdqoEaeN9wJ45Q8wwP_zW_hWXM0k"; 
    const folder = DriveApp.getFolderById(folderId);

    // BLINDAJE: Reemplazamos los espacios vacíos por '+' para reconstruir el audio
    const cleanBase64 = (base64Data.split(',')[1] || base64Data).replace(/ /g, '+');
    const decodedData = Utilities.base64Decode(cleanBase64);
    
    const blob = Utilities.newBlob(decodedData, 'audio/webm', nombreArchivo + '.webm');
    const archivo = folder.createFile(blob);

    archivo.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

    Logger.log("✅ Audio guardado: " + archivo.getUrl());
    return { status: 'success', url: archivo.getUrl() };
    
  } catch (error) {
    Logger.log("❌ Error en guardarAudioEnDrive: " + error.toString());
    return { status: 'error', message: "Falla en Drive: " + error.toString() };
  }
}

function obtenerFlota() {
  try {
    const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('FLOTA');
    if (!sh) return { status: 'error', message: 'Falta la hoja FLOTA' };

    const data = sh.getDataRange().getValues();
    let flota = [];
    
    // Leemos desde la fila 2 para saltar los encabezados
    for (let i = 1; i < data.length; i++) {
      if (data[i][0]) { // Si hay patente
        flota.push({
          patente: data[i][0],
          vehiculo: data[i][1],
          kmActual: data[i][3]
        });
      }
    }
    return { status: 'success', flota: flota };
  } catch (e) {
    return { status: 'error', message: e.toString() };
  }
}

function obtenerKmActualFlota(patente) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('FLOTA');
  const data = sh.getDataRange().getValues();
  for(let i = 1; i < data.length; i++) {
    if(data[i][0] === patente) return parseInt(data[i][3]) || 0;
  }
  return 0;
}

function actualizarKmFlota(patente, nuevoKmLlegada) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('FLOTA');
  const data = sh.getDataRange().getValues();
  for(let i = 1; i < data.length; i++) {
    if(data[i][0] === patente) {
      sh.getRange(i + 1, 4).setValue(nuevoKmLlegada); // Actualiza Columna D
      break;
    }
  }
}

function obtenerFlotaDetalle() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('FLOTA');
  if (!sh) return [];

  const data = sh.getDataRange().getValues();
  let resultado = [];

  // Empezamos en 1 para saltar los encabezados
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (!row[0]) continue; // Si la patente está vacía, ignora la fila

    // BLINDAJE DE FECHAS: Maneja fechas reales, textos con barras, o vacíos.
    let fService = '';
    if (row[6]) { // Columna G (Índice 6)
      if (row[6] instanceof Date) {
        fService = Utilities.formatDate(row[6], Session.getScriptTimeZone(), 'yyyy-MM-dd');
      } else {
        // Si lo escribieron a mano ej: "04/01/2026"
        let sDate = String(row[6]).trim();
        if (sDate.includes('/')) {
            let p = sDate.split('/');
            if (p.length === 3) fService = `${p[2]}-${p[1].padStart(2, '0')}-${p[0].padStart(2, '0')}`;
            else fService = sDate;
        } else {
            fService = sDate;
        }
      }
    }

    resultado.push({
      patente: String(row[0]).trim().toUpperCase(),     // Col A
      vehiculo: String(row[1]).trim(),                  // Col B
      kmUltimo: Number(row[2]) || 0,                    // Col C
      kmActual: Number(row[3]) || 0,                    // Col D
      frecuencia: Number(row[4]) || 10000,              // Col E
      fechaUltimo: fService                             // Col G
    });
  }
  return resultado;
}

function registrarService(p, auditor) {
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000); // Patovica exclusivo para no pisar datos
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let shFlota = ss.getSheetByName('FLOTA');
    if (!shFlota) throw new Error("No se encontró la pestaña FLOTA");

    // PENSAMIENTO LATERAL: Si la hoja del historial no existe, la creamos al vuelo
    let shLog = ss.getSheetByName('LOG_SERVICES');
    if (!shLog) {
      shLog = ss.insertSheet('LOG_SERVICES');
      shLog.appendRow(['FECHA_SISTEMA', 'USUARIO', 'PATENTE', 'FECHA_SERVICE', 'KM_SERVICE', 'FRECUENCIA']);
      shLog.getRange("A1:F1").setFontWeight("bold").setBackground("#d9d9d9");
    }

    const patente = String(p.patente || '').trim().toUpperCase();
    const kmService = parseInt(p.km) || 0;
    const frec = parseInt(p.frecuencia) || 10000;
    const fechaReal = p.fecha || ''; // BLINDAJE: Si viene vacío, no crashea

    // 1. Dejar registro en la caja negra (LOG_SERVICES)
    const ahora = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss');
    shLog.appendRow([ahora, auditor, patente, fechaReal, kmService, frec]);

    // 2. Traducir la fecha de YYYY-MM-DD a DD/MM/YYYY para la hoja FLOTA (Con blindaje)
    let fechaSheet = fechaReal;
    if (fechaReal.includes('-')) {
        let fParts = fechaReal.split('-');
        if (fParts.length === 3) {
            fechaSheet = `${fParts[2]}/${fParts[1]}/${fParts[0]}`;
        }
    }

    // 3. Buscar el camión en la pestaña FLOTA y pisar los datos
    const dataFlota = shFlota.getDataRange().getValues();
    let rowIndex = -1;
    for (let i = 1; i < dataFlota.length; i++) {
      if (String(dataFlota[i][0]).trim().toUpperCase() === patente) {
        rowIndex = i + 1; // +1 porque el índice del array arranca en 0 y las filas de Sheets en 1
        break;
      }
    }

    if (rowIndex === -1) throw new Error("Camión no encontrado en el tablero");

    // Escribimos en C (Último KM), E (Frecuencia) y G (Fecha Último)
    shFlota.getRange(rowIndex, 3).setValue(kmService);
    shFlota.getRange(rowIndex, 5).setValue(frec);
    shFlota.getRange(rowIndex, 7).setValue(fechaSheet);

    // Control extra: Si por esas casualidades de la vida, el KM del service es 
    // mayor al KM Actual que dice la hoja, actualizamos también el KM Actual (D)
    const kmTablero = Number(dataFlota[rowIndex - 1][3]) || 0;
    if (kmService > kmTablero) {
      shFlota.getRange(rowIndex, 4).setValue(kmService);
    }

    return { status: 'success' };

  } catch (error) {
    return { status: 'error', message: error.message };
  } finally {
    lock.releaseLock();
  }
}

function getLogServices(k) {
  try {
    // CORRECCIÓN: Usamos tu función real de seguridad
    var sesion = obtenerDatosPorToken(k);
    if (!sesion.valido) return { status: 'error', message: 'Sesión inválida' };

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName("LOG_SERVICES");
    if (!sheet) return { status: 'error', message: 'No existe la pestaña LOG_SERVICES' };

    var lastRow = sheet.getLastRow();
    var lastCol = sheet.getLastColumn();
    if (lastRow < 2) return { status: 'success', data: [] };

    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
    
    // Leemos solo los últimos 50 registros para no matar la memoria
    var numFilasALeer = Math.min(50, lastRow - 1); 
    var filaInicio = lastRow - numFilasALeer + 1;
    
    var data = sheet.getRange(filaInicio, 1, numFilasALeer, lastCol).getValues();
    var logs = [];
    
    // Invertimos el bucle (lo más nuevo arriba)
    for (var i = data.length - 1; i >= 0; i--) {
      var row = data[i];
      var obj = {};
      for (var j = 0; j < headers.length; j++) {
        var val = row[j];
        // Si es fecha, la formateamos acá para que no llegue rota al frontend
        if (val instanceof Date) {
          var d = val.getDate();
          var m = val.getMonth() + 1;
          var y = val.getFullYear();
          val = (d < 10 ? '0'+d : d) + '/' + (m < 10 ? '0'+m : m) + '/' + y;
        }
        obj[headers[j]] = val;
      }
      logs.push(obj);
    }
    return { status: 'success', data: logs };
  } catch(e) {
    return { status: 'error', message: e.toString() };
  }
}

function actualizarCacheCostos() {
  const libro = SpreadsheetApp.getActiveSpreadsheet();
  const hojaDatos = libro.getSheetByName('DATOS');
  let costos = { cu10: 0, cu15: 0, cu45: 0 };

  if (hojaDatos) {
    const dVals = hojaDatos.getDataRange().getValues();
    const headD = dVals[0].map(h => String(h).toUpperCase().trim());
    const idxTipo = headD.indexOf('TIPO_COSTO');
    const idxValor = headD.indexOf('VALOR_COSTO');

    if (idxTipo !== -1 && idxValor !== -1) {
      for (let i = 1; i < dVals.length; i++) {
        const t = String(dVals[i][idxTipo]).trim();
        const v = Number(dVals[i][idxValor]) || 0;
        if (t === '10') costos.cu10 = v;
        if (t === '15') costos.cu15 = v;
        if (t === '45') costos.cu45 = v;
      }
    }
  }
  
  // Guardamos en la memoria RAM del servidor por 6 horas (21600 segundos)
  CacheService.getScriptCache().put('COSTOS_ACTUALES', JSON.stringify(costos), 21600);
  return costos;
}

function getDatosMiCaja(usuarioTarget) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const bd1 = ss.getSheetByName('BD1');
    if (!bd1) return { status: 'error', message: 'No se encuentra BD1' };

    // 1 SOLO VIAJE A LA BASE DE DATOS: Cargamos todo en la RAM.
    const data = bd1.getDataRange().getValues();
    
    let efectivoTotal = 0;
    let transHoy = [];
    let transAtrasadas = [];
    
    const userTargetUpper = String(usuarioTarget).trim().toUpperCase();

    // RECORRIDO INVERSO: Empezamos en la última fila y subimos hasta los encabezados.
    // Procesamiento en memoria V8 (Tiempo estimado para 10k filas: < 5ms).
    for (let i = data.length - 1; i > 0; i--) {
      const fila = data[i];
      const filaUsuario = String(fila[0]).trim().toUpperCase();

      // Filtro estricto: Si no es el chofer, saltamos al instante a la siguiente iteración.
      if (filaUsuario !== userTargetUpper) continue;

      const efectivo = Number(fila[6]) || 0; // E$ (Columna G)
      const transf = Number(fila[7]) || 0;   // T$ (Columna H)
      
      // Si no hay plata de por medio, ni nos gastamos en leer el resto de la fila
      if (efectivo === 0 && transf === 0) continue;

      const arqueoId = String(fila[48] || '').trim(); // ARQUEO_ID (Columna AW)
      const verificado = String(fila[49] || '').trim(); // VERIFICADO_BANCO (Columna AX)

      // 1. EFECTIVO (A rendir, no arqueado)
      if (arqueoId === "" && efectivo !== 0) {
        efectivoTotal += efectivo;
      }

      // 2. TRANSFERENCIAS
      if (transf > 0 && verificado === "") {
        const fecha = fila[2];
        const fechaStr = (fecha instanceof Date) ? Utilities.formatDate(fecha, Session.getScriptTimeZone(), "dd/MM/yyyy") : String(fecha).trim();
        const cliente = String(fila[4]).trim() || 'Desconocido'; 
        const tipoVenta = String(fila[1]).trim() || '-'; 

        let objTrans = {
          cliente: cliente,
          monto: transf,
          fecha: fechaStr,
          tipo: tipoVenta
        };
        
        if (arqueoId === "") {
          // No está arqueada -> Es de la caja actual
          transHoy.push(objTrans);
        } else {
          // YA está arqueada pero NO verificada -> Se colgó el cliente (URGENTE)
          transAtrasadas.push(objTrans);
        }
      }
    }

    return { 
      status: 'success', 
      data: {
        efectivo: efectivoTotal,
        hoy: transHoy,
        atrasadas: transAtrasadas
      }
    };
  } catch(e) {
    return { status: 'error', message: e.toString() };
  }
}


// ==========================================
// MOTOR DE VERSIONES (OFFLINE FIRST)
// ==========================================


function marcarActualizacion(tipo) {
  const ts = new Date().getTime().toString();
  const validTypes = ['TS_PRECIOS', 'TS_CLIENTES', 'TS_SALDOS'];
  if (validTypes.includes(tipo)) {
    PropertiesService.getScriptProperties().setProperty(tipo, ts);
  }
  return ts;
}

// Actualiza el reloj cuando hay cambios
function marcarActualizacion(clave) {
  PropertiesService.getScriptProperties().setProperty(clave, new Date().getTime().toString());
}

function getTimestamps() {
  try {
    const props = PropertiesService.getScriptProperties();
    return {
      TS_CLIENTES: props.getProperty('TS_CLIENTES') || '0',
      TS_FINANZAS: props.getProperty('TS_FINANZAS') || '0',
      TS_FLOTANTES: props.getProperty('TS_FLOTANTES') || '0',
      TS_SALDOS: props.getProperty('TS_SALDOS') || '0', // Agregamos la que dispara el nuevo motor
      TS_USUARIOS: props.getProperty('TS_USUARIOS') || '0'
    };
  } catch (e) {
    // Si Google falla, devolvemos ceros para que no crashee por CORS
    return { TS_CLIENTES: '0', TS_FINANZAS: '0', TS_FLOTANTES: '0', TS_SALDOS: '0', TS_USUARIOS: '0' };
  }
}

function inicializarVersionesSiEstanVacias() {
  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('TS_PRECIOS')) props.setProperty('TS_PRECIOS', new Date().getTime().toString());
  if (!props.getProperty('TS_CLIENTES')) props.setProperty('TS_CLIENTES', new Date().getTime().toString());
  if (!props.getProperty('TS_SALDOS')) props.setProperty('TS_SALDOS', new Date().getTime().toString());
}

// Gatillo que vigila si tocás la planilla a mano
function onEdit(e) {
  if (!e || !e.range) return;
  const nombreHoja = e.range.getSheet().getName();
  
  if (nombreHoja === 'PRECIOS' || nombreHoja === 'RANGOS_COMISION') {
    marcarActualizacion('TS_PRECIOS');
  } else if (nombreHoja === 'CLIENTES') {
    marcarActualizacion('TS_CLIENTES');
  }
}